@article{Corrales2019,
  title = {Proteomic Analyses},
  author = {Corrales, Fernando J. and Odriozola, Leticia},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {69--74},
  doi = {10.1016/B978-0-12-804572-5.00009-4},
  abstract = {Sequencing of the human genome has provided a privileged vision into our own biology. However, much remains to be explored to fully define a complete map of cell functions, their regulatory mechanisms, and alterations participating in disease. Because proteins are primary actors of cellular pathways, the study of the proteome based on a systems biology strategy has opened new perspectives in biomedical research. Proteome complexity, the wide dynamic range of its components, as well as their inherent physicochemical nature preclude coverage of the entire protein set of a living organism in a single experiment. However, proteomics technology has experienced astonishing progress, allowing unprecedented accuracy in measurement and proteome coverage. Protein/peptide fractionation combined with mass spectrometry in optimized discovery and validation workflows address many challenging issues of proteomics, providing a deeper look into the proteomic landscape. Proteomics thus emerges as an exciting tool in biomedical research. In this chapter, state-of-the-art methods in proteomics are reviewed and their application in the analysis of complex cell and tissue proteomes is discussed.},
  isbn = {9780128045725},
  keywords = {Affinity capture proteomics,Mass spectrometry,Protein chromatography,Protein electrophoresis,Proteome,Proteomics,Shotgun proteomics,Top-down proteomics}
}

