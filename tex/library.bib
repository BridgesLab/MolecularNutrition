@article{Bulik2017,
  title = {The {{PGC Gwas Meta-Analysis}} of {{Anorexia Nervosa}}: {{SNP Heritability}}, {{Genetic Correlations}}, {{And Snp Results}}},
  author = {Bulik, Cynthia and Duncan, Laramie and Breen, Gerome and {PGC\_AN Working Group}},
  year = {2017},
  journal = {European Neuropsychopharmacology},
  volume = {27},
  pages = {S360-S361},
  issn = {0924977X},
  doi = {10.1016/j.euroneuro.2016.09.381},
  abstract = {Abstract The Psychiatric Genomics Consortium Anorexia Nervosa Working Group (PGC-AN) reports its first genome-wide significant association for AN, a serious illness that is characterized by severely dysregulated weight and carries the highest mortality of any psychiatric disorder. The PGC-AN Freeze 1 comprised 3,495 cases and the largest effective sample size (10,169) reported to date, rendering it the best-powered analysis available. We present the \{GWAS\} analyses results, heritability explained by common SNPs, and explore the genetic correlations with other disorders. Consistent with procedures established by the PGC, individual-level genotype and phenotype (binary case-control status) data were analyzed. Cases met DSM-IV criteria for lifetime \{AN\} (restricting or binge--purge subtype) or lifetime eating disorders `not otherwise specified' AN-subtype (i.e., exhibiting the core features of AN). Amenorrhea was not required. All procedures were approved by the relevant \{IRBs\} and all subjects provided informed consent. We performed uniform quality control (QC) followed by relatedness testing, imputation with reference to 1000 Genomes Phase 3, case-control analysis within datasets, and finally meta-analysis. Standard \{PGC\} pipeline procedures were applied at all stages of analysis. One locus on chromosome 12 achieved genome-wide significance (rs4622308, p=4.3e-09, OR=0.835, SE=0.031, INFO=0.904). This \{SNP\} is near \{ERBB3\} and is in a region previously implicated by \{GWAS\} for type 1 diabetes, height, and polycystic ovary syndrome. The estimate for SNP-h2 was 0.19, se=0.03, which is comparable to estimates for other major psychiatric disorders. The pattern of genetic correlations (rg) revealed significantly: positive rg with schizophrenia, bipolar disorder, major depressive disorder, and neuroticism; significantly positive rg with measures of cognitive performance and educational attainment; significantly negative rg with BMI, obesity, hip circumference, fasting glucose, fasting insulin, and coronary artery disease; and significantly positive rg with various \{HDL\} measures. \{LDSC\} results encourage further exploration of metabolic aspects of AN. \{GWAS\} of \{AN\} may have reached its inflection point with our first significant association. We will report up to the minute progress on the \{GWAS\} and pathway and network analyses. 2017 will witness a substantial infusion of new cases (+16,000) from the Anorexia Nervosa Genetics Initiative (ANGI), Charlotte's Helix, and incoming samples from around the world currently queued for genotyping.}
}

