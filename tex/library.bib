@article{Applegate1982,
  title = {Food Intake, Body Composition and Blood Lipids Following Treadmill Exercise in Male and Female Rats},
  author = {Applegate, Elizabeth A. and Upton, David E. and Stern, Judith S.},
  year = {1982},
  journal = {Physiology and Behavior},
  volume = {28},
  number = {5},
  pages = {917--920},
  issn = {00319384},
  doi = {10.1016/0031-9384(82)90214-1},
  abstract = {Body weight gain, food intake, body composition and blood lipids of male and female Osborne Mendel rats were compared on the same exercise treadmill program. To mimic their nocturnal habits, rats were exercised daily at the beginning of the 12 hour dark cycle and food intake was measured for both light and dark cycles. After a 10 day treadmill adaptation period, the duration of exercise was successively increased over a 12 day period until 60 min/day at 21.3 meters/min was reached. Relative to their respective controls, exercised male rats showed a reduction in body weight and light cycle food intake while female runners showed no change in body weight or food intake. Exercise resulted in a decrease in percent body fat in both males and females while only male runners increased percent protein. Both males and females reduced serum triglycerides while serum cholesterol was reduced only in the males. The short term exercise program produced highly significant changes in the males while the females were more resistant to the same exercise regimen. {\copyright} 1982.},
  isbn = {0809170450},
  keywords = {Exercise,Food intake,Lipids,Rats,Sex differences}
}

@article{Appleton2013c,
  title = {Diabetes and Cardiovascular Disease Outcomes in the Metabolically Healthy Obese Phenotype: {{A}} Cohort Study},
  author = {Appleton, Sarah L. and Seaborn, Christopher J. and Visvanathan, Renuka and Hill, Catherine L. and Gill, Tiffany K. and Taylor, Anne W. and Adams, Robert J.},
  year = {2013},
  month = aug,
  journal = {Diabetes Care},
  volume = {36},
  number = {8},
  pages = {2388--2394},
  issn = {01495992},
  doi = {10.2337/dc12-1971},
  urldate = {2014-08-25},
  abstract = {OBJECTIVE: To determine the correlates of the "metabolically healthy obese" (MHO) phenotype and the longitudinal risks of diabetes and cardiovascular disease (CVD)/stroke associated with this phenotype.{\textbackslash}n{\textbackslash}nRESEARCH DESIGN AND METHODS: The North West Adelaide Health Study is a prospective cohort study of 4,056 randomly selected adults aged {$\geq$} 18 years. Participants free of CVD/stroke and not underweight (n = 3,743) were stratified by BMI categories and metabolic risk, defined as having two or more International Diabetes Federation metabolic syndrome criteria, excluding waist circumference.{\textbackslash}n{\textbackslash}nRESULTS: Correlates of the MHO (n = 454 [12.1\%]) included smoking, socioeconomic disadvantage, and physical inactivity. Compared with metabolically healthy normal-weight subjects (n = 1,172 [31.3\%]), the MHO were more likely to develop metabolic risk (15.5 vs. 33.1\%, P {$<$} 0.001) and incident diabetes (odds ratio 2.09 [95\% CI 0.87-5.03]) but not CVD/stroke (1.16 [0.58-2.29]) during 5.5-10.3 years of follow-up. These risks were not seen in MHO subjects maintaining metabolic health (n = 188 [67\%]). Sustained metabolic health in obese participants was associated with age {$\leq$} 40 years and lower waist circumference. Compared with the metabolically at-risk obese, MHO women demonstrated a significantly higher (mean [SE]) percentage of leg fat (49.9 [0.5] vs. 53.2 [0.7]) and lower waist circumference (104 [0.6] vs. 101 cm [0.8]), despite no significant differences in overall adiposity.{\textbackslash}n{\textbackslash}nCONCLUSIONS: "Healthy" obesity was a transient state for one-third of subjects. Persistence of a MHO phenotype, which was associated with favorable outcomes, was related to younger age and a more peripheral fat distribution. The MHO phenotype may be sustained by promoting lower waist circumferences.},
  isbn = {0149-5992},
  pmid = {23491523},
  keywords = {Adult,Body Composition,Cardiovascular Diseases,Cardiovascular Diseases: etiology,Cohort Studies,Diabetes Mellitus,Female,Follow-Up Studies,Humans,Male,Middle Aged,Motor Activity,Obesity,Obesity: metabolism,Overweight,Overweight: metabolism,Phenotype,Risk,Waist Circumference}
}

@article{apteAmbientPM2Reduces2018,
  type = {Rapid-Communication},
  title = {Ambient {{PM2}}.5 {{Reduces Global}} and {{Regional Life Expectancy}}},
  author = {Apte, Joshua S. and Brauer, Michael and Cohen, Aaron J. and Ezzati, Majid and Pope, C. Arden},
  year = {2018},
  journal = {Environmental Science and Technology Letters},
  volume = {5},
  number = {9},
  pages = {546--551},
  publisher = {American Chemical Society},
  issn = {23288930},
  doi = {10.1021/acs.estlett.8b00360},
  abstract = {Exposure to ambient fine particulate matter (PM2.5) air pollution is a major risk for premature death. Here, we systematically quantify the global impact of PM2.5 on life expectancy. Using data from the Global Burden of Disease project and actuarial standard life table methods, we estimate global and national decrements in life expectancy that can be attributed to ambient PM2.5 for 185 countries. In 2016, PM2.5 exposure reduced average global life expectancy at birth by 1 year with reductions of 1.2-1.9 years in polluted countries of Asia and Africa. If PM2.5 in all countries met the World Health Organization Air Quality Guideline (10 {$\mu$}g m-3), we estimate life expectancy could increase by a population-weighted median of 0.6 year (interquartile range of 0.2-1.0 year), a benefit of a magnitude similar to that of eradicating lung and breast cancer. Because background disease rates modulate the effect of air pollution on life expectancy, high age-specific rates of cardiovascular disease in many polluted low- and middle-income countries amplify the impact of PM2.5 on survival. Our analysis adds to prior research by illustrating how mortality from air pollution substantially reduces human longevity.}
}

