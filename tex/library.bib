@article{Nakakuki2014a,
  title = {A Novel Processing System of Sterol Regulatory Element-Binding Protein-1c Regulated by Polyunsaturated Fatty Acid.},
  author = {Nakakuki, Masanori and Kawano, Hiroyuki and Notsu, Tatsuto and Imada, Kazunori and Mizuguchi, Kiyoshi and Shimano, Hitoshi},
  year = {2014},
  month = may,
  journal = {Journal of biochemistry},
  volume = {155},
  number = {5},
  eprint = {24729033},
  eprinttype = {pubmed},
  pages = {301--13},
  issn = {1756-2651},
  doi = {10.1093/jb/mvu019},
  urldate = {2014-12-28},
  abstract = {The proteolytic cascade is the key step in transactivation of sterol regulatory element-binding proteins (SREBPs), a transcriptional factor of lipid synthesis. Proteolysis of SREBP-2 is strictly regulated by sterols, but that of SREBP-1c was not strongly sterol-regulated, but inhibited by polyunsaturated fatty acids (PUFAs). In this study, the proteolytic processing of SREBP-1 and -2 was examined by transfection studies of cDNA-encoding mutants in which all the known cleavage sites were disrupted. In cultured cells, sterol-regulated SREBP-2 processing was completely eliminated by mutation of cleavage sites. In contrast, the corresponding SREBP-1c mutants as well as wild type exhibited large amounts of cleaved products in the nuclear extracts from culture cells and murine liver in vivo. The nuclear form of the mutant SREBP-1c was induced by delipidated condition and suppressed by eicosapentaenoic acid, an n-3 PUFA, but not by sterols. This novel processing mechanism was affected by neither SREBP cleavage-activating protein (SCAP) nor insulin-induced gene (Insig)-1, unlike SREBP-2, but abolished by a serine protease inhibitor. Through analysis of deletion mutant, a site-2 protease recognition sequence (DRSR) was identified to be involved in this novel processing. These findings suggest that SREBP-1c cleavage could be subjected to a novel PUFA-regulated cleavage system in addition to the sterol-regulatory SCAP/Insig system.},
  pmid = {24729033},
  keywords = {2-aminoethyl,4-,abbreviations,aebsf,benzenesulfonyl fluoride,eicosapentaenoic acid,fatty acids,lambda protein phosphatise,polyunsaturated,ppase,processing,srebp,sterols}
}

