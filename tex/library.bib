@article{Wu2014c,
  title = {Differential Regulation of Mouse Pancreatic Islet Insulin Secretion and {{Smad}} Proteins by Activin Ligands},
  author = {Wu, Haiya and Mezghenna, Karima and Marmol, Patricia and Guo, Tingqing and Moliner, Annalena and Yang, Shao Nian and Berggren, Per Olof and Ib{\'a}{\~n}ez, Carlos F.},
  year = {2014},
  journal = {Diabetologia},
  volume = {57},
  number = {1},
  pages = {148--156},
  issn = {0012186X},
  doi = {10.1007/s00125-013-3079-6},
  abstract = {AIMS/HYPOTHESIS: Glucose-stimulated insulin secretion (GSIS) from pancreatic beta cells is regulated by paracrine factors, the identity and mechanisms of action of which are incompletely understood. Activins are expressed in pancreatic islets and have been implicated in the regulation of GSIS. Activins A and B signal through a common set of intracellular components, but it is unclear whether they display similar or distinct functions in glucose homeostasis.{\textbackslash}n{\textbackslash}nMETHODS: We examined glucose homeostatic responses in mice lacking activin B and in pancreatic islets derived from these mutants. We compared the ability of activins A and B to regulate downstream signalling, ATP production and GSIS in islets and beta cells.{\textbackslash}n{\textbackslash}nRESULTS: Mice lacking activin B displayed elevated serum insulin levels and GSIS. Injection of a soluble activin B antagonist phenocopied these changes in wild-type mice. Isolated pancreatic islets from mutant mice showed enhanced GSIS, which could be rescued by exogenous activin B. Activin B negatively regulated GSIS and ATP production in wild-type islets, while activin A displayed the opposite effects. The downstream mediator Smad3 responded preferentially to activin B in pancreatic islets and beta cells, while Smad2 showed a preference for activin A, indicating distinct signalling effects of the two activins. In line with this, overexpression of Smad3, but not Smad2, decreased GSIS in pancreatic islets.{\textbackslash}n{\textbackslash}nCONCLUSIONS/INTERPRETATION: These results reveal a tug-of-war between activin ligands in the regulation of insulin secretion by beta cells, and suggest that manipulation of activin signalling could be a useful strategy for the control of glucose homeostasis in diabetes and metabolic disease.},
  pmid = {24132781},
  keywords = {ALK7,ATP,GSIS,Insulin secretion,Islet,Mitochondria,Smad,TGF-}
}

@article{Wu2016,
  title = {In Situ Characterization of the {{mTORC1}} during Adipogenesis of Human Adult Stem Cells on Chip},
  author = {Wu, Xuanye and Schneider, Nils and Platen, Alina and Mitra, Indranil and Blazek, Matthias and Zengerle, Roland and Sch{\"u}le, Roland and Meier, Matthias},
  year = {2016},
  month = jul,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {113},
  number = {29},
  pages = {E4143-E4150},
  issn = {0027-8424},
  doi = {10.1073/pnas.1601207113},
  abstract = {Mechanistic target of rapamycin (mTOR) is a central kinase required for integrating nutrient, energy, and metabolite signals. mTOR plays an important but unknown regulatory function for the maintenance and regeneration of adipose tissue by controlling the differentiation program of adult stem cells. Developmental signalling analysis of mTOR in general is hampered by the complexity of regulatory mechanisms in an ever-changing cellular microenvironment. Here, we developed a microfluidic large-scale integration chip platform for culturing and differentiating human adipose-derived stem cells (hASCs) under standardized nutrient conditions in vitro. With an integrated multiplex proximity ligation assay (mPLA) it was possible to reveal that only mTOR in complex 1 (mTORC1) is regulated in abundance, phosphorylation state and lysosmal localization during adipogenesis, whereas the protein composition of the complex remained unchanged. High content image analysis of the in situ PLA signals suggests mTORC1 and lysosomes spatially coordinate nutrient responses during adipogenesis.}
}

