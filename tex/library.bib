@article{Asher2015b,
  title = {Time for Food: {{The}} Intimate Interplay between Nutrition, Metabolism, and the Circadian Clock},
  author = {Asher, Gad and {Sassone-Corsi}, Paolo},
  year = {2015},
  journal = {Cell},
  volume = {161},
  number = {1},
  pages = {84--92},
  publisher = {Elsevier Inc.},
  issn = {10974172},
  doi = {10.1016/j.cell.2015.03.015},
  abstract = {The circadian clock, a highly specialized, hierarchical network of biological pacemakers, directs and maintains proper rhythms in endocrine and metabolic pathways required for organism homeostasis. The clock adapts to environmental changes, specifically daily light-dark cycles, as well as rhythmic food intake. Nutritional challenges reprogram the clock, while time-specific food intake has been shown to have profound consequences on physiology. Importantly, a critical role in the clock-nutrition interplay appears to be played by the microbiota. The circadian clock appears to operate as a critical interface between nutrition and homeostasis, calling for more attention on the beneficial effects of chrono-nutrition.},
  isbn = {00928674},
  pmid = {25815987}
}

