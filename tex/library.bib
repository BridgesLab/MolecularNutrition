@article{Mazurek2005,
  title = {Pyruvate Kinase Type {{M2}} and Its Role in Tumor Growth and Spreading},
  author = {Mazurek, Sybille and Boschek, C. Bruce and Hugo, Ferdinand and Eigenbrodt, Erich},
  year = {2005},
  journal = {Seminars in Cancer Biology},
  volume = {15},
  number = {4},
