  pages = {377--392},
  issn = {1936-0541},
  doi = {10.1007/s12072-022-10459-9},
  urldate = {2024-03-06},
  abstract = {Metabolic disorder is an essential characteristic of tumor development. Ketogenesis is a heterogeneous factor in multiple cancers, but the effect of ketogenesis on hepatocellular carcinoma (HCC) is elusive.},
  langid = {english},
  keywords = {Acetylation,DPP4,Ferroptosis,Hepatocellular carcinoma,HMGCL},
