@article{yagiHomologousRecombinationCfyn1990,
  title = {Homologous Recombination at C-Fyn Locus of Mouse Embryonic Stem Cells with Use of Diphtheria Toxin {{A-fragment}} Gene in Negative Selection.},
  author = {Yagi, T and Ikawa, Y and Yoshida, K and Shigetani, Y and Takeda, N and Mabuchi, I and Yamamoto, T and Aizawa, S and Knudson, A G.},
  year = {1990},
  month = dec,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {87},
  number = {24},
  pages = {9918--22},
  publisher = {National Academy of Sciences},
  issn = {0027-8424},
  doi = {10.1073/pnas.87.24.9918},
  abstract = {In attempting to produce a mutant mouse with embryonic stem cells, the critical step is the efficient isolation of homologous recombinants; the frequency of the homologous recombination is usually low and the potency of the cells to differentiate into germ cells is unstable in culture. Here, we report an efficacious method for such isolation in which the diphtheria toxin A-fragment gene is used to negatively select nonhomologous recombinants. In contrast to the use of the herpes simplex virus thymidine kinase gene, the selection can be made singly by the neomycin analog G418 without using a drug such as ganciclovir, a nucleoside analog. At the c-fyn locus, the diphtheria-toxin negative selection enriched the recombinants about 10-fold, and half of the cells integrating with the neomycin phosphotransferase gene were homologous recombinants.},
  pmid = {2263643}
}

@article{Yakar2005,
