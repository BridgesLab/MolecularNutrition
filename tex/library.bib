@article{Longo2014b,
  title = {Fasting: {{Molecular}} Mechanisms and Clinical Applications},
  author = {Longo, Valter D. and Mattson, Mark P.},
  year = {2014},
  month = feb,
  journal = {Cell Metabolism},
  volume = {19},
  number = {2},
  pages = {181--192},
  publisher = {Elsevier Inc.},
