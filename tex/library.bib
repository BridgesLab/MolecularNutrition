@article{Thearle2013,
  title = {Extent and Determinants of Thermogenic Responses to 24 Hours of Fasting, Energy Balance, and Five Different Overfeeding Diets in Humans},
  author = {Thearle, Marie S. and Pannacciulli, Nicola and Bonfiglio, Susan and Pacak, Karel and Krakoff, Jonathan},
  year = {2013},
  journal = {Journal of Clinical Endocrinology \& Metabolism},
  volume = {98},
  number = {7},
  pages = {2791--2799},
  issn = {0021972X},
  doi = {10.1210/jc.2013-1289},
  abstract = {CONTEXT: Individual variation in the ability to convert excess calories to heat and the effects of dietary macronutrient composition are unclear.{\textbackslash}n{\textbackslash}nOBJECTIVE: Stability and determinants of the energy expenditure (EE) response to overconsumption were assessed.{\textbackslash}n{\textbackslash}nDESIGN, SETTING, AND PARTICIPANTS: Twenty subjects (75\% male) with normal glucose regulation were evaluated during 24 hours each of energy balance, fasting, and 5 different diets with 200\% energy requirements in a clinical research unit.{\textbackslash}n{\textbackslash}nINTERVENTIONS: Five 1-day overfeeding diets were given in random order: high carbohydrate (75\%) and low protein (3\%); high carbohydrate and normal protein (20\%); high fat (46\%) and low protein; high fat (60\%) and normal protein; and balanced (50\% carbohydrates, 20\% protein).{\textbackslash}n{\textbackslash}nMAIN OUTCOME MEASURES: The 24-hour EE, sleeping EE, and thermic effect of food (TEF) during each diet were measured with a metabolic chamber. Appetitive hormones were measured before and after the diets.{\textbackslash}n{\textbackslash}nRESULTS: The EE response to overfeeding exhibited good intraindividual reproducibility. Similar increases above eucaloric feeding in 24-hour EE (mean 10.7 {\textpm} 5.7\%, P {$<$} .001; range 2.9-18.8\%) and sleeping EE (14.4 {\textpm} 11.3\%, P {$<$} .001; range 1.0-45.1\%) occurred when overfeeding diets containing 20\% protein, despite differences in fat and carbohydrate content, but the EE response during overfeeding diets containing 3\% protein was attenuated. The percent body fat negatively correlated with TEF during normal protein overfeeding (r = -0.53, P {$<$} .01). Fasting peptide YY negatively correlated with TEF (r = -0.56, P {$<$} .01) and the increase in sleeping EE (r = -0.54, P {$<$} .01) during overfeeding.{\textbackslash}n{\textbackslash}nCONCLUSIONS: There is an intrinsic EE response to overfeeding that negatively associates with adiposity, although it represents a small percentage of consumed calories.},
  isbn = {1945-7197 (Electronic){\textbackslash}r0021-972X (Linking)},
  pmid = {23666976},
  keywords = {journal club}
}

