@article{Tontonoz1998,
  title = {{{PPARd}} Promotes Monocyte/Macrophage Differentiation and Uptake of Oxidized {{LDL}}},
  author = {Tontonoz, Peter and Nagy, Laszlo and a Alvarez, J. G and a. Thomazy, Vilmos and Evans, Ronald M.},
