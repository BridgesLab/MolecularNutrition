@article{Gratz2013,
  title = {Genome Engineering of {{Drosophila}} with the {{CRISPR RNA-guided Cas9}} Nuclease.},
  author = {Gratz, Scott J and Cummings, Alexander M and Nguyen, Jennifer N and Hamm, Danielle C and Donohue, Laura K and Harrison, Melissa M and Wildonger, Jill and {O'Connor-Giles}, Kate M},
  year = {2013},
  journal = {Genetics},
  volume = {194},
  pages = {1029--35},
  issn = {1943-2631},
  doi = {10.1534/genetics.113.152710},
  abstract = {We have adapted a bacterial CRISPR RNA/Cas9 system to precisely engineer the Drosophila genome and report that Cas9-mediated genomic modifications are efficiently transmitted through the germline. This RNA-guided Cas9 system can be rapidly programmed to generate targeted alleles for probing gene function in Drosophila.},
  isbn = {1943-2631 (Electronic){\textbackslash}n0016-6731 (Linking)},
  pmid = {23709638},
  keywords = {Animals,Clustered Regularly Interspaced Short Palindromic,CRISPR-Cas Systems,Drosophila,Drosophila Proteins,Drosophila Proteins: genetics,Drosophila: genetics,Endodeoxyribonucleases,Endodeoxyribonucleases: genetics,Endodeoxyribonucleases: metabolism,Gene Targeting,Genetic Engineering,Genetic Engineering: methods,Genome Insect,Germ-Line Mutation,Homologous Recombination}
