  urldate = {2012-03-06},
  abstract = {Increasing evidence supports the central role of Paneth cells in maintaining intestinal host-microbial homeostasis. However, the direct impact of host genotype on Paneth cell function remains unclear. Here, we characterize key differences in Paneth cell function and intestinal microbial composition in two widely utilized, genetically distinct mouse strains (C57BL/6 and 129/SvEv). In doing so, we demonstrate critical influences of host genotype on Paneth cell activity and the enteric microbiota.},
