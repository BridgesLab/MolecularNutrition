@article{Oishi2009,
  title = {Ketogenic Diet Disrupts the Circadian Clock and Increases Hypofibrinolytic Risk by Inducing Expression of Plasminogen Activator Inhibitor-1},
  author = {Oishi, Katsutaka and Uchida, Daisuke and Ohkura, Naoki and Doi, Ryosuke and Ishida, Norio and Kadota, Koji and Horie, Shuichi},
  year = {2009},
  journal = {Arteriosclerosis, Thrombosis, and Vascular Biology},
  volume = {29},
  number = {10},
  pages = {1571--1577},
  issn = {10795642},
  doi = {10.1161/ATVBAHA.109.190140},
  abstract = {OBJECTIVE: Metabolic disorders such as diabetes and obesity are considered risk factors for cardiovascular diseases by increasing levels of blood plasminogen activator inhibitor-1 (PAI-1). Ketogenic diets (KDs) have been used as an approach to weight loss in both obese and nonobese individuals. We examined circadian changes in plasma PAI-1 and its mRNA expression levels in tissues from mice fed with a KD (KD mice), to evaluate its effects on fibrinolytic functions.{\textbackslash}n{\textbackslash}nMETHODS AND RESULTS: Two weeks on the kDa increased plasma levels of free fatty acids and ketones accompanied by hypoglycemia in mice. Plasma PAI-1 concentrations were extremely elevated in accordance with mRNA expression levels in the heart and liver, but not in the kidneys of KD mice. Circadian expression of PAI-1 mRNA was phase-advanced for 4.7, 7.9, and 7.8 hours in the heart, kidney, and adipose tissues, respectively, as well as that of circadian genes mPer2 and DBP in KD mice, suggesting that peripheral clocks were phase-advanced by ketosis despite feeding ad libitum under a periodic light-dark cycle. The circadian clock that regulates behavioral activity rhythms was also phase-advanced, and its free-running period was significantly shortened in KD mice.{\textbackslash}n{\textbackslash}nCONCLUSIONS: Our findings suggest that ketogenic status increases hypofibrinolytic risk by inducing abnormal circadian expression of PAI-1.},
  isbn = {1524-4636 (Electronic)},
  pmid = {19628783},
  keywords = {Clock gene,Hypofibrinolysis,Ketosis,Metabolic disorders,Obesity,Weight loss}
}

@article{Oishi2016,
  title = {{{SREBP1 Contributes}} to {{Resolution}} of {{Pro-inflammatory TLR4 Signaling}} by {{Reprogramming Fatty Acid Metabolism}}},
  author = {Oishi, Yumiko and Spann, Nathanael J. and Link, Verena M. and Muse, Evan D. and Strid, Tobias and Edillor, Chantle and Kolar, Matthew J. and Matsuzaka, Takashi and Hayakawa, Sumio and Tao, Jenhan and Kaikkonen, Minna U. and Carlin, Aaron F. and Lam, Michael T. and Manabe, Ichiro and Shimano, Hitoshi and Saghatelian, Alan and Glass, Christopher K.},
  year = {2016},
  journal = {Cell Metabolism},
  pages = {1--16},
  publisher = {Elsevier Inc.},
  issn = {15504131},
  doi = {10.1016/j.cmet.2016.11.009},
  abstract = {Macrophages play pivotal roles in both the induction and resolution phases of inflammatory processes. Macrophages have been shown to synthesize anti-inflammatory fatty acids in an LXR-dependent manner, but whether the production of these species contributes to the resolution phase of inflammatory responses has not been established. Here, we identify a biphasic program of gene expression that drives production of anti-inflammatory fatty acids 12--24~hr following TLR4 activation and contributes to downregulation of mRNAs encoding pro-inflammatory mediators. Unexpectedly, rather than requiring LXRs, this late program of anti-inflammatory fatty acid biosynthesis is dependent on SREBP1 and results in the uncoupling of NF{$\kappa$}B binding from gene activation. In contrast to previously identified roles of SREBP1 in promoting production of IL1{$\beta$} during the induction phase of inflammation, these studies provide evidence that SREBP1 also contributes to the resolution phase of TLR4-induced gene activation by reprogramming macrophage lipid metabolism.},
  pmid = {28041958}
}

