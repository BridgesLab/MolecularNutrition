@article{Davies2010,
  title = {{{GPIHBP1}} Is Responsible for the Entry of Lipoprotein Lipase into Capillaries},
  author = {Davies, Brandon S J and Beigneux, Anne P. and Barnes, Richard H. and Tu, Yiping and Gin, Peter and Weinstein, Michael M. and Nobumori, Chika and Nyr{\'e}n, Rakel and Goldberg, Ira and Olivecrona, Gunilla and Bensadoun, Andr{\'e} and Young, Stephen G. and Fong, Loren G.},
