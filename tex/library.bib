@article{Phillips1996,
  title = {Leptin Receptor Missense Mutation in the Fatty {{Zucker}} Rat.},
  author = {Phillips, M S and Liu, Q and Hammond, H A and Dugan, V and Hey, P J and Caskey, C J and Hess, J F},
  year = {1996},
  journal = {Nature Genetics},
  volume = {13},
  number = {1},
