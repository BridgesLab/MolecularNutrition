@article{Ripple2010,
  title = {Immunomodulation with {{IL-4R}} Alpha Antisense Oligonucleotide Prevents Respiratory Syncytial Virus-Mediated Pulmonary Disease.},
  author = {Ripple, Michael J and You, Dahui and Honnegowda, Srinivasa and Giaimo, Joseph D and Sewell, Andrew B and Becnel, David M and Cormier, Stephania A.},
