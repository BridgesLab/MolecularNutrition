  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {529--537},
  doi = {10.1016/B978-0-12-804572-5.00070-7},
  abstract = {Whereas previous approaches to disease prevention involved the provision of generalized advice in relation to diet and exercise, the evolution of genomic technologies has enabled the development of more specific advice tailored to the individual. A number of companies in various parts of the world now offer personalized advice based on genetic profiles without necessarily involving qualified health professionals. Regulations about such use differ among countries, partly according to the history and understanding of such a concept.},
