  keywords = {Animals,Humans,Longevity,Longevity: drug effects,Longevity: physiology,Metabolome,Metabolome: drug effects,Mitochondria,Mitochondria: drug effects,Mitochondria: metabolism,Multiprotein Complexes,Multiprotein Complexes: antagonists & inhibitors,Reactive Oxygen Species,Reactive Oxygen Species: metabolism,Signal Transduction,Signal Transduction: drug effects,Sirolimus,Sirolimus: pharmacology,TOR Serine-Threonine Kinases,TOR Serine-Threonine Kinases: antagonists & inhibi}
