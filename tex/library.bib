@article{Wilson2016b,
  title = {Hepatocyte-Specific Disruption of {{CD36}} Attenuates Fatty Liver and Improves Insulin Sensitivity in {{HFD-fed}} Mice},
  author = {Wilson, Camella G. and Tran, Jennifer L. and Erion, Derek M. and Vera, Nicholas B. and Febbraio, Maria and Weiss, Ethan J.},
  year = {2016},
  month = dec,
  journal = {Endocrinology},
  volume = {157},
  number = {2},
  pages = {570--585},
  issn = {19457170},
  doi = {10.1210/en.2015-1866},
  abstract = {CD36/FAT (fatty acid translocase) has been associated with human and murine non-alcoholic fatty liver disease (NAFLD), but it has been unclear if it is simply a marker or if it directly contributes to disease pathogenesis. Mice with hepatocyte-specific deletion of JAK2 (JAK2L) have increased circulating free fatty acids (FA), dramatically increased hepatic CD36 expression and profound fatty liver. To investigate the role of elevated CD36 in development of fatty liver, we studied two models of hepatic steatosis, a genetic model (JAK2L mice) and high fat diet (HFD) induced steatosis model. We deleted CD36 specifically in hepatocytes of JAK2L mice to generate double knockouts (DKO) and from wild-type (WT) mice to generate CD36L single knock out mice. Hepatic disruption of CD36 in JAK2L livers significantly improved steatosis by lowering triglyceride (TG), diacylglycerol (DAG) and cholesterol ester (CE) content. The largest differences in liver TG were in species comprising of oleic acid (C18:1). Reduction in liver lipids correlated with an improvement in the inflammatory markers that were elevated in JAK2L mice, namely aspartate aminotransferase (AST) and alanine transaminase (ALT). CD36 disruption in mice on HFD (CD36L-HFD) reduced liver lipid content and decreased hepatic BODIPY-FA uptake as compared to CON-HFD. Additionally, CD36L-HFD mice had improved whole-body insulin sensitivity and reduced liver and serum inflammatory markers. Therefore, CD36 directly contributes to development of fatty liver under conditions of elevated FFA by modulating the rate of FA uptake by hepatocytes. In HFD-fed animals, disruption of hepatic CD36 protects against associated systemic inflammation and insulin resistance.},
  pmid = {26650570}
}

