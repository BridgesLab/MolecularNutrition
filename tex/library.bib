@article{Hotta2009,
  title = {Association between Obesity and Polymorphisms in {{SEC16B}}, {{TMEM18}}, {{GNPDA2}}, {{BDNF}}, {{FAIM2}} and {{MC4R}} in a {{Japanese}} Population.},
  author = {Hotta, Kikuko and Nakamura, Michihiro and Nakamura, Takahiro and Matsuo, Tomoaki and Nakata, Yoshio and Kamohara, Seika and Miyatake, Nobuyuki and Kotani, Kazuaki and Komatsu, Ryoya and Itoh, Naoto and Mineo, Ikuo and Wada, Jun and Masuzaki, Hiroaki and Yoneda, Masato and Nakajima, Atsushi and Funahashi, Tohru and Miyazaki, Shigeru and Tokunaga, Katsuto and Kawamoto, Manabu and Ueno, Takato and Hamaguchi, Kazuyuki and Tanaka, Kiyoji and Yamada, Kentaro and Hanafusa, Toshiaki and Oikawa, Shinichi and Yoshimatsu, Hironobu and Nakao, Kazuwa and Sakata, Toshiie and Matsuzawa, Yuji and Kamatani, Naoyuki and Nakamura, Yusuke},
  year = {2009},
  month = dec,
  journal = {Journal of human genetics},
  volume = {54},
  number = {12},
  eprint = {19851340},
  eprinttype = {pubmed},
  pages = {727--31},
  publisher = {Nature Publishing Group},
  issn = {1435-232X},
  doi = {10.1038/jhg.2009.106},
  urldate = {2014-08-15},
  abstract = {There is evidence that the obesity phenotype in the Caucasian populations is associated with variations in several genes, including neuronal growth regulator 1 (NEGR1), SEC16 homolog B (SCE16B), transmembrane protein 18 (TMEM18), ets variant 5 (ETV5), glucosamine-6-phosphate deaminase 2 (GNPDA2), prolactin (PRL), brain-derived neurotrophic factor (BDNF), mitochondrial carrier homolog 2 (MTCH2), Fas apoptotic inhibitory molecule 2 (FAIM2), SH2B adaptor protein 1 (SH2B1), v-maf musculoaponeurotic fibrosarcoma oncogene homolog (MAF), Niemann-Pick disease, type C1 (NPC1), melanocortin 4 receptor (MC4R) and potassium channel tetramerisation domain containing 15 (KCTD15). To investigate the relationship between obesity and these genes in the Japanese population, we genotyped 27 single-nucleotide polymorphisms (SNPs) in 14 genes from obese subjects (n=1129, body mass index (BMI) {$>$} or =30 kg m(-2)) and normal-weight control subjects (n=1736, BMI {$<$}25 kg m(-2)). The SNP rs10913469 in SEC16B (P=0.000012) and four SNPs (rs2867125, rs6548238, rs4854344 and rs7561317) in the TMEM18 gene (P=0.00015), all of which were in almost absolute linkage disequilibrium, were significantly associated with obesity in the Japanese population. SNPs in GNPDA2, BDNF, FAIM2 and MC4R genes were marginally associated with obesity (P{$<$}0.05). Our data suggest that some SNPs identified by genome-wide association studies in the Caucasians also confer susceptibility to obesity in Japanese subjects.},
  isbn = {1435-232X (Electronic){\textbackslash}n1434-5161 (Linking)},
  pmid = {19851340},
  keywords = {Adult,Aldose-Ketose Isomerases,Aldose-Ketose Isomerases: genetics,Apoptosis Regulatory Proteins,Apoptosis Regulatory Proteins: genetics,Asian Continental Ancestry Group,Asian Continental Ancestry Group: genetics,Body Mass Index,Brain-Derived Neurotrophic Factor,Brain-Derived Neurotrophic Factor: genetics,Chi-Square Distribution,DNA-Binding Proteins,DNA-Binding Proteins: genetics,Female,Gene Frequency,Genetic Predisposition to Disease,Genetic Predisposition to Disease: genetics,Genotype,Humans,Japan,Linkage Disequilibrium,Male,Melanocortin,Membrane Proteins,Membrane Proteins: genetics,Middle Aged,Obesity,Obesity: ethnology,Obesity: genetics,Polymorphism,Receptor,Single Nucleotide,Type 4,Type 4: genetics}
}

