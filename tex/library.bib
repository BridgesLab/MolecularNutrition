}

@article{Wu2014a,
  title = {{{NF-$\kappa$B}} but Not {{FoxO}} Sites in the {{MuRF1}} Promoter Are Required for Transcriptional Activation in Disuse Muscle Atrophy.},
  author = {Wu, Chia-Ling and Cornwell, Evangeline W and Jackman, Robert W and Kandarian, Susan C},
  year = {2014},
  month = apr,
  journal = {American Journal of Physiology - Cell Physiology},
  volume = {306},
  number = {8},
  eprint = {24553183},
  eprinttype = {pubmed},
  pages = {C762-7},
  issn = {1522-1563},
  doi = {10.1152/ajpcell.00361.2013},
  urldate = {2015-01-13},
  abstract = {The muscle-specific ring finger protein 1 (MuRF1) gene is required for most types of skeletal muscle atrophy yet we have little understanding of its transcriptional regulation. The purpose of this study is to identify whether NF-{$\kappa$}B and/or FoxO response elements in the MuRF1 promoter are required for MuRF1 gene activation during skeletal muscle atrophy due to the removal of hindlimb weight bearing ("unloading"). Both NF-{$\kappa$}B -dependent and FoxO-dependent luciferase reporter activities were significantly increased at 5 days of unloading. Using a 4.4-kb MuRF1 promoter reporter construct, a fourfold increase in reporter (i.e., luciferase) activity was found in rat soleus muscles after 5 days of hindlimb unloading. This activation was abolished by mutagenesis of either of the two distal putative NF-{$\kappa$}B sites or all three putative NF-{$\kappa$}B sites but not by mutagenesis of all four putative FoxO sites. This work provides the first direct evidence that NF-{$\kappa$}B sites, but not FoxO sites, are required for MuRF1 promoter activation in muscle disuse atrophy in vivo.},
  pmid = {24553183},
  keywords = {Animals,Female,Forkhead Transcription Factors,Forkhead Transcription Factors: genetics,Forkhead Transcription Factors: metabolism,Hindlimb Suspension,Muscle Proteins,Muscle Proteins: genetics,Muscle Proteins: metabolism,Muscular Atrophy,Muscular Atrophy: metabolism,NF-kappa B,NF-kappa B: genetics,NF-kappa B: metabolism,Promoter Regions Genetic,Rats,Transcriptional Activation,Transcriptional Activation: physiology,Ubiquitin-Protein Ligases,Ubiquitin-Protein Ligases: genetics,Ubiquitin-Protein Ligases: metabolism}
}

