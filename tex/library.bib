@article{Butler2001,
  title = {Melanocortin-4 Receptor Is Required for Acute Homeostatic Responses to Increased Dietary Fat},
  author = {Butler, Andrew A. and Marks, D L and Fan, W and Kuhn, C M and Bartolome, M and Cone, R D},
  year = {2001},
  journal = {Nature neuroscience},
  volume = {4},
  number = {6},
  eprint = {11369941},
  eprinttype = {pubmed},
  pages = {605--611},
  issn = {1097-6256 (Print)},
  doi = {10.1038/88423},
  abstract = {In response to moderately increased dietary fat content, melanocortin-4 receptor-null mutant (MC4R-/-) mice exhibit hyperphagia and accelerated weight gain compared to wild-type mice. An increased feed efficiency (weight gain/kcal consumed) argues that mechanisms in addition to hyperphagia are instrumental in causing weight gain. We report two specific defects in coordinating energy expenditure with food intake in MC4R-/- mice. Wild-type mice respond to an increase in the fat content of the diet by rapidly increasing diet-induced thermogenesis and by increasing physical activity, neither of which are observed in MC4R-/- mice. Leptin-deficient and MC3R-/- mice regulate metabolic rate similarly to wild-type mice in this protocol. Melanocortinergic pathways involving MC4-R-regulated neurons, which rapidly respond to signals not requiring changes in leptin, thus seem to be important in regulating metabolic and behavioral responses to dietary fat.},
  isbn = {1097-6256 (Print){\textbackslash}r1097-6256 (Linking)},
  pmid = {11369941},
  keywords = {Adipose Tissue Brown/physiology,Animals,Brown/physiology,Corticotropin/deficiency/genetics/*phys,Crosses Genetic,Dietary Fats/*pharmacology,Energy Metabolism,Feeding Behavior,Female,Genetic,Homeostasis,Hyperphagia/*genetics,Inbred C57BL,Knockout,Leptin/deficiency/genetics/physiology,Male,Melanocortin,Mice,Mice Inbred C57BL,Mice Knockout,Physical Exertion,Receptor Melanocortin Type 3,Receptor Melanocortin Type 4,Receptors Corticotropin/deficiency/genetics/*phys,Reference Values,Thermogenesis,Type 3,Type 4,Weight Gain}
}

@article{Butler2002,
  title = {Specific Inhibition of {{PTEN}} Expression Reverses Hyperglycemia in Diabetic Mice.},
  author = {Butler, Madeline and McKay, Robert A and Popoff, Ian J and a Gaarde, William and Witchell, Donna and Murray, Susan F and Dean, Nicholas M and Bhanot, Sanjay and Monia, Brett P},
  year = {2002},
  month = apr,
  journal = {Diabetes},
  volume = {51},
  number = {4},
  eprint = {11916922},
  eprinttype = {pubmed},
  pages = {1028--34},
  issn = {0012-1797},
  abstract = {Signaling through the phosphatidylinositol 3'-kinase (PI3K) pathway is crucial for metabolic responses to insulin, and defects in PI3K signaling have been demonstrated in type 2 diabetes. PTEN (MMAC1) is a lipid/protein phosphatase that can negatively regulate the PI3K pathway by dephosphorylating phosphatidylinositol (3,4,5)-triphosphate, but it is unclear whether PTEN is physiologically relevant to insulin signaling in vivo. We employed an antisense oligonucleotide (ASO) strategy in an effort to specifically inhibit the expression of PTEN. Transfection of cells in culture with ASO targeting PTEN reduced PTEN mRNA and protein levels and increased insulin-stimulated Akt phosphorylation in alpha-mouse liver-12 (AML12) cells. Systemic administration of PTEN ASO once a week in mice suppressed PTEN mRNA and protein expression in liver and fat by up to 90 and 75\%, respectively, and normalized blood glucose concentrations in db/db and ob/ob mice. Inhibition of PTEN expression also dramatically reduced insulin concentrations in ob/ob mice, improved the performance of db/db mice during insulin tolerance tests, and increased Akt phosphorylation in liver in response to insulin. These results suggest that PTEN plays a significant role in regulating glucose metabolism in vivo by negatively regulating insulin signaling.},
  pmid = {11916922},
  keywords = {3T3 Cells,Adipocytes,Adipocytes: physiology,Animals,Cell Line,Cells Cultured,Gene Expression Regulation,Genes Tumor Suppressor,Glucose,Glucose: metabolism,Hepatocytes,Insulin,Insulin: metabolism,Kinetics,Lipid Metabolism,Mice,Oligodeoxyribonucleotides Antisense,Oligodeoxyribonucleotides Antisense: pharmacology,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 3-Kinases: metabolism,Phosphoric Monoester Hydrolases,Phosphoric Monoester Hydrolases: antagonists & inh,Phosphoric Monoester Hydrolases: genetics,Protein-Serine-Threonine Kinases,Protein-Tyrosine Kinases,Protein-Tyrosine Kinases: genetics,Protein-Tyrosine Kinases: metabolism,Proto-Oncogene Proteins,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins: genetics,Proto-Oncogene Proteins: metabolism,PTEN Phosphohydrolase,Recombinant Proteins,Recombinant Proteins: antagonists & inhibitors,RNA Messenger,RNA Messenger: genetics,Transcription Genetic,Transcription Genetic: drug effects,Transfection,Tumor Suppressor Proteins,Tumor Suppressor Proteins: antagonists & inhibitor,Tumor Suppressor Proteins: genetics}
}

