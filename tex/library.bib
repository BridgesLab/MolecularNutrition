@article{Kim2000,
  title = {Redistribution of Substrates to Adipose Tissue Promotes Obesity in Mice with Selective Insulin Resistance in Muscle.},
  author = {Kim, J K and Michael, M D and Previs, S F and Peroni, Odile D. and {Mauvais-Jarvis}, F and Neschen, S and Kahn, Barbara B. and Kahn, C. Ronald and Shulman, Gerald I.},
  year = {2000},
  month = jun,
  journal = {The Journal of clinical investigation},
  volume = {105},
  number = {12},
  pages = {1791--7},
  issn = {0021-9738},
  doi = {10.1172/JCI8305},
  urldate = {2012-07-11},
  abstract = {Obesity and insulin resistance in skeletal muscle are two major factors in the pathogenesis of type 2 diabetes. Mice with muscle-specific inactivation of the insulin receptor gene (MIRKO) are normoglycemic but have increased fat mass. To identify the potential mechanism for this important association, we examined insulin action in specific tissues of MIRKO and control mice under hyperinsulinemic-euglycemic conditions. We found that insulin-stimulated muscle glucose transport and glycogen synthesis were decreased by about 80\% in MIRKO mice, whereas insulin-stimulated fat glucose transport was increased threefold in MIRKO mice. These data demonstrate that selective insulin resistance in muscle promotes redistribution of substrates to adipose tissue thereby contributing to increased adiposity and development of the prediabetic syndrome.},
  pmid = {10862794},
  keywords = {Adipose Tissue,Adipose Tissue: metabolism,Animals,Blood Glucose,Blood Glucose: metabolism,Glucose,Glucose Clamp Technique,Glucose: metabolism,Glycogen,Glycogen: biosynthesis,Glycolysis,Hyperinsulinism,Insulin,insulin receptor,Insulin Resistance,Insulin Resistance: genetics,Insulin: deficiency,Insulin: genetics,Insulin: pharmacology,Insulin: physiology,Knockout,knockout mouse,Male,Mice,mirko,muscle,Muscle,Obesity,Obesity: genetics,Obesity: physiopathology,Receptor,Reference Values,Skeletal,Skeletal: drug effects,Skeletal: metabolism,Skeletal: physiopathology}
}

