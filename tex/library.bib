@article{Fisher2010,
  title = {Obesity Is a Fibroblast Growth Factor 21 ({{FGF21}})-Resistant State.},
  author = {Fisher, Ffolliott M. and Chui, Patricia C and Antonellis, Patrick J and a Bina, Holly and Kharitonenkov, Alexei and Flier, Jeffrey S. and {Maratos-Flier}, Eleftheria},
  year = {2010},
