@article{Lawrence2003,
  title = {{{ADP-ribosylation}} Factor 6 Regulates Insulin Secretion through Plasma Membrane Phosphatidylinositol 4,5-Bisphosphate.},
  author = {Lawrence, John T R and Birnbaum, Morris J.},
  year = {2003},
  month = nov,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {100},
  number = {23},
  pages = {13320--5},
  issn = {0027-8424},
  doi = {10.1073/pnas.2232129100},
  abstract = {ADP-ribosylation factor 6 (ARF6) is a small GTP-binding protein that regulates peripheral vesicular trafficking and actin cytoskeletal dynamics, and it has been implicated as critical to regulated secretion. Expression of a dominant-inhibitory ARF6 mutant, ARF6(T27N), impaired glucose-, depolarization-, and gamma-thio-GTP-stimulated insulin secretion in the pancreatic beta cell line, MIN6. In response to depolarization, MIN6 cells expressing ARF6(T27N) displayed an unaltered initial fast phase but an impaired subsequent slow phase of insulin secretion. Actin cytoskeletal disassembly with latrunculin A enhanced insulin secretion, whereas stabilization with jasplakinolide inhibited secretion, consistent with the actin cytoskeleton serving as a barrier to exocytosis in these cells. ARF6(T27N) led to a depolarization-dependent reduction in the levels of phosphatidylinositol 4,5-bisphosphate [PI(4,5)P2] with a time course that paralleled the inhibition of secretion. Moreover, blockade of PI(4,5)P2-dependent events by expression of a lipid-binding protein resulted in inhibition of depolarization-induced secretion in a manner identical to ARF6(T27N). These results indicate that ARF6 is required to sustain adequate levels of PI(4,5)P2 during periods of increased PI(4,5)P2 metabolism such as regulated secretion.},
  pmid = {14585928},
  keywords = {5-Diphosphate,5-Diphosphate: metabolism,Actins,Actins: metabolism,ADP-Ribosylation Factors,ADP-Ribosylation Factors: metabolism,ADP-Ribosylation Factors: physiology,Animals,arf,arf6,Calcium,Calcium: metabolism,Cell Line,Cell Membrane,Cell Membrane: metabolism,Chromatography,Dominant,Dose-Response Relationship,Drug,exocytosis,Flow Cytometry,Gene Transfer Techniques,Genes,Genetic Vectors,Glucose,Glucose: pharmacology,Green Fluorescent Proteins,Insulin,insulin secretion,Insulin: secretion,Luminescent Proteins,Luminescent Proteins: metabolism,Mice,Mutation,Peptides,Peptides: chemistry,Phosphatidylinositol 4,pi45p2,Thin Layer,Time Factors}
}

@article{Lawrence2014,
  title = {Scalable {{Genomics}} with {{R}} and {{Bioconductor}}},
  author = {Lawrence, Michael and Morgan, Martin},
  year = {2014},
  month = may,
  journal = {Statistical Science},
