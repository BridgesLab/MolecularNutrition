@article{Zhao2007c,
  title = {{{FoxO3 Coordinately Activates Protein Degradation}} by the {{Autophagic}}/{{Lysosomal}} and {{Proteasomal Pathways}} in {{Atrophying Muscle Cells}}},
  author = {Zhao, Jinghui and Brault, Jeffrey J. and Schild, Andreas and Cao, Peirang and Sandri, Marco and Schiaffino, Stefano and Lecker, Stewart H. and Goldberg, Alfred L.},
  year = {2007},
  month = dec,
  journal = {Cell Metabolism},
  volume = {6},
  number = {6},
  eprint = {18054316},
  eprinttype = {pubmed},
  pages = {472--483},
  issn = {15504131},
  doi = {10.1016/j.cmet.2007.11.004},
  urldate = {2014-07-13},
  abstract = {Muscle atrophy occurs in many pathological states and results primarily from accelerated protein degradation and activation of the ubiquitin-proteasome pathway. However, the importance of lysosomes in muscle atrophy has received little attention. Activation of FoxO transcription factors is essential for the atrophy induced by denervation or fasting, and activated FoxO3 by itself causes marked atrophy of muscles and myotubes. Here, we report that FoxO3 does so by stimulating overall protein degradation and coordinately activating both lysosomal and proteasomal pathways. Surprisingly, in C2C12 myotubes, most of this increased proteolysis is mediated by lysosomes. Activated FoxO3 stimulates lysosomal proteolysis in??muscle (and other cell types) by activating autophagy. FoxO3 also induces the expression of many autophagy-related genes, which are induced similarly in mouse muscles atrophying due to denervation or fasting. These studies indicate that decreased IGF-1-PI3K-Akt signaling activates autophagy not only through mTOR but also more slowly by a transcription-dependent mechanism involving FoxO3. ?? 2007 Elsevier Inc. All rights reserved.},
  isbn = {1550-4131 (Print)},
  pmid = {18054316},
  keywords = {Animals,Autophagy,Autophagy: genetics,Autophagy: physiology,Base Sequence,Biological,Cell Line,DNA,DNA: genetics,Forkhead Transcription Factors,Forkhead Transcription Factors: antagonists & inhi,Forkhead Transcription Factors: genetics,Forkhead Transcription Factors: metabolism,Gene Expression Regulation,HUMDISEASE,Knockout,Lysosomes,Lysosomes: metabolism,Mice,Models,Muscle Fibers,Muscle Proteins,Muscle Proteins: metabolism,Muscular Atrophy,Muscular Atrophy: etiology,Muscular Atrophy: genetics,Muscular Atrophy: metabolism,Muscular Atrophy: pathology,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 3-Kinases: metabolism,Proteasome Endopeptidase Complex,Proteasome Endopeptidase Complex: metabolism,PROTEINS,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins c-akt: metabolism,SIGNALING,Skeletal,Skeletal: metabolism,SKP Cullin F-Box Protein Ligases,Ubiquitin-Protein Ligases,Ubiquitin-Protein Ligases: deficiency,Ubiquitin-Protein Ligases: genetics}
}

@article{Zhao2008,
  title = {{{TEAD}} Mediates {{YAP-dependent}} Gene Induction and Growth Control},
  author = {Zhao, B and Ye, X and Yu, J and Li, L and Li, W and Li, S and Lin, J D and Wang, C Y and Chinnaiyan, A M and Lai, Z C and Guan, Kun-Liang},
  year = {2008},
  journal = {Genes and Development},
  volume = {22},
  number = {14},
  pages = {1962--1971},
  doi = {gad.1664408 [pii] 10.1101/gad.1664408},
  abstract = {The YAP transcription coactivator has been implicated as an oncogene and is amplified in human cancers. Recent studies have established that YAP is phosphorylated and inhibited by the Hippo tumor suppressor pathway. Here we demonstrate that the TEAD family transcription factors are essential in mediating YAP-dependent gene expression. TEAD is also required for YAP-induced cell growth, oncogenic transformation, and epithelial-mesenchymal transition. CTGF is identified as a direct YAP target gene important for cell growth. Moreover, the functional relationship between YAP and TEAD is conserved in Drosophila Yki (the YAP homolog) and Scalloped (the TEAD homolog). Our study reveals TEAD as a new component in the Hippo pathway playing essential roles in mediating biological functions of YAP.},
  isbn = {0890-9369 (Print)},
  keywords = {*Cell Proliferation,*Transcription Genetic,Adaptor Proteins Signal Transducing/genetics/*met,Animals,Breast Neoplasms/genetics/metabolism,Carcinoma Renal Cell/genetics/metabolism,Cell Transformation Neoplastic,Cells Cultured,DNA-Binding Proteins/genetics/*metabolism,Epithelial Cells/metabolism,Gene Expression Regulation,Humans,Kidney Neoplasms/genetics/metabolism,Mesoderm/cytology/metabolism,Mice,NIH 3T3 Cells,Nuclear Proteins/genetics/*metabolism,Phosphoproteins/genetics/*metabolism,Promoter Regions Genetic,Signal Transduction,Trans-Activators,Transcription Factors/genetics/*metabolism,Transcriptional Activation}
}

