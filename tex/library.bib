@article{Schuler2004,
  title = {Efficient Temporally Controlled Targeted Somatic Mutagenesis in Hepatocytes of the Mouse},
  author = {Schuler, Michael and Dierich, Andr{\'e}e and Chambon, Pierre and Metzger, Daniel},
  year = {2004},
  journal = {Genesis},
  volume = {39},
  number = {3},
  pages = {167--172},
  issn = {1526954X},
  doi = {10.1002/gene.20039},
  abstract = {To generate temporally controlled targeted somatic mutations selectively and efficiently in skeletal muscles, we established a transgenic HSA-Cre-ER(T2) mouse line in which the expression of the tamoxifen-dependent Cre-ER(T2) recombinase is under the control of a large genomic DNA segment of the human skeletal muscle alpha-actin gene, contained in a P1-derived artificial chromosome. In this transgenic line Cre-ER(T2) is selectively expressed in skeletal muscles, and Cre-ER(T2)-mediated alteration of LoxP flanked (floxed) target genes is skeletal muscle-specific and strictly tamoxifen-dependent. HSA-Cre-ER(T2) mice should be of great value to analyze gene function in skeletal muscles, and to establish animal models of human skeletal muscle disorders.},
  isbn = {1526-954X (Print){\textbackslash}r1526-954X (Linking)},
  pmid = {15789425},
  keywords = {Cre-ERT2 recominase,Cre/LoxP technology,Liver,Serum albumin,Tamoxifen}
}

