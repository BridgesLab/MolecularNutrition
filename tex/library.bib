@article{Sagona2011,
  title = {A {{Tumor-Associated Mutation}} of {{FYVE-CENT Prevents Its Interaction}} with {{Beclin}} 1 and {{Interferes}} with {{Cytokinesis}}.},
  author = {Sagona, Antonia P and Nezis, Ioannis P. and Bache, Kristi G and Haglund, Kaisa and Bakken, Anne Cathrine and Skotheim, Rolf I and Stenmark, Harald},
  year = {2011},
  month = jan,
  journal = {PloS one},
  volume = {6},
  number = {3},
  eprint = {21455500},
  eprinttype = {pubmed},
  pages = {e17086},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0017086},
  urldate = {2011-04-04},
  abstract = {The tumor suppressor activity of Beclin 1 (BECN1), a subunit of class III phosphatidylinositol 3-kinase complex, has been attributed to its regulation of apoptosis and autophagy. Here, we identify FYVE-CENT (ZFYVE26), a phosphatidylinositol 3-phosphate binding protein important for cytokinesis, as a novel interacting protein of Beclin 1. A mutation in FYVE-CENT (R1945Q) associated with breast cancer abolished the interaction between FYVE-CENT and Beclin 1, and reduced the localization of these proteins at the intercellular bridge during cytokinesis. Breast cancer cells containing the FYVE-CENT R1945Q mutation displayed a significant increase in cytokinetic profiles and bi - multinuclear phenotype. Both Beclin 1 and FYVE-CENT were found to be downregulated in advanced breast cancers. These findings suggest a positive feedback loop for recruitment of FYVE-CENT and Beclin 1 to the intercellular bridge during cytokinesis, and reveal a novel potential tumor suppressor mechanism for Beclin 1.},
  pmid = {21455500}
}

