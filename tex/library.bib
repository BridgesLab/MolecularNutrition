  author = {Patel, Rucha and Bookout, Angie L. and Magomedova, Lilia and Owen, Bryn M. and Consiglio, Giulia P. and Shimizu, Makoto and Zhang, Yuan and Mangelsdorf, David J. and Kliewer, Steven~A. and Cummins, Carolyn L.},
