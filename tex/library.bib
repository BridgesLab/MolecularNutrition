@article{Miller2013a,
  title = {Calorie {{Restriction Does Not Increase Short-term}} or {{Long-term Protein Synthesis}}.},
  author = {Miller, Benjamin F. and Robinson, Matthew M and Reuland, Danielle J and Drake, Joshua C and Peelor, Frederick F and Bruss, Matthew D and Hellerstein, Marc K and Hamilton, Karyn L},
  year = {2013},
  month = may,
  journal = {The Journals of Gerontology Series A: Biological Sciences and Medical Sciences},
  volume = {68},
  number = {5},
  eprint = {23105041},
  eprinttype = {pubmed},
  pages = {530--8},
  issn = {1758-535X},
  doi = {10.1093/gerona/gls219},
  urldate = {2013-05-21},
  abstract = {Increased protein synthesis is proposed as a mechanism of life-span extension during caloric restriction (CR). We hypothesized that CR does not increase protein synthesis in all tissues and protein fractions and that any increased protein synthesis with CR would be due to an increased anabolic effect of feeding. We used short- (4 hours) and long-term (6 weeks) methods to measure in vivo protein synthesis in lifelong ad libitum (AL) and CR mice. We did not detect an acute effect of feeding on protein synthesis while liver mitochondrial protein synthesis was lower in CR mice versus AL mice. Mammalian target of rapamycin (mTOR) signaling was repressed in liver and heart from CR mice indicative of energetic stress and suppression of growth. Our main findings were that CR did not increase rates of mixed protein synthesis over the long term or in response to acute feeding, and protein synthesis was maintained despite decreased mTOR signaling.},
  pmid = {23105041},
  keywords = {2012,accepted september 26,aging,decision editor,phd,protein metabolism,rafael de cabo,received july 24,stable isotope}
}

@article{Miller2013b,
  title = {Rapamycin-Mediated Lifespan Increase in Mice Is Dose and Sex Dependent and Metabolically Distinct from Dietary Restriction},
  author = {Miller, Richard A. and Harrison, David E. and Astle, Clinton M. and Fernandez, Elizabeth and Flurkey, Kevin and Han, Melissa and Javors, Martin~A. A. and Li, Xinna and Nadon, Nancy L. and Nelson, James F. and Pletcher, Scott and Salmon, Adam B. and Sharp, Zelton Dave and Van Roekel, Sabrina and Winkleman, Lynn and Strong, Randy},
  year = {2014},
  month = jun,
  journal = {Aging Cell},
  volume = {13},
  number = {3},
  pages = {468--477},
  issn = {14749726},
  doi = {10.1111/acel.12194},
  urldate = {2014-09-07},
  abstract = {Rapamycin, an inhibitor of mTOR kinase, increased median lifespan of genetically heterogeneous mice by 23\% (males) to 26\% (females) when tested at a dose threefold higher than that used in our previous studies; maximal longevity was also increased in both sexes. Rapamycin increased lifespan more in females than in males at each dose evaluated, perhaps reflecting sexual dimorphism in blood levels of this drug. Some of the endocrine and metabolic changes seen in diet-restricted mice are not seen in mice exposed to rapamycin, and the pattern of expression of hepatic genes involved in xenobiotic metabolism is also quite distinct in rapamycin-treated and diet-restricted mice, suggesting that these two interventions for extending mouse lifespan differ in many respects.},
  isbn = {1474-9726},
  pmid = {24341993},
  keywords = {accepted for publication and,aging,Aging,but has not been,caloric restriction,Caloric restriction,glucose,Glucose,igf-1,IGF-1,insulin,Insulin,longevity,Longevity,metabolism,mouse,Mouse,mtor,MTOR,rapamycin,Rapamycin,this article has been,undergone full peer review,xenobiotic,Xenobiotic metabolism}
}

@article{Miller2013c,
  title = {Blunted Cortisol Response to Stress Is Associated with Higher Body Mass Index in Low-Income Preschool-Aged Children},
  author = {Miller, Alison L. and Clifford, Caitlin and Sturza, Julie and Rosenblum, Katherine and Vazquez, Delia M. and Kaciroti, Niko and Lumeng, Julie C.},
  year = {2013},
  journal = {Psychoneuroendocrinology},
  volume = {38},
  number = {11},
  pages = {2611--2617},
  publisher = {Elsevier Ltd},
  issn = {03064530},
  doi = {10.1016/j.psyneuen.2013.06.014},
  abstract = {No known studies have tested the hypothesis that a blunted pattern of cortisol reactivity to stress, which is often found following exposure to chronic life stressors, is associated with a higher body mass index (BMI) in very young children. Low-income children (n= 218, mean age 56.6 (range: 38.1-78.5; SD 7.0) months, 49.1\% male, 56.4\% white, 16.1\% black, 11.5\% Hispanic/Latino) participated in a series of behavioral tasks designed to elicit stress. Cortisol was sampled in saliva 5 times during the protocol, and area under the curve (AUC), representing total cortisol output during stress elicitation, was calculated. Children were weighed and height measured and body mass index (BMI) z-score was calculated. Linear regression was used to evaluate the association between cortisol AUC and BMI z-score, controlling for child age, sex, and race/ethnicity (non-Hispanic white vs. not); primary caregiver weight status (overweight, defined as BMI ??? 25 vs. not); and family income-to-needs ratio. Mean child BMI z-score was 0.88 (SD = 1.03). Mean cortisol AUC was 6.11. ??g/dL/min (SD = 10.44). In the fully adjusted model, for each 1-standard deviation unit decrease in cortisol AUC, the child's BMI z-score increased by 0.17 (SE 0.07) standard deviation units (p {$<$} 0.02). A blunted cortisol response to stress, as is often seen following chronic stress exposure, is associated with increased BMI z-score in very young children. Further work is needed to understand how associations between stress, cortisol, and elevated body mass index may develop very early in the lifespan. ?? 2013 Elsevier Ltd.},
  arxiv = {NIHMS150003},
  isbn = {1873-3360 (Electronic){\textbackslash}r0306-4530 (Linking)},
  pmid = {23849598},
  keywords = {BMI,Child,clinical studies,cortisol,Cortisol,cortisol reactivity,Low-income,Obesity,Stress}
}

