  doi = {10.1038/ncb2374},
  urldate = {2011-12-25},
  abstract = {Sorting nexins are a large family of evolutionarily conserved phosphoinositide-binding proteins that have fundamental roles in orchestrating cargo sorting through the membranous maze that is the endosomal network. One ancient group of complexes that contain sorting nexins is the retromer. Here we discuss how retromer complexes regulate endosomal sorting, and describe how this is generating exciting new insight into the central role played by endosomal sorting in development and homeostasis of normal tissues.},
