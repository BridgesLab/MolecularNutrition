  author = {Nakayama, Shuichi and Nishiyama, Mitsuru and Iwasaki, Yasumasa and Shinahara, Masayuki and Okada, Yasushi and Tsuda, Masayuki and Okazaki, Mizuho and Tsugita, Makoto and Taguchi, Takafumi and Makino, Shinya and {Stenzel-Poore}, Mary P and Hashimoto, Kozo and Terada, Yoshio},
