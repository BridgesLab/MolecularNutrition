@book{Yu2019a,
  title = {Aging: {{Mechanisms}}, Signaling and Dietary Intervention},
  author = {Yu, Deyang and Fontana, Luigi and Lamming, Dudley W.},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  publisher = {Elsevier Inc.},
  doi = {10.1016/B978-0-12-804572-5.00054-9},
  abstract = {Aging is an intrinsic, progressive decline in function that is one of the greatest risk factors for many diseases, including cardiovascular disease, cancer, diabetes, and neurodegenerative diseases such as Alzheimer disease and Parkinson disease. Calorie restriction (CR), a dietary intervention that robustly extends the life span of many species, delays or prevents age-associated diseases in mammals ranging from mice to nonhuman primates. Understanding the physiological, molecular, and genetic basis for the effects of CR may permit the development of effective therapeutic interventions to combat the increased prevalence and frequency of age-associated diseases expected as a result of the ``silver tsunami.'' Here, we discuss the molecular mechanisms that may underlie the effects of a CR diet, discuss the recent development of less onerous dietary regimens that mimic some of the beneficial effects of CR, and discuss how the response to a CR diet is influenced by genetic background.},
  isbn = {978-0-12-804572-5},
  keywords = {Calorie restriction,Health span,Life span,Longevity,Protein restriction}
}

