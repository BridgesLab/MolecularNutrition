@article{Albert2014a,
  title = {{{mTOR}} Signaling in Cellular and Organismal Energetics.},
  author = {Albert, Verena and Hall, Michael~N.},
  year = {2014},
  month = dec,
  journal = {Current opinion in cell biology},
