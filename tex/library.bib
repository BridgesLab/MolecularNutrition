  keywords = {Animals,Gene Expression Regulation,Gene Expression Regulation: physiology,Humans,Muscle Development,Muscle Development: genetics,Muscle Development: physiology,MyoD Protein,MyoD Protein: metabolism,MyoD Protein: physiology,Transcription Genetic,Transcription Genetic: physiology}
