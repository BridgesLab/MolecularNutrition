@article{Bland2010,
  title = {{{AMPK}} Supports Growth in {{Drosophila}} by Regulating Muscle Activity and Nutrient Uptake in the Gut},
  author = {Bland, Michelle L. and Lee, Robert J. and Magallanes, Julie M. and Foskett, J. Kevin and Birnbaum, Morris J.},
  year = {2010},
  journal = {Developmental Biology},
  volume = {344},
  number = {1},
  pages = {293--303},
  publisher = {Elsevier Inc.},
  issn = {00121606},
  doi = {10.1016/j.ydbio.2010.05.010},
  abstract = {The larval phase of the Drosophila life cycle is characterized by constant food intake, resulting in a two hundred-fold increase in mass over four days. Here we show that the conserved energy sensor AMPK is essential for nutrient intake in Drosophila. Mutants lacking dAMPK?? are small, with low triglyceride levels, small fat body cells and early pupal lethality. Using mosaic analysis, we find that dAMPK?? functions as a nonautonomous regulator of cell growth. Nutrient absorption is impaired in dAMPK?? mutants, and this defect stems not from altered gut epithelial cell polarity but from impaired peristaltic activity. Expression of a wild-type dAMPK?? transgene or an activated version of the AMPK target myosin regulatory light chain (MRLC) in the dAMPK?? mutant visceral musculature restores gut function and growth. These data suggest strongly that AMPK regulates visceral smooth muscle function through phosphorylation of MRLC. Furthermore, our data show that in Drosophila, AMPK performs an essential cell-nonautonomous function, serving the needs of the organism by promoting activity of the visceral musculature and, consequently, nutrient intake. ?? 2010 Elsevier Inc.},
  isbn = {1095-564X (Electronic){\textbackslash}n0012-1606 (Linking)},
  pmid = {20478298},
  keywords = {AMPK,Drosophila,Growth,Gut,Muscle}
}

@article{Blandino-Rosano2012,
  title = {{{mTORC1}} Signaling and Regulation of Pancreatic {$\beta$}-Cell Mass.},
  author = {{Blandino-Rosano}, Manuel and Chen, Angela Y and Scheys, Joshua O and Alejandro, Emilyn U and Gould, Aaron P and Taranukha, Tatyana and Elghazi, Lynda and {Cras-M{\'e}neur}, Corentin and {Bernal-Mizrachi}, Ernesto},
  year = {2012},
  month = may,
  journal = {Cell Cycle},
  volume = {11},
  number = {10},
  pages = {1892--902},
  issn = {1551-4005},
  doi = {10.4161/cc.20036},
  urldate = {2012-09-17},
  abstract = {The capacity of {$\beta$} cells to expand in response to insulin resistance is a critical factor in the development of type 2 diabetes. Proliferation of {$\beta$} cells is a major component for these adaptive responses in animal models. The extracellular signals responsible for {$\beta$}-cell expansion include growth factors, such as insulin, and nutrients, such as glucose and amino acids. AKT activation is one of the important components linking growth signals to the regulation of {$\beta$}-cell expansion. Downstream of AKT, tuberous sclerosis complex 1 and 2 (TSC1/2) and mechanistic target of rapamycin complex 1 (mTORC1) signaling have emerged as prime candidates in this process, because they integrate signals from growth factors and nutrients. Recent studies demonstrate the importance of mTORC1 signaling in {$\beta$} cells. This review will discuss recent advances in the understanding of how this pathway regulates {$\beta$}-cell mass and present data on the role of TSC1 in modulation of {$\beta$}-cell mass. Herein, we also demonstrate that deletion of Tsc1 in pancreatic {$\beta$} cells results in improved glucose tolerance, hyperinsulinemia and expansion of {$\beta$}-cell mass that persists with aging.},
  pmid = {22544327},
  keywords = {-cell signaling,akt,beta cells,cell,cells,cycle,glucose homeostasis,insulin,insulin secretion,islets,mtorc1,mTORC1,review,s6k,tsc1,tsc2}
}

@article{Blasco2021,
  title = {An Extended Reconstruction of Human Gut Microbiota Metabolism of Dietary Compounds},
  author = {Blasco, Telmo and {P{\'e}rez-Burillo}, Sergio and Balzerani, Francesco and {Hinojosa-Nogueira}, Daniel and {Lerma-Aguilera}, Alberto and Pastoriza, Silvia and Cendoya, Xabier and Rubio, {\'A}ngel and Gosalbes, Mar{\'i}a Jos{\'e} and {Jim{\'e}nez-Hern{\'a}ndez}, Nuria and Pilar Francino, M. and Apaolaza, I{\~n}igo and {Rufi{\'a}n-Henares}, Jos{\'e} {\'A}ngel and Planes, Francisco J.},
  year = {2021},
  journal = {Nature Communications},
  volume = {12},
  number = {1},
  pages = {1--12},
  issn = {20411723},
  doi = {10.1038/s41467-021-25056-x},
  abstract = {Understanding how diet and gut microbiota interact in the context of human health is a key question in personalized nutrition. Genome-scale metabolic networks and constraint-based modeling approaches are promising to systematically address this complex problem. However, when applied to nutritional questions, a major issue in existing reconstructions is the limited information about compounds in the diet that are metabolized by the gut microbiota. Here, we present AGREDA, an extended reconstruction of diet metabolism in the human gut microbiota. AGREDA adds the degradation pathways of 209 compounds present in the human diet, mainly phenolic compounds, a family of metabolites highly relevant for human health and nutrition. We show that AGREDA outperforms existing reconstructions in predicting diet-specific output metabolites from the gut microbiota. Using 16S rRNA gene sequencing data of faecal samples from Spanish children representing different clinical conditions, we illustrate the potential of AGREDA to establish relevant metabolic interactions between diet and gut microbiota.},
  pmid = {34354065}
}

