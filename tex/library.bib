@article{Macedo2016,
  title = {Time-Course Changes of Catabolic Proteins Following Muscle Atrophy Induced by Dexamethasone},
  author = {Macedo, Anderson G. and Krug, Andr{\'e} Luis O. and Souza, Lidiane M. and Martuscelli, Aline M. and Constantino, Paula B. and Zago, Anderson S. and Rush, James W.E. and Santos, Carlos F. and Amaral, Sandra L.},
  year = {2016},
  journal = {Steroids},
  volume = {107},
  pages = {30--36},
  issn = {18785867},
  doi = {10.1016/j.steroids.2015.12.016},
  abstract = {This study was designed to describe the time-course changes of catabolic proteins following muscle atrophy induced by 10 days of dexamethasone (DEX). Rats underwent DEX treatment for 1, 3, 5, 7 and 10 days. Body weight (BW) and lean mass were obtained using a dual energy X-ray absorptiometry (DEXA) scan. Muscle ringer finger1 (MuRF-1), atrogin-1 and myostatin protein levels were analyzed in the tibialis anterior (TA), flexor hallucis longus (FHL) and soleus muscles. DEX treatment reduced lean mass since day-3 and reduced BW since day-5. Specific muscle weight reductions were observed after day-10 in TA (-23\%) and after day-5 in FHL (-16\%, -17\% and -29\%, for days 5, 7 and 10, respectively). In TA, myostatin protein level was 36\% higher on day-5 and its values were normalized in comparison with controls on day-10. MuRF-1 protein level was increased in TA muscle from day-7 and in FHL muscle only on day-10. This study suggests that DEX-induced muscle atrophy is a dynamic process which involves important signaling factors over time. As demonstrated by DEXA scan, lean mass declines earlier than BW and this response may involve other catabolic proteins than myostatin and MuRF-1. Specifically for TA and FHL, it seems that myostatin may trigger the catabolic process, and MuRF-1 may contribute to maintain muscle atrophy. This information may support any intervention in order to attenuate the muscle atrophy during long period of treatment.},
  pmid = {26730720},
  keywords = {Flexor hallucis longus muscle,Glucocorticoids,MuRF-1,Skeletal muscle}
}

@article{Macfarlane1992,
  title = {Estimation of Short-chain Fatty Acid Production from Protein by Human Intestinal Bacteria Based on Branched-chain Fatty Acid Measurements},
  author = {Macfarlane, G. T. and Gibson, G. R. and Beatty, E. and Cummings, J. H.},
  year = {1992},
  journal = {FEMS Microbiology Letters},
  volume = {101},
  number = {2},
  pages = {81--88},
  issn = {15746968},
  doi = {10.1111/j.1574-6968.1992.tb05764.x},
  abstract = {The importance of protein breakdown and amino acid fermentation in the overall economy of the large intestine has not been quantitated. We have therefore measured the production of branched chain-fatty acids (BCFA) both in vitro and in vivo in order to estimate the contribution of protein to fermentation. In vitro batch-culture studies using human faecal inocula showed that short-chain fatty acids (SCFA) were the principal end products formed during the degradation of protein by human colonic bacteria. Approximately 30\% of the protein broken down was converted to SCFA. Branched-chain fatty acids (BCFA) constituted 16\% of the SCFA produced from bovine serum albumin and 21\% of the SCFA generated when casein was the substrate. BCFA concentrations in gut contents taken from the human proximal and distal colons were on average, 4.6 and 6.3 mmol kg-1 respectively, corresponding to 3.4\% and 7.5\% of the total SCFA. These results suggest that protein fermentation could potentially account for about 17\% of the SCFA found in the caecum, and 38\% of the SCFA produced in the sigmoid/rectum. Measurements of BCFA in portal and arterial blood taken from individuals undergoing emergency surgery indicated that net production of BCFA by the gut microflora was in the region of 11.1 mmol day-1, which would require the breakdown of about 12 g of protein. These data highlight the role of protein in the colon and may explain why many colonic diseases affect mainly the distal bowel. {\copyright} 1992.},
  keywords = {Branched-chain fatty acids,Fermentation,Protein breakdown,Short-chain fatty acids}
}

@article{Macfarlane2008b,
  title = {Glucocorticoids and Fatty Acid Metabolism in Humans: {{Fuelling}} Fat Redistribution in the Metabolic Syndrome},
  author = {Macfarlane, David P. and Forbes, Shareen and Walker, Brian R.},
  year = {2008},
  journal = {Journal of Endocrinology},
  volume = {197},
  number = {2},
  pages = {189--204},
  issn = {00220795},
  doi = {10.1677/JOE-08-0054},
  abstract = {Glucocorticoid hormones constitute an integral component of the response to stress, and many of the manifestations of glucocorticoid excess (Cushing's syndrome) are predictable on the basis of their acute effects to raise blood pressure, induce insulin resistance, increase protein catabolism and elevate plasma glucose. However, it appears to be a paradox that the acute lipolytic effect of glucocorticoids is not manifest in long-term weight loss in humans. The effects of glucocorticoids on glucose metabolism are well characterised, involving impaired peripheral glucose uptake and hepatic insulin resistance, and there is mounting evidence that subtle abnormalities in glucocorticoid concentrations in the plasma and/or in tissue sensitivity to glucocorticoids are important in metabolic syndrome. The effects of glucocorticoids on fatty acid metabolism are less well understood than their influence on glucose metabolism. In this article, we review the literature describing the effects of glucocorticoids on fatty acid metabolism, with particular reference to in vivo human studies. We consider the implications for contrasting acute versus chronic effects of glucocorticoids on fat accumulation, effects in different adipose depots and the potential role of glucocorticoid signalling in the pathogenesis and therapy of metabolic syndrome.},
  isbn = {1479-6805 (Electronic){\textbackslash}r0022-0795 (Linking)},
  pmid = {18434349}
}

@article{Macfarlane2014,
  title = {Effects of Acute Glucocorticoid Blockade on Metabolic Dysfunction in Patients with {{Type}} 2 Diabetes with and without Fatty Liver.},
  author = {Macfarlane, D P and Raubenheimer, P J and Preston, T and Gray, C D and Bastin, M E and Marshall, I and Iredale, J P and Andrew, R and Walker, B R},
  year = {2014},
  journal = {American journal of physiology. Gastrointestinal and liver physiology},
  volume = {307},
  number = {7},
  pages = {G760-8},
  issn = {1522-1547},
  doi = {10.1152/ajpgi.00030.2014},
  abstract = {To investigate the potential of therapies which reduce glucocorticoid action in patients with Type 2 diabetes we performed a randomized, double-blinded, placebo-controlled crossover study of acute glucocorticoid blockade, using the glucocorticoid receptor antagonist RU38486 (mifepristone) and cortisol biosynthesis inhibitor (metyrapone), in 14 men with Type 2 diabetes. Stable isotope dilution methodologies were used to measure the rates of appearance of glucose, glycerol, and free fatty acids (FFAs), including during a low-dose (10 mU{$\cdot$}m{$^{-2}$} {$\cdot$}min{$^{-1}$}) hyperinsulinemic clamp, and subgroup analysis was conducted in patients with high or low liver fat content measured by magnetic resonance spectroscopy (n = 7/group). Glucocorticoid blockade lowered fasting glucose and insulin levels and improved insulin sensitivity of FFA and glycerol turnover and hepatic glucose production. Among this population with Type 2 diabetes high liver fat was associated with hyperinsulinemia, higher fasting glucose levels, peripheral and hepatic insulin resistance, and impaired suppression of FFA oxidation and FFA and glycerol turnover during hyperinsulinemia. Glucocorticoid blockade had similar effects in those with and without high liver fat. Longer term treatments targeting glucocorticoid action may be useful in Type 2 diabetes with and without fatty liver.},
  pmid = {25104497},
  keywords = {Blood Glucose,Blood Glucose: drug effects,Blood Glucose: metabolism,Cross-Over Studies,Diabetes Mellitus Type 2,Diabetes Mellitus Type 2: blood,Diabetes Mellitus Type 2: diagnosis,Diabetes Mellitus Type 2: drug therapy,Double-Blind Method,Energy Metabolism,Energy Metabolism: drug effects,Enzyme Inhibitors,Enzyme Inhibitors: therapeutic use,Fatty Acids Nonesterified,Fatty Acids Nonesterified: blood,Glycerol,Glycerol: blood,Hormone Antagonists,Hormone Antagonists: therapeutic use,Humans,Hydrocortisone,Hydrocortisone: metabolism,Indicator Dilution Techniques,Insulin,Insulin: blood,Liver,Liver: drug effects,Liver: metabolism,Magnetic Resonance Spectroscopy,Male,Metyrapone,Metyrapone: therapeutic use,Middle Aged,Mifepristone,Mifepristone: therapeutic use,Non-alcoholic Fatty Liver Disease,Non-alcoholic Fatty Liver Disease: blood,Non-alcoholic Fatty Liver Disease: diagnosis,Non-alcoholic Fatty Liver Disease: drug therapy,Receptors Glucocorticoid,Receptors Glucocorticoid: antagonists & inhibitor,Receptors Glucocorticoid: metabolism,Scotland,Steroid 11-beta-Hydroxylase,Steroid 11-beta-Hydroxylase: antagonists & inhibit,Steroid 11-beta-Hydroxylase: metabolism,Time Factors,Treatment Outcome}
}

@article{MacGurn2011a,
  title = {{{TORC1 Regulates Endocytosis}} via {{Npr1-Mediated Phosphoinhibition}} of a {{Ubiquitin Ligase Adaptor}}},
  author = {MacGurn, Jason~A. and Hsu, Pi-Chiang and Smolka, Marcus~B. and Emr, Scott~D.},
  year = {2011},
  month = nov,
  journal = {Cell},
  volume = {147},
  number = {5},
