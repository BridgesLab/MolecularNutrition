  author = {Bungard, David and Fuerth, Benjamin J and Zeng, Ping Y and Faubert, Brandon and Maas, Nancy L and Viollet, Beno{\^i}t and Carling, David and Thompson, Craig B and Jones, Russell G and Berger, Shelley~L.},
  year = {2010},
