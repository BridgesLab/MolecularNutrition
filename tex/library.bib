@article{Walewski2014a,
  title = {Spexin Is a Novel Human Peptide That Reduces Adipocyte Uptake of Long Chain Fatty Acids and Causes Weight Loss in Rodents with Diet-Induced Obesity},
  author = {Walewski, Jos{\'e} L. and Ge, Fengxia and Lobdell IV, Harrison and Levin, Nancy and Schwartz, Gary J. and Vasselli, Joseph R. and Pomp, Afons and Dakin, Gregory and Berk, Paul D.},
  year = {2014},
  journal = {Obesity},
  volume = {22},
  number = {7},
  pages = {1643--1652},
  issn = {1930739X},
  doi = {10.1002/oby.20725},
  abstract = {OBJECTIVE: Microarray studies identified Ch12:orf39 (Spexin) as the most down-regulated gene in obese human fat. Therefore, we examined its role in obesity pathogenesis.{\textbackslash}n{\textbackslash}nMETHODS: Spexin effects on food intake, meal patterns, body weight, respiratory exchange ratio (RER), and locomotor activity were monitored electronically in C57BL/6J mice or Wistar rats with diet-induced obesity (DIO). Its effects on adipocyte [(3)H]-oleate uptake were determined.{\textbackslash}n{\textbackslash}nRESULTS: In humans, Spexin gene expression was down-regulated 14.9-fold in obese omental and subcutaneous fat. Circulating Spexin changed in parallel, correlating (r\,=\,-0.797) with Leptin. In rats, Spexin (35 {\textmu}g/kg/day SC) reduced caloric intake {$\sim$}32\% with corresponding weight loss. Meal patterns were unaffected. In mice, Spexin (25 {\textmu}g/kg/day IP) significantly reduced the RER at night, and increased locomotion. Spexin incubation in vitro significantly inhibited facilitated fatty acid (FA) uptake into DIO mouse adipocytes. Conditioned taste aversion testing (70 {\textmu}g/kg/day IP) demonstrated no aversive Spexin effects.{\textbackslash}n{\textbackslash}nCONCLUSIONS: Spexin gene expression is markedly down-regulated in obese human fat. The peptide produces weight loss in DIO rodents. Its effects on appetite and energy regulation are presumably central; those on adipocyte FA uptake appear direct and peripheral. Spexin is a novel hormone involved in weight regulation, with potential for obesity therapy.},
  isbn = {1930-7381},
  pmid = {24550067}
}

