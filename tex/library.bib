  title = {On the Interpretation of Transcriptome-Wide Association Studies},
  author = {{de Leeuw}, Christiaan and Werme, Josefin and Savage, Jeanne E. and Peyrot, Wouter J. and Posthuma, Danielle},
  year = {2023},
