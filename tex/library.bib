@article{Franceschelli2014,
  title = {Sex Differences in the Chronic Mild Stress Model of Depression},
  author = {Franceschelli, Anthony and Herchick, Samantha and Thelen, Connor and {Papadopoulou-Daifoti}, Zeta and Pitychoutis, Pothitos M.},
  year = {2014},
  journal = {Behavioural Pharmacology},
  volume = {25},
  number = {5-6},
  pages = {372--383},
  issn = {14735849},
  doi = {10.1097/FBP.0000000000000062},
  abstract = {A large volume of clinical and experimental evidence documents sex differences in brain anatomy, chemistry, and function, as well as in stress and drug responses. The chronic mild stress model (CMS) is one of the most extensively investigated animal models of chronic stress. However, only a limited number of studies have been conducted in female rodents despite the markedly higher prevalence of major depression among women. Herein, we review CMS studies conducted in rats and mice of both sexes and further discuss intriguing sex-dependent behavioral and neurobiological findings. The PubMed literature search engine was used to find and collect all relevant articles analyzed in this review. Specifically, a multitermed search was performed with 'chronic mild stress', 'chronic unpredictable stress' and 'chronic variable stress' as base terms and 'sex', 'gender', 'females' and 'depression' as secondary terms in various combinations. Male and female rodents appear to be differentially affected by CMS application, depending on the behavioral, physiological, and neurobiological indices that are being measured. Importantly, the CMS paradigm, despite its limitations, has been successfully used to assess a constellation of interdisciplinary research questions in the sex differences field and has served as a 'silver bullet' in assessing the role of sex in the neurobiology of major depression. {\copyright} 2014 Wolters Kluwer Health Lippincott Williams \& Wilkins.},
  isbn = {0000000000000},
  pmid = {25025701},
  keywords = {anhedonia,chronic mild stress,female,forced swim test,major depression,mouse,rat,serotonin,sex differences,unpredictable}
}

@article{francoisAcuteEffectsDietary1998,
  title = {Acute Effects of Dietary Fatty Acids on the Fatty Acids of Human Milk},
  author = {Francois, C. A. and Connor, S. L. and Wander, R. C. and Connor, W. E.},
  year = {1998},
  month = feb,
  journal = {The American Journal of Clinical Nutrition},
  volume = {67},
  number = {2},
  pages = {301--308},
  issn = {0002-9165},
  doi = {10.1093/ajcn/67.2.301},
  abstract = {Although it is known that the fatty acid profile of human milk is altered by diet, the rapidity with which this occurs has not been addressed. We hypothesized that after absorption the fatty acids of a given meal would be transferred rapidly from the chylomicrons of the blood into human milk. Fourteen lactating women drank six test formulas, each containing a different fat: menhaden oil, herring oil, safflower oil, canola oil, coconut oil, or cocoa butter. The subjects collected a midfeeding milk sample before consuming the breakfast test formula and additional samples at 6, 10, 14, and 24 h and then once daily for 4-7 d. Fatty acids of special interest included eicosapentaenoic and docosahexaenoic acids from menhaden oil, cetoleic acid from herring oil, linoleic acid from safflower oil, linolenic acid from canola oil, lauric acid from coconut oil, and palmitic and stearic acids from cocoa butter. Each of these fatty acids increased significantly in human milk within 6 h of consumption of the test formulas (P {$<$} 0.001). Maximum increases occurred 10 h after safflower oil; 14 h after cocoa utter, coconut oil, canola oil, and menhaden oil (eicosapentaenoic acid); and 24 h after herring oil and menhaden oil (docosahexaenoic acid). All of these fatty acids remained significantly elevated in milk (P {$<$} 0.05) for 10-24 h, except for docosahexaenoic acid, which remained significantly elevated for 2 d, and eicosapentaenoic acid, which remained elevated for 3 d. These data support the hypothesis that there is a rapid transfer of dietary fatty acids from chylomicrons into human milk.},
  langid = {english},
  pmid = {9459379},
  keywords = {Adult,Dietary Fats,Fatty Acids,Female,Humans,Lactation,Milk Human,Time Factors},
  file = {/Users/davebrid/Zotero/storage/4YW5EVK6/S0002916523181974.html}
}

@article{Franke1995,
  title = {The Protein Kinase Encoded by the {{Akt}} Proto-Oncogene Is a Target of the {{PDGF-activated}} Phosphatidylinositol 3-Kinase.},
  author = {Franke, T F and Yang, S I and Chan, T O and Datta, K and Kazlauskas, a and Morrison, D K and Kaplan, D R and Tsichlis, P N},
  year = {1995},
  month = jun,
  journal = {Cell},
  volume = {81},
  number = {5},
  eprint = {7774014},
  eprinttype = {pubmed},
  pages = {727--36},
  issn = {0092-8674},
  abstract = {The serine/threonine protein kinase encoded by the Akt proto-oncogene is catalytically inactive in serum-starved primary and immortalized fibroblasts. Here we show that Akt and the Akt-related kinase AKT2 are activated by PDGF. The activation was rapid and specific, and it was abrogated by mutations in the Akt Pleckstrin homology (PH) domain. The Akt activation was also shown to depend on PDGFR beta tyrosines Y740 and Y751, which bind phosphatidylinositol 3-kinase (PI 3-kinase) upon phosphorylation. Moreover, Akt activation was blocked by the PI 3-kinase-specific inhibitor wortmannin and the dominant inhibitory N17Ras. Conversely, Akt activity was induced following the addition of phosphatidylinositol-3-phosphate to Akt immunoprecipitates from serum-starved cells in vitro. These results identify Akt as a novel target of PI 3-kinase and suggest that the Akt PH domain may be a mediator of PI 3-kinase signaling.},
  pmid = {7774014},
  keywords = {5-Diphosphate,akt,Amino Acid,Androstadienes,Androstadienes: pharmacology,Animals,Biological,Cells,Cultured,Enzyme Activation,Enzyme Activation: drug effects,Enzyme Induction,Enzyme Inhibitors,Enzyme Inhibitors: pharmacology,Enzymologic,Gene Expression Regulation,Mice,Models,Oncogene Proteins,Oncogene Proteins: drug effects,Oncogene Proteins: metabolism,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 4,Phosphatidylinositol Phosphates,Phosphatidylinositol Phosphates: pharmacology,Phosphotransferases (Alcohol Group Acceptor),Phosphotransferases (Alcohol Group Acceptor): meta,Platelet-Derived Growth Factor,Platelet-Derived Growth Factor: metabol,Platelet-Derived Growth Factor: pharmacology,Protein-Serine-Threonine Kinases,Protein-Serine-Threonine Kinases: drug effects,Protein-Serine-Threonine Kinases: metabolism,Proto-Oncogene Proteins,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins: drug effects,Proto-Oncogene Proteins: metabolism,Proto-Oncogenes,ras Proteins,ras Proteins: metabolism,Rats,Receptors,Sequence Homology,Signal Transduction}
}

@article{Frankel2011,
  title = {{{microRNA-101}} Is a Potent Inhibitor of Autophagy.},
  author = {Frankel, Lisa B and Wen, Jiayu and Lees, Michael and {H{\o}yer-Hansen}, Maria and Farkas, Thomas and Krogh, Anders and J{\"a}{\"a}ttel{\"a}, Marja and Lund, Anders H.},
  year = {2011},
  month = sep,
  journal = {The EMBO journal},
  volume = {2},
  eprint = {21915098},
  eprinttype = {pubmed},
  pages = {1--14},
  issn = {1460-2075},
  doi = {10.1038/emboj.2011.331},
  urldate = {2011-09-15},
  abstract = {Autophagy is an evolutionarily conserved mechanism of cellular self-digestion in which proteins and organelles are degraded through delivery to lysosomes. Defects in this process are implicated in numerous human diseases including cancer. To further elucidate regulatory mechanisms of autophagy, we performed a functional screen in search of microRNAs (miRNAs), which regulate the autophagic flux in breast cancer cells. In this study, we identified the tumour suppressive miRNA, miR-101, as a potent inhibitor of basal, etoposide- and rapamycin-induced autophagy. Through transcriptome profiling, we identified three novel miR-101 targets, STMN1, RAB5A and ATG4D. siRNA-mediated depletion of these genes phenocopied the effect of miR-101 overexpression, demonstrating their importance in autophagy regulation. Importantly, overexpression of STMN1 could partially rescue cells from miR-101-mediated inhibition of autophagy, indicating a functional importance for this target. Finally, we show that miR-101-mediated inhibition of autophagy can sensitize breast cancer cells to 4-hydroxytamoxifen (4-OHT)-mediated cell death. Collectively, these data establish a novel link between two highly important and rapidly growing research fields and present a new role for miR-101 as a key regulator of autophagy.},
  pmid = {21915098},
  keywords = {autophagy,breast cancer,microrna}
}

