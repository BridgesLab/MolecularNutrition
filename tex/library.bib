@article{Ryder2007,
  title = {The {{DrosDel}} Deletion Collection: A {{Drosophila}} Genomewide Chromosomal Deficiency Resource.},
  author = {Ryder, Edward and Ashburner, Michael and {Bautista-Llacer}, Rosa and Drummond, Jenny and Webster, Jane and Johnson, Glynnis and Morley, Terri and Chan, Yuk Sang and Blows, Fiona and Coulson, Darin and Reuter, Gunter and Baisch, Heiko and Apelt, Christian and Kauk, Andreas and Rudolph, Thomas and Kube, Maria and Klimm, Melanie and Nickel, Claudia and Szidonya, Janos and Mar{\'o}y, Peter and Pal, Margit and {Rasmuson-Lestander}, Asa and Ekstr{\"o}m, Karin and Stocker, Hugo and Hugentobler, Christoph and Hafen, Ernst and Gubb, David and Pflugfelder, Gert and Dorner, Christian and Mechler, Bernard and Schenkel, Heide and Marhold, Joachim and Serras, Florenci and Corominas, Montserrat and Punset, Adri{\`a} and Roote, John and Russell, Steven},
  year = {2007},
  month = sep,
  journal = {Genetics},
  volume = {177},
  number = {1},
  pages = {615--29},
  issn = {0016-6731},
  doi = {10.1534/genetics.107.076216},
  urldate = {2013-07-03},
  abstract = {We describe a second-generation deficiency kit for Drosophila melanogaster composed of molecularly mapped deletions on an isogenic background, covering approximately 77\% of the Release 5.1 genome. Using a previously reported collection of FRT-bearing P-element insertions, we have generated 655 new deletions and verified a set of 209 deletion-bearing fly stocks. In addition to deletions, we demonstrate how the P elements may also be used to generate a set of custom inversions and duplications, particularly useful for balancing difficult regions of the genome carrying haplo-insufficient loci. We describe a simple computational resource that facilitates selection of appropriate elements for generating custom deletions. Finally, we provide a computational resource that facilitates selection of other mapped FRT-bearing elements that, when combined with the DrosDel collection, can theoretically generate over half a million precisely mapped deletions.},
  pmid = {17720900},
  keywords = {Animals,Chromosome Aberrations,DNA Transposable Elements,Drosophila melanogaster,Drosophila melanogaster: genetics,Genome,Molecular Sequence Data,Sequence Deletion}
}

