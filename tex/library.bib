  keywords = {Animals,chromatin,Chromatin,Chromatin Assembly and Disassembly,Chromatin Assembly and Disassembly: genetics,Chromatin: genetics,Chromatin: metabolism,Gene Expression Regulation,Genetic,Genetic: genetics,Humans,Models,Nucleosomes,Nucleosomes: genetics,Nucleosomes: metabolism,Protein Binding,review,Transcription,transcription factors,Transcription Factors,Transcription Factors: metabolism}
