@article{Mukhopadhyay2008,
  title = {Chromatin Immunoprecipitation ({{ChIP}}) Coupled to Detection by Quantitative Real-Time {{PCR}} to Study Transcription Factor Binding to {{DNA}} in {{Caenorhabditis}} Elegans.},
  author = {Mukhopadhyay, Arnab and Deplancke, B and Walhout, AlM and Tissenbaum, {\relax HA}},
  year = {2008},
  journal = {Nature protocols},
  volume = {3},
  number = {4},
  pages = {698--709},
  issn = {1750-2799},
  doi = {10.1038/nprot.2008.38},
  abstract = {In order to determine how signaling pathways differentially regulate gene expression, it is necessary to identify the interactions between transcription factors (TFs) and their cognate cis-regulatory DNA elements. Here, we have outlined a chromatin immunoprecipitation (ChIP) protocol for use in whole Caenorhabditis elegans extracts. We discuss optimization of the procedure, including growth and harvesting of the worms, formaldehyde fixation, TF immunoprecipitation and analysis of bound sequences through real-time PCR. It takes approximately 10-12 d to obtain the worm culture for ChIP; the ChIP procedure is spaced out over a period of 2.5 d with two overnight incubations.},
  pmid = {18388953},
  keywords = {Animals,Caenorhabditis elegans,Caenorhabditis elegans: metabolism,Chromatin Immunoprecipitation,Chromatin Immunoprecipitation: methods,DNA,DNA: genetics,DNA: metabolism,Gene Expression Regulation,Polymerase Chain Reaction,Polymerase Chain Reaction: methods,Protein Binding,Transcription Factors,Transcription Factors: metabolism}
}

