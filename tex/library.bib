@article{Morris2015a,
  title = {{{MIND}} Diet Associated with Reduced Incidence of {{Alzheimer}}'s Disease},
  author = {Morris, Martha Clare and Tangney, Christy C. and Wang, Yamin and Sacks, Frank M. and Bennett, David A. and Aggarwal, Neelum T.},
  year = {2015},
