@article{Sekhar2020,
  title = {{{COX-2}} Promotes Mammary Adipose Tissue Inflammation, Local Estrogen Biosynthesis, and Carcinogenesis in High-Sugar/Fat Diet Treated Mice},
  author = {Gon{\c c}alves, Ros{\^a}ngela Mayer and Delgobo, Marina and Agnes, Jonathan Paulo and {das Neves}, Raquel Nascimento and Falchetti, Marcelo and Casagrande, Tuany and Garcia, Ana Paula Vargas and Vieira, Thaynan Cunha and Somensi, Nauana and Bruxel, Maciel Alencar and Mendes, Daniel Augusto Gasparin Bueno and Rafacho, Alex and B{\'a}fica, Andr{\'e} and Gelain, Daniel Pens and Moreira, Jos{\'e} Cl{\'a}udio Fonseca and Cassali, Geovanni Dantas and Bishop, Alexander James Roy and {Zanotto-Filho}, Alfeu},
