@article{Mansego2019,
  title = {Epigenetic Analyses Tools for Nutrition Research},
  author = {Mansego, Maria L. and Milagro, Ferm{\'i}n I. and Alfredo Mart{\'i}nez, J.},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {59--67},
  doi = {10.1016/B978-0-12-804572-5.00008-2},
  abstract = {Epigenetics refers to covalent modifications of DNA, RNA and histone proteins and has an essential role in gene expression involved in regulation metabolism through gene-nutrient interactions. This chapter focuses on methods for analyzing the most commonly studied epigenetic mechanism, DNA methylation, from single-base resolution to the global level. Developments in epigenetic technologies are providing encouraging results of DNA methylation levels at the single nucleotide resolution and offer the ability to differentiate between 5-methylcytosine and 5-hydroxymethylcytosine. A number of methods can be employed to quantify DNA methylation, including methylation-specific or -dependent restriction enzyme polymerase chain reaction and genome-wide DNA methylation profiles through microarray analysis or next generation sequencing-based methods. In practice, it is important to conduct a preliminary analysis focused on the type of validation and information provided by each technique to select the best method for each research interest.},
  isbn = {9780128045725},
  keywords = {Dna methylation,Epigenetics,Massarray,Methylation-specific pcr,Microarray,Next-generation sequencing,Pyrosequencing}
}

@article{Mansfeld2015,
  title = {Branched-Chain Amino Acid Catabolism Is a Conserved Regulator of Physiological Ageing},
  author = {Mansfeld, Johannes and Urban, Nadine and Priebe, Steffen and Groth, Marco and Frahm, Christiane and Hartmann, Nils and Gebauer, Juliane and Ravichandran, Meenakshi and Dommaschk, Anne and Schmeisser, Sebastian and Kuhlow, Doreen and Monajembashi, Shamci and {Bremer-Streck}, Sibylle and Hemmerich, Peter and Kiehntopf, Michael and Zamboni, Nicola and Englert, Christoph and Guthke, Reinhard and Kaleta, Christoph and Platzer, Matthias and Suhnel, Jurgen and Witte, Otto W. and Zarse, Kim and Ristow, Michael and S{\"u}hnel, J{\"u}rgen and Witte, Otto W. and Zarse, Kim and Ristow, Michael},
  year = {2015},
  journal = {Nature Communications},
  volume = {6},
  pages = {10043},
  issn = {2041-1723},
  doi = {10.1038/ncomms10043},
  abstract = {Ageing has been defined as a global decline in physiological function depending on both environmental and genetic factors. Here we identify gene transcripts that are similarly regulated during physiological ageing in nematodes, zebrafish and mice. We observe the strongest extension of lifespan when impairing expression of the branched-chain amino acid transferase-1 (bcat-1) gene in C. elegans, which leads to excessive levels of branched-chain amino acids (BCAAs). We further show that BCAAs reduce a LET-363/mTOR-dependent neuro-endocrine signal, which we identify as DAF-7/TGFbeta, and that impacts lifespan depending on its related receptors, DAF-1 and DAF-4, as well as ultimately on DAF-16/FoxO and HSF-1 in a cell-non-autonomous manner. The transcription factor HLH-15 controls and epistatically synergizes with BCAT-1 to modulate physiological ageing. Lastly and consistent with previous findings in rodents, nutritional supplementation of BCAAs extends nematodal lifespan. Taken together, BCAAs act as periphery-derived metabokines that induce a central neuro-endocrine response, culminating in extended healthspan.},
  pmid = {26620638}
}

@article{Mansour1970,
