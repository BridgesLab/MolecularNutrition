@article{Berument1999,
  title = {Autism Screening Questionnaire: Diagnostic Validity.},
  author = {Berument, S K and Rutter, M and Lord, C and Pickles, A and Bailey, A},
  year = {1999},
  month = nov,
  journal = {The British journal of psychiatry : the journal of mental science},
  volume = {175},
  eprint = {10789276},
  eprinttype = {pubmed},
  pages = {444--51},
  issn = {0007-1250},
  urldate = {2014-07-10},
  abstract = {BACKGROUND: Good interview and diagnostic measures for autism and other pervasive developmental disorders (PDDs) are available but there is a lack of a good screening questionnaire. AIMS: To develop and test a screening questionnaire based on items in the best available diagnostic interview--the Autism Diagnostic Interview--Revised (ADI-R). METHOD: A 40-item scale, the Autism Screening Questionnaire (ASQ), was developed and tested on a sample of 160 individuals with PDD and 40 with non-PDD diagnoses. RESULTS: The ASQ has good discriminative validity with respect to the separation of PDD from non-PDD diagnoses at all IQ levels, with a cut-off of 15 proving most effective. The differentiation between autism and other varieties of PDD was weaker. CONCLUSIONS: The ASQ is an effective screening questionnaire for PDD.},
  pmid = {10789276},
  keywords = {Adolescent,Adult,Asperger Syndrome,Asperger Syndrome: diagnosis,Autistic Disorder,Autistic Disorder: diagnosis,Child,Conduct Disorder,Conduct Disorder: diagnosis,Diagnosis,Differential,Fragile X Syndrome,Fragile X Syndrome: diagnosis,Humans,Intellectual Disability,Intellectual Disability: diagnosis,Language Development Disorders,Language Development Disorders: diagnosis,Mass Screening,Mass Screening: methods,Preschool,Questionnaires,Rett Syndrome,Rett Syndrome: diagnosis,Sensitivity and Specificity}
}

