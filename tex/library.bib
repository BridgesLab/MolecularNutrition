@article{Rodgers2014,
  title = {{{mTORC1}} Controls the Adaptive Transition of Quiescent Stem Cells from {{G0}} to {{G}}({{Alert}}).},
  author = {Rodgers, Joseph T and King, Katherine Y and Brett, Jamie O and Cromie, Melinda J and Charville, Gregory W and Maguire, Katie K and Brunson, Christopher and Mastey, Namrata and Liu, Ling and Tsai, Chang-Ru and a Goodell, Margaret and a Rando, Thomas},
  year = {2014},
