@article{Ikenoue2008,
  title = {{{PTEN}} Acetylation Modulates Its Interaction with {{PDZ}} Domain},
  author = {Ikenoue, T and Inoki, Ken and Zhao, B and Guan, Kun-Liang},
  year = {2008},
  journal = {Cancer Res},
  volume = {68},
  number = {17},
  pages = {6908--6912},
  doi = {68/17/6908 [pii] 10.1158/0008-5472.CAN-08-1107},
  abstract = {The PTEN tumor suppressor gene is frequently inactivated in human cancer. As a major tumor suppressor, PTEN function must be tightly regulated. Both phosphorylation and membrane association have been reported to regulate PTEN activity. In addition, the COOH terminus of PTEN has a typical PDZ domain-binding motif that interacts with several PDZ domain-containing proteins. In this report, we show that PTEN is acetylated on Lys(402), which is in the COOH-terminal PDZ domain-binding motif. We show that CBP plays a major role in PTEN acetylation, whereas the SIRT1 deacetylase is mainly responsible for PTEN deacetylation. Interestingly, Lys(402) acetylation modulates PTEN interaction with PDZ domain-containing proteins, indicating a potential role of acetylation in regulating PTEN function.},
  isbn = {1538-7445 (Electronic)},
  keywords = {Acetylation,Animals,Cercopithecus aethiops,COS Cells,Humans,Immunoprecipitation,Mutagenesis,Polymerase Chain Reaction,PTEN Phosphohydrolase/chemistry/genetics/*metaboli,RNA Small Interfering}
}

@article{Ikenoue2008a,
  title = {Essential Function of {{TORC2}} in {{PKC}} and {{Akt}} Turn Motif Phosphorylation, Maturation and Signalling},
  author = {Ikenoue, T and Inoki, Ken and Yang, Q and Zhou, X and Guan, Kun-Liang},
  year = {2008},
  journal = {EMBO J},
  volume = {27},
  number = {14},
  pages = {1919--1931},
  doi = {emboj2008119 [pii] 10.1038/emboj.2008.119},
  abstract = {Protein kinase C (PKC) is involved in a wide array of cellular processes such as cell proliferation, differentiation and apoptosis. Phosphorylation of both turn motif (TM) and hydrophobic motif (HM) are important for PKC function. Here, we show that the mammalian target of rapamycin complex 2 (mTORC2) has an important function in phosphorylation of both TM and HM in all conventional PKCs, novel PKCepsilon as well as Akt. Ablation of mTORC2 components (Rictor, Sin1 or mTOR) abolished phosphorylation on the TM of both PKCalpha and Akt and HM of Akt and decreased HM phosphorylation of PKCalpha. Interestingly, the mTORC2-dependent TM phosphorylation is essential for PKCalpha maturation, stability and signalling. Our study demonstrates that mTORC2 is involved in post-translational processing of PKC by facilitating TM and HM phosphorylation and reveals a novel function of mTORC2 in cellular regulation.},
  isbn = {1460-2075 (Electronic)},
  keywords = {*Protein Processing Post-Translational,*Signal Transduction,Adaptor Proteins Signal Transducing/metabolism,Amino Acid Motifs,Animals,Carrier Proteins/genetics/metabolism,Fibroblasts/metabolism,Mice,Multiprotein Complexes/metabolism,Oncogene Protein v-akt/chemistry/*metabolism,Phosphorylation,Protein Kinase C/chemistry/*metabolism,Protein Kinases/*metabolism,Rats}
}

