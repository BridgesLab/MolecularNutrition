@article{Neyraud2012,
  title = {{{RalA}} and {{RalB}} Are Ubiquitinated {{GTPases}}, and Ubiquitinated {{RalA}} Increases Lipid Raft Exposure at the Plasma Membrane.},
  author = {Neyraud, Vincent and Aushev, Vasily N and Hatzoglou, Anastassia and Meunier, Brigitte and Cascone, Ilaria and Camonis, Jacques},
