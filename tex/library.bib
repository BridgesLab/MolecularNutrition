@article{Cheng2014a,
  title = {{{mTOR-}} and {{HIF-1}}~-Mediated Aerobic Glycolysis as Metabolic Basis for Trained Immunity},
  author = {Cheng, S.-C. and Quintin, J. and Cramer, R. A. and Shepardson, K. M. and Saeed, S. and Kumar, V. and {Giamarellos-Bourboulis}, E. J. and Martens, J. H. A. and Rao, N. A. and Aghajanirefah, A. and Manjeri, G. R. and Li, Y. and Ifrim, D. C. and Arts, R. J. W. and {van der Meer}, B. M. J. W. and Deen, P. M. T. and Logie, C. and O'Neill, L. A. and Willems, P. and {van de Veerdonk}, F. L. and {van der Meer}, J. W. M. and Ng, A. and Joosten, L. A. B. and Wijmenga, C. and Stunnenberg, H. G. and Xavier, R. J. and Netea, M. G.},
  year = {2014},
  journal = {Science},
  volume = {345},
  number = {6204},
  pages = {1250684--1250684},
  issn = {0036-8075},
  doi = {10.1126/science.1250684},
  abstract = {Epigenetic reprogramming of myeloid cells, also known as trained immunity, confers nonspecific protection from secondary infections. Using histone modification profiles of human monocytes trained with the Candida albicans cell wall constituent {$\beta$}-glucan, together with a genome-wide transcriptome, we identified the induced expression of genes involved in glucose metabolism. Trained monocytes display high glucose consumption, high lactate production, and a high ratio of nicotinamide adenine dinucleotide (NAD(+)) to its reduced form (NADH), reflecting a shift in metabolism with an increase in glycolysis dependent on the activation of mammalian target of rapamycin (mTOR) through a dectin-1-Akt-HIF-1{$\alpha$} (hypoxia-inducible factor-1{$\alpha$}) pathway. Inhibition of Akt, mTOR, or HIF-1{$\alpha$} blocked monocyte induction of trained immunity, whereas the adenosine monophosphate-activated protein kinase activator metformin inhibited the innate immune response to fungal infection. Mice with a myeloid cell-specific defect in HIF-1{$\alpha$} were unable to mount trained immunity against bacterial sepsis. Our results indicate that induction of aerobic glycolysis through an Akt-mTOR-HIF-1{$\alpha$} pathway represents the metabolic basis of trained immunity.},
  isbn = {1095-9203 (Electronic){\textbackslash}r0036-8075 (Linking)},
  pmid = {25258083},
  keywords = {Aerobiosis,Aerobiosis: immunology,alpha Subunit,alpha Subunit: genetic,alpha Subunit: metabol,Animal,Animals,beta-Glucans,beta-Glucans: immunology,Candida albicans,Candida albicans: immunology,Candidiasis,Candidiasis: immunology,Candidiasis: metabolism,Disease Models,Epigenesis,Female,Genetic,Glucose,Glucose: metabolism,Glycolysis,Glycolysis: immunology,Humans,Hypoxia-Inducible Factor 1,Immunity,Immunologic Memory,Immunologic Memory: genetics,Inbred C57BL,Innate,Innate: genetics,Male,Mice,Monocytes,Monocytes: immunology,Monocytes: metabolism,Sepsis,Sepsis: genetics,Sepsis: immunology,Sepsis: metabolism,Staphylococcal Infections,Staphylococcal Infections: immunology,Staphylococcal Infections: metabolism,Staphylococcus aureus,TOR Serine-Threonine Kinases,TOR Serine-Threonine Kinases: genetics,TOR Serine-Threonine Kinases: metabolism,Transcriptome}
}

