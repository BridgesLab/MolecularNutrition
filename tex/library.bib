@article{Lobo2010,
  title = {Cell Type-Specific Loss of {{BDNF}} Signaling Mimics Optogenetic Control of Cocaine Reward.},
  author = {Lobo, Mary Kay and Covington, Herbert E and Chaudhury, Dipesh and Friedman, Allyson K and Sun, HaoSheng and {Damez-Werno}, Diane and Dietz, David M and Zaman, Samir and Koo, Ja Wook and Kennedy, Pamela J and Mouzon, Ezekiell and Mogri, Murtaza and Neve, Rachael L and Deisseroth, Karl and Han, Ming-Hu and Nestler, Eric J},
  year = {2010},
  month = oct,
  journal = {Science},
  volume = {330},
  number = {6002},
  pages = {385--90},
  issn = {1095-9203},
  doi = {10.1126/science.1188472},
  urldate = {2014-11-15},
  abstract = {The nucleus accumbens is a key mediator of cocaine reward, but the distinct roles of the two subpopulations of nucleus accumbens projection neurons, those expressing dopamine D1 versus D2 receptors, are poorly understood. We show that deletion of TrkB, the brain-derived neurotrophic factor (BDNF) receptor, selectively from D1+ or D2+ neurons oppositely affects cocaine reward. Because loss of TrkB in D2+ neurons increases their neuronal excitability, we next used optogenetic tools to control selectively the firing rate of D1+ and D2+ nucleus accumbens neurons and studied consequent effects on cocaine reward. Activation of D2+ neurons, mimicking the loss of TrkB, suppresses cocaine reward, with opposite effects induced by activation of D1+ neurons. These results provide insight into the molecular control of D1+ and D2+ neuronal activity as well as the circuit-level contribution of these cell types to cocaine reward.},
  pmid = {20947769},
  keywords = {Animal,Animal: drug effects,Animals,bdnf,Behavior,Biological,Brain-Derived Neurotrophic Factor,Brain-Derived Neurotrophic Factor: metabolism,cocaine,Cocaine,Cocaine-Related Disorders,Cocaine-Related Disorders: metabolism,Cocaine: pharmacology,Conditioning (Psychology),Dopamine D1,Dopamine D1: metabolism,Dopamine D2,Dopamine D2: metabolism,dopaminergic neurons,Light,Messenger,Messenger: genetics,Messenger: metabolism,Mice,Mitogen-Activated Protein Kinase 1,Mitogen-Activated Protein Kinase 1: metabolism,Mitogen-Activated Protein Kinase 3,Mitogen-Activated Protein Kinase 3: metabolism,Models,Motor Activity,Motor Activity: drug effects,Neurons,Neurons: metabolism,Nucleus Accumbens,Nucleus Accumbens: cytology,Nucleus Accumbens: metabolism,Receptor,Receptors,reward,Reward,reward behavior,Rhodopsin,Rhodopsin: genetics,Rhodopsin: metabolism,RNA,Signal Transduction,Transgenic,trkB,trkB: genetics,trkB: metabolism}
}

