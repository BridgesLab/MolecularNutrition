@article{Blair2013b,
  title = {A Nondegenerate Code of Deleterious Variants in Mendelian Loci Contributes to Complex Disease Risk},
  author = {Blair, David~R. R. and Lyttle, Christopher~S. S. and Mortensen, Jonathan~M. M. and Bearden, Charles~F. F. and Jensen, Anders~Boeck Boeck and Khiabanian, Hossein and Melamed, Rachel and Rabadan, Raul and Bernstam, Elmer~V. V. and Brunak, S??ren S{\o}ren and Jensen, Lars~Juhl Juhl and Nicolae, Dan and Shah, Nigam~H. H. and Grossman, Robert~L. L. and Cox, Nancy~J. J. and White, Kevin~P. P. and Rzhetsky, Andrey},
  year = {2013},
  month = sep,
  journal = {Cell},
