  journal = {Diabetes},
  volume = {57},
  number = {4},
  eprint = {18174523},
  eprinttype = {pubmed},
  pages = {945--57},
  issn = {1939-327X},
  doi = {10.2337/db07-0922},
  urldate = {2012-09-03},
  abstract = {Mammalian target of rapamycin (mTOR) and its downstream target S6 kinase 1 (S6K1) mediate nutrient-induced insulin resistance by downregulating insulin receptor substrate proteins with subsequent reduced Akt phosphorylation. Therefore, mTOR/S6K1 inhibition could become a therapeutic strategy in insulin-resistant states, including type 2 diabetes. We tested this hypothesis in the Psammomys obesus (P. obesus) model of nutrition-dependent type 2 diabetes, using the mTOR inhibitor rapamycin.},
