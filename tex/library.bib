@article{Nosrat2004,
  title = {Dental Pulp Cells Provide Neurotrophic Support for Dopaminergic Neurons and Differentiate into Neurons in Vitro; Implications for Tissue Engineering and Repair in the Nervous System.},
  author = {Nosrat, Irina V and Smith, Christopher A and Mullally, Patrick and Olson, Lars and Nosrat, Christopher A},
  year = {2004},
  month = may,
  journal = {The European journal of neuroscience},
  volume = {19},
  number = {9},
  eprint = {15128393},
  eprinttype = {pubmed},
  pages = {2388--98},
  issn = {0953-816X},
  doi = {10.1111/j.0953-816X.2004.03314.x},
  urldate = {2014-07-16},
  abstract = {Glial cell line-derived neurotrophic factor (GDNF) mRNA is highly expressed by dental pulp cells (DPCs) prior to the initiation of dental pulp innervation. We show that radioactively labelled exogenous GDNF is retrogradely transported from neonatal teeth and vibrissae to the trigeminal neurons, indicating that GDNF acts as a classical neurotrophic factor in the trigeminal system. We also show that DPCs from both rats and humans produce nerve growth factor (NGF), brain-derived neurotrophic factor (BDNF) and GDNF mRNAs in vitro, promote the survival and phenotypic characteristics of embryonic dopaminergic (DA) neurons and protect DA neurons against the neurotoxin 6-hydroxy-dopamine (6-OHDA) in vitro. By using inhibitory antibodies to NGF, BDNF and GDNF, we show that the promotion of DA neuron survival relates to the production and release of neurotrophic proteins by DPCs in vitro. We suggest that in vivo production of neurotrophic factors by DPCs play roles in tooth innervation. However, continued production of neurotrophic factors by the DPCs might have wider implications. We propose that the dental pulp is a viable source of easily attainable cells with possible potential for development of autologous cell transplantation therapies. We also show that a population of neural crest-derived dental pulp cells acquire clear neuronal morphology and protein expression profile in vitro, indicating the presence of a cell population in the dental pulp with neuronal differentiation capacity that might provide additional benefits when grafted into the CNS.},
  pmid = {15128393},
  keywords = {Adolescent,Adult,Animals,Antibodies,Antibodies: pharmacology,Brain-Derived Neurotrophic Factor,Brain-Derived Neurotrophic Factor: genetics,Brain-Derived Neurotrophic Factor: immunology,Brain-Derived Neurotrophic Factor: metabolism,Cell Count,Cell Count: methods,Cell Differentiation,Cell Differentiation: physiology,Cell Division,Cell Division: drug effects,Cell Division: physiology,Cell Survival,Cell Survival: physiology,Cells,Coculture Techniques,Coculture Techniques: methods,Complementary,Complementary: chemistry,Cultured,Dental Pulp,Dental Pulp: cytology,Dental Pulp: innervation,Dental Pulp: physiology,DNA,Dopamine,Dopamine: metabolism,Embryo,Female,Glial Cell Line-Derived Neurotrophic Factor,Humans,Immunohistochemistry,Immunohistochemistry: methods,Iodine Isotopes,Iodine Isotopes: pharmacokinetics,Male,Mammalian,Mesencephalon,Mesencephalon: cytology,Messenger,Messenger: biosynthesis,Nerve Growth Factor,Nerve Growth Factor: genetics,Nerve Growth Factor: immunology,Nerve Growth Factor: metabolism,Nerve Growth Factors,Nerve Growth Factors: pharmacokinetics,Nerve Growth Factors: physiology,Neurons,Neurons: drug effects,Neurons: metabolism,Newborn,Oxidopamine,Oxidopamine: toxicity,Pregnancy,Pseudopodia,Pseudopodia: metabolism,Rats,Reverse Transcriptase Polymerase Chain Reaction,Reverse Transcriptase Polymerase Chain Reaction: m,RNA,Sprague-Dawley,Time Factors,Tissue Engineering,Tooth,Tooth: embryology,Tooth: innervation,Tubulin,Tubulin: metabolism,Tyrosine 3-Monooxygenase,Tyrosine 3-Monooxygenase: metabolism,Ubiquitin Thiolesterase,Ubiquitin Thiolesterase: metabolism,Vibrissae,Vibrissae: embryology,Vibrissae: innervation}
}

