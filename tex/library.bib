@article{VanTilbeurgh1999,
  title = {Colipase: {{Structure}} and Interaction with Pancreatic Lipase},
  author = {Van Tilbeurgh, H. and Bezzine, S. and Cambillau, C. and Verger, R. and Carri{\`e}re, F.},
  year = {1999},
  journal = {Biochimica et Biophysica Acta - Molecular and Cell Biology of Lipids},
  volume = {1441},
  number = {2-3},
  pages = {173--184},
  issn = {13881981},
  doi = {10.1016/S1388-1981(99)00149-3},
  abstract = {Colipase is a small protein cofactor needed by pancreatic lipase for the efficient dietary lipid hydrolysis. It binds to the C-terminal, non-catalytic domain of lipase, thereby stabilising an active conformation and considerably increasing the overall hydrophobic binding site. Structural studies of the complex and of colipase alone have clearly revealed the functionality of its architecture. Interestingly, a structural analogy has recently been discovered between colipase and a domain in a developmental protein (Dickkopf), based on sequence analogy and homology modeling. Whether this structural analogy implies a common function (lipid interaction) remains to be clarified. Structural analogies have also been recognised between the pancreatic lipase C-terminal domain, the N-terminal domains of lipoxygenases and the C-terminal domain of {$\alpha$}-toxin. These non-catalytic domains in the latter enzymes are important for interaction with membranes. It has not been established if these domains are also involved in eventual protein cofactor binding as is the case for pancreatic lipase. Copyright (C) 1999 Elsevier Science B.V.},
  isbn = {0006-3002 (Print)},
  pmid = {10570245},
  keywords = {C2-domain,Colipase,lipases,lipid absorbtion,lipid digestion,NUTR630,Pancreatic lipase,Structure}
}

@article{Walther2009,
  title = {The Life of Lipid Droplets},
