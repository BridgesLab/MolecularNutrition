  keywords = {11-beta-Hydroxysteroid Dehydrogenase Type 1,11-beta-Hydroxysteroid Dehydrogenase Type 1: antag,11b-HSD,Animals,Blood Glucose,Blood Glucose: drug effects,Blood Glucose: metabolism,Body Weight,Body Weight: drug effects,Diet,Energy Intake,Energy Metabolism,Energy Metabolism: drug effects,Enzyme Inhibitors,Enzyme Inhibitors: therapeutic use,Female,Inbred C57BL,Insulin,Insulin: blood,Kinetics,Mice,Obesity,Obesity: drug therapy,Obesity: physiopathology,Piperazines,Piperazines: therapeutic use,Reducing,Sulfonamides,Sulfonamides: therapeutic use,Thiazoles,Thiazoles: therapeutic use,Weight Gain,Weight Gain: physiology}
