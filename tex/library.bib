  author = {Yang, Linda and Chang, Chih-Chuan and Sun, Zhe and Madsen, Dennis and Zhu, Haisun and Padkj{\ae}r, S{\o}ren B. and Wu, Xiaoai and Huang, Tao and Hultman, Karin and Paulsen, Sarah J. and Wang, Jishu and Bugge, Anne and Frantzen, Jane Boesen and N{\o}rgaard, Per and Jeppesen, Jacob Fuglsbjerg and Yang, Zhiru and Secher, Anna and Chen, Haibin and Li, Xun and John, Linu Mary and Shan, Bing and He, Zhenhua and Gao, Xiang and Su, Jing and Hansen, Kristian T. and Yang, Wei and J{\o}rgensen, Sebastian Beck},
