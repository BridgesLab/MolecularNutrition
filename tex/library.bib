@article{Karras2020,
  title = {Effects of Orthodox Religious Fasting versus Combined Energy and Time Restricted Eating on Body Weight, Lipid Concentrations and Glycaemic Profile},
  author = {Karras, Spyridon N. and Koufakis, Theocharis and Adamidou, Lilian and Antonopoulou, Vasiliki and Karalazou, Paraskevi and Thisiadou, Katerina and Mitrofanova, Elina and Mulrooney, Hilda and Petr{\'o}czi, Andrea and Zebekakis, Pantelis and Makedou, Kali and Kotsa, Kalliopi},
  year = {2020},
  journal = {International Journal of Food Sciences and Nutrition},
  volume = {72},
  number = {1},
  pages = {82--92},
  publisher = {Taylor \& Francis},
  issn = {14653478},
  doi = {10.1080/09637486.2020.1760218},
  abstract = {For seven weeks, 37 overweight adults followed a hypocaloric diet based on Orthodox Fasting (OF). A hypocaloric, time restricted eating (TRE) plan (eating between 08:00 to 16:00 h, water fasting from 16:00 to 08:00 h) was followed by 23 Body Mass Index (BMI)-matched participants. Anthropometric, glycaemic and inflammation markers and serum lipids were assessed before and after the diets. Both OF and TRE groups demonstrated reductions in BMI (28.54 {\textpm} 5.45 vs 27.20 {\textpm} 5.10 kg/m2, p {$<$} 0.001 and 26.40 {\textpm} 4.11 vs 25.81 {\textpm} 3.78 kg/m2 p = 0.001, respectively). Following the intervention, the OF group presented lower concentrations of total and low-density lipoprotein-cholesterol, compared with the pre-fasting values (178.40 {\textpm} 34.14 vs 197.17 {\textpm} 34.30 mg/dl, p {$<$} 0.001 and 105.89 {\textpm} 28.08 vs 122.37 {\textpm} 29.70 mg/dl, p {$<$} 0.001, respectively). Neither group manifested significant differences in glycaemic and inflammatory parameters. Our findings suggest that OF has superior lipid lowering effects than the TRE pattern.},
  keywords = {cardiometabolic markers,insulin resistance,intermittent fasting,lipids,Orthodox fasting,time restricted eating}
}

