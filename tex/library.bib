  volume = {287},
  number = {35},
  eprint = {22700969},
  eprinttype = {pubmed},
  pages = {29397--29405},
  issn = {1083-351X},
  doi = {10.1074/jbc.M112.357764},
  urldate = {2012-07-30},
  abstract = {membrane raft trafficking. This study has shown a new post-translational modification to Ral GTPases: non-degradative ubiquitination. RalA (but not RalB) ubiquitination increases in anchorage-independent conditions in a caveolin-dependent manner, and when lipid rafts are endocytosed. Forcing RalA mono-ubiquitination (by expressing a protein fusion consisting of ubiquitin fused N-terminally to RalA) leads to RalA enrichment at the plasma membrane and increases raft exposure. This study suggests the existence of an ubiquitination/de-ubiquitination cycle superimposed on the GDP/GTP cycle of RalA, involved in the regulation of RalA activity as well as in membrane raft trafficking.},
