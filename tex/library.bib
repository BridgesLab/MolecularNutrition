@article{andradePrescriptionDrugUse2004,
  title = {Prescription Drug Use in Pregnancy},
  author = {Andrade, Susan E and Gurwitz, Jerry H and Davis, Robert L and Chan, K Arnold and Finkelstein, Jonathan A and Fortman, Kris and Mcphillips, Heather and Raebel, Marsha A and Roblin, Douglas and Smith, David H and Yood, Marianne Ulcickas and Morse, Abraham N and Platt, Richard},
