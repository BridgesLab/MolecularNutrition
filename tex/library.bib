@article{Berkes2005,
  title = {{{MyoD}} and the Transcriptional Control of Myogenesis.},
  author = {a Berkes, Charlotte and Tapscott, Stephen J},
  year = {2005},
  journal = {Seminars in cell \& developmental biology},
  volume = {16},
  number = {4-5},
  eprint = {16099183},
  eprinttype = {pubmed},
  pages = {585--95},
  issn = {1084-9521},
