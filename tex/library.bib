@article{Desai2013,
  title = {Elevated Sputum Interleukin-5 and Submucosal Eosinophilia in Obese Individuals with Severe Asthma.},
  author = {Desai, Dhananjay and Newby, Christopher and a Symon, Fiona and Haldar, Pranabashis and Shah, Sachil and Gupta, Sumit and Bafadhel, Mona and Singapuri, Amisha and Siddiqui, Salman and Woods, Joanne and Herath, Athula and Anderson, Ian K and Bradding, Peter and Green, Ruth and Kulkarni, Nita and Pavord, Ian and Marshall, Richard P and Sousa, Ana R and May, Richard D and Wardlaw, Andrew J and Brightling, Chris E},
  year = {2013},
  month = sep,
  journal = {American journal of respiratory and critical care medicine},
  volume = {188},
  number = {6},
  pages = {657--63},
  issn = {1535-4970},
  doi = {10.1164/rccm.201208-1470OC},
  urldate = {2014-08-20},
  abstract = {RATIONALE: The relationship between airway inflammation and obesity in severe asthma is poorly understood. OBJECTIVES: We sought to determine the relationship between sputum mediator profiles and the distribution of eosinophilic inflammation and obesity in people with severe asthma. METHODS: Clinical parameters and eight mediators in sputum were assessed in 131 subjects with severe asthma from a single center categorized into lean, overweight, and obese groups defined by their body mass index. In an independent group of people with severe asthma (n = 45) and healthy control subjects (n = 19) eosinophilic inflammation was enumerated in bronchial submucosa, blood, and sputum and related to their body mass index. MEASUREMENTS AND MAIN RESULTS: Sputum IL-5 geometric mean (95\% confidence interval) (pg/ml) was elevated in the obese (1.8 [1.2-2.6]) compared with overweight (1.1 [0.8-1.3]; P = 0.025) and lean (0.9 [0.6-1.2]; P = 0.018) subjects with asthma and was correlated with body mass index (r = 0.29; P {$<$} 0.001). There was no relationship among body mass index, the sputum cell count, or other sputum mediators. In the bronchoscopy group the submucosal eosinophil number in the subjects with asthma was correlated with body mass index (Spearman rank correlation, rs = 0.38; P = 0.013) and the median (interquartile range) number of submucosal eosinophils was increased in obese (19.4 [11.8-31.2]) (cells per square millimeter) versus lean subjects (8.2 [5.4-14.6]) (P = 0.006). There was no significant association between sputum or peripheral blood eosinophil counts and body mass index. CONCLUSIONS: Sputum IL-5 and submucosal eosinophils, but not sputum eosinophils, are elevated in obese people with severe asthma. Whether specific antieosinophilic therapy is beneficial, or improved diet and lifestyle in obese asthma has antiinflammatory effects beyond weight reduction, requires further study.},
  pmid = {23590263},
  keywords = {Asthma,Asthma: complications,Asthma: immunology,Asthma: metabolism,Biological Markers,Biological Markers: metabolism,Body Mass Index,Eosinophilia,Eosinophilia: complications,Eosinophilia: immunology,Eosinophilia: metabolism,Eosinophils,Eosinophils: immunology,Eosinophils: metabolism,Female,Humans,Interleukin-5,Interleukin-5: immunology,Interleukin-5: metabolism,Male,Middle Aged,Obesity,Obesity: complications,Obesity: immunology,Obesity: metabolism,Respiratory Mucosa,Respiratory Mucosa: immunology,Respiratory Mucosa: metabolism,Severity of Illness Index,Sputum,Sputum: immunology,Sputum: metabolism}
}

@article{Desai2016a,
  title = {A {{Dietary Fiber-Deprived Gut Microbiota Degrades}} the {{Colonic Mucus Barrier}} and {{Enhances Pathogen Susceptibility}}},
  author = {Desai, Mahesh~S. S. and Seekatz, Anna~M. M. and Koropatkin, Nicole~M. M. and Kamada, Nobuhiko and Hickey, Christina~A. A. and Wolter, Mathis and Pudlo, Nicholas~A. A. and Kitamoto, Sho and Terrapon, Nicolas and Muller, Arnaud and Young, Vincent~B. B. and Henrissat, Bernard and Wilmes, Paul and Stappenbeck, Thaddeus~S. S. and N????ez, Gabriel and Martens, Eric C. and N{\'u}{\~n}ez, Gabriel},
  year = {2016},
  journal = {Cell},
  volume = {167},
  number = {5},
  pages = {1339-1353.e21},
  issn = {10974172},
  doi = {10.1016/j.cell.2016.10.043},
  abstract = {Despite the accepted health benefits of consuming dietary fiber, little is known about the mechanisms by which fiber deprivation impacts the gut microbiota and alters disease risk. Using a gnotobiotic mouse model, in which animals were colonized with a synthetic human gut microbiota composed of fully sequenced commensal bacteria, we elucidated the functional interactions between dietary fiber, the gut microbiota, and the colonic mucus barrier, which serves as a primary defense against enteric pathogens. We show that during chronic or intermittent dietary fiber deficiency, the gut microbiota resorts to host-secreted mucus glycoproteins as a nutrient source, leading to erosion of the colonic mucus barrier. Dietary fiber deprivation, together with a fiber-deprived, mucus-eroding microbiota, promotes greater epithelial access and lethal colitis by the mucosal pathogen, Citrobacter rodentium. Our work reveals intricate pathways linking diet, the gut microbiome, and intestinal barrier dysfunction, which could be exploited to improve health using dietary therapeutics.},
  isbn = {0092-8674},
  pmid = {27863247},
  keywords = {Akkermansia,bacteroides,Citrobacter rodentium,dietary fiber,gylcans,microbiome,microbiota,mucin,mucus layer,polysaccharides}
}

