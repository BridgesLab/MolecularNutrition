  author = {Annesi, G and Aguglia, U. and Tarantino, P and Annesi, F and De Marco, E. V. and Civitelli, D and Torroni, a and Quattrone, a},
  year = {2007},
  month = mar,
  journal = {Clinical genetics},
  volume = {71},
  number = {3},
  eprint = {17309654},
  eprinttype = {pubmed},
