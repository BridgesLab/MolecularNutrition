@article{Shimano2017,
  title = {{{SREBP-regulated}} Lipid Metabolism: Convergent Physiology --- Divergent Pathophysiology},
  author = {Shimano, Hitoshi and Sato, Ryuichiro},
  year = {2017},
  month = aug,
  journal = {Nature Reviews Endocrinology},
  volume = {13},
  number = {12},
  pages = {710--730},
  publisher = {Nature Publishing Group},
  issn = {1759-5029},
  doi = {10.1038/nrendo.2017.91},
  abstract = {Sterol regulatory-element binding proteins (SREBPs) were first identified by Brown, Goldstein and col-leagues as transcription factors that regulate the pro-moters of genes involved in cholesterol biosynthesis and the LDL receptor (LDLR) pathway of sterol reg-ulation 1 , as reviewed elsewhere 2,3 . ADD1, a member of this protein family, was also found by Spiegelman and colleagues to have a role in adipogenesis 4 . Over the past 30 years, the identified functions of SREBPs have expanded to include numerous crucial biological pro-cesses, highlighting the importance of lipids in cellular and systems homeostasis 5,6 . This Review details progress in our understanding of how this unique transcription factor family con-tributes to cellular and systems physiology as well as to pathobiology and disease. SREBPs are conserved from fission yeast to humans and regulate the expres-sion of genes that control cellular lipid homeostasis according to species-specific requirements. For this purpose, these proteins and their target genes perform complex feedback regulation of SREBP activity at mul-tiple levels. Substantial species-specific differences in both SREBP targets and control pathways exist. For example, phosphatidylcholine and the methyl donor S-adenosylmethionine are regulators of SREBP activity in Drosophila, whereas hypoxia regulates SREBP activ-ity in fission yeast 7,8 . In this Review, however, we focus on SREBP regulation of cholesterol and fatty acid metabolism in mammals. Molecular features of SREBPs Discovery Cellular lipids, especially cholesterol and fatty acids, function both as basic structural components of cell membranes and as metabolic intermediates and signal-ling factors involved in networks that coordinate most biological processes. Cells maintain a steady state level of membrane cholesterol by controlling its biosynthesis and uptake to maintain membrane fluidity and metabolic homeostasis. Cholesterol synthesis and uptake pathways are regulated at the transcriptional level through clas-sic end-product feedback inhibition of 3-hydroxy-3-methylglutaryl (HMG) CoA reductase, the rate-limiting enzyme for cholesterol biosynthesis, and via LDLR, which mediates endocytosis of cholesterol-rich LDLs. The promoter regions of these genes contain a DNA ele-ment called the sterol regulatory element (SRE), which is responsible for sterol-dependent regulation of expres-sion. Using double-stranded DNA fragments containing the SRE sequence (5'-ATCACCCCAC-3'), DNA-bound 1},
  pmid = {28849786}
}

