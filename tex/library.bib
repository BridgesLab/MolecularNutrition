@article{Jenabi2017,
  title = {The Association between Maternal Smoking and Hyperemesis Gravidarum: A Meta-Analysis},
  author = {Jenabi, Ensiyeh and Fereidooni, Bita},
  year = {2017},
  journal = {Journal of Maternal-Fetal and Neonatal Medicine},
  volume = {30},
  number = {6},
  pages = {693--697},
  issn = {14764954},
  doi = {10.1080/14767058.2016.1183194},
  abstract = {Background: The majority of studies have not found hyperemesis to be a protective and some others have not. To date, no meta-analysis has quantitatively assessed the association between smoking and risk of hyperemesis gravidarum. To help close that research gap, we performed meta-analysis of the association between smoking and risk of hyperemesis gravidarum. Methods: A literature search was carried out in PubMed, Web of Science, and Scopus from the earliest possible year to January 2016. The heterogeneity across studies was explored by Q-test and I2 statistic. The possibility of publication bias was assessed using Begg's and Egger's tests. The results were reported using odds ratio (OR) estimate with its 95\% confidence intervals (CI) using a random-effects model. Results: The literature search yielded 607 publications until January 2016 with 1 400 000 participants. Based on the random-effects model, compared to nonsmoker people, the estimated OR of hyperemesis gravidarum was 0.40 (95\% CI: 0.24, 0.56). Conclusions: We showed based on reports in epidemiological studies that smoking before and during pregnancy is not a risk factor for hyperemesis gravidarum but also can reduce the risk of it.},
  keywords = {Hyperemesis gravidarum,meta-analysis,pregnancy,smoking}
}

@article{Jenett2012,
  title = {A {{GAL4-driver}} Line Resource for {{Drosophila}} Neurobiology.},
  author = {Jenett, Arnim and Rubin, Gerald M and Ngo, Teri-T B and Shepherd, David and Murphy, Christine and Dionne, Heather and Pfeiffer, Barret D and Cavallaro, Amanda and Hall, Donald and Jeter, Jennifer and Iyer, Nirmala and Fetter, Dona and Hausenfluck, Joanna H and Peng, Hanchuan and Trautman, Eric T and Svirskas, Robert R and Myers, Eugene W and Iwinski, Zbigniew R and Aso, Yoshinori and DePasquale, Gina M and Enos, Adrianne and Hulamm, Phuson and Lam, Shing Chun Benny and Li, Hsing-Hsi and Laverty, Todd R and Long, Fuhui and Qu, Lei and Murphy, Sean D and Rokicki, Konrad and Safford, Todd and Shaw, Kshiti and Simpson, Julie H and Sowell, Allison and Tae, Susana and Yu, Yang and Zugates, Christopher T},
  year = {2012},
  month = oct,
  journal = {Cell reports},
  volume = {2},
  number = {4},
  pages = {991--1001},
  publisher = {The Authors},
  issn = {2211-1247},
  doi = {10.1016/j.celrep.2012.09.011},
  urldate = {2014-03-19},
  abstract = {We established a collection of 7,000 transgenic lines of Drosophila melanogaster. Expression of GAL4 in~each line is controlled by a different, defined fragment of genomic DNA that serves as a transcriptional enhancer. We used confocal microscopy of~dissected nervous systems to determine the expression patterns driven by each fragment in the adult brain and ventral nerve cord. We present image data on 6,650 lines. Using both manual and machine-assisted annotation, we describe the expression patterns in the most useful lines. We illustrate the utility of these data for identifying novel neuronal cell types, revealing brain asymmetry, and describing the nature and extent of neuronal shape stereotypy. The GAL4 lines allow expression of exogenous genes in distinct, small subsets of the adult nervous system. The set of DNA fragments, each driving a documented expression pattern, will facilitate the generation of additional constructs for manipulating neuronal function.},
  pmid = {23063364},
  keywords = {Animals,Animals Genetically Modified,Brain,Brain: metabolism,Databases Factual,Drosophila melanogaster,Drosophila melanogaster: genetics,Drosophila melanogaster: metabolism,Drosophila Proteins,Drosophila Proteins: genetics,Drosophila Proteins: metabolism,Immunohistochemistry,Microscopy Confocal,Nervous System,Nervous System: metabolism,Transcription Factors,Transcription Factors: genetics,Transcription Factors: metabolism,Transcription Genetic}
}

