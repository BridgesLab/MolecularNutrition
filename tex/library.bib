@article{Wan2011b,
  title = {Postprandial Hepatic Lipid Metabolism Requires Signaling through {{Akt2}} Independent of the Transcription Factors {{FoxA2}}, {{FoxO1}}, and {{SREBP1c}}.},
  author = {Wan, Min and Leavens, Karla F. and Saleh, Danish and Easton, Rachael M and Guertin, David A. and Peterson, Timothy R. and Kaestner, Klaus H. and Sabatini, David M. and Birnbaum, Morris J.},
  year = {2011},
  month = oct,
  journal = {Cell metabolism},
  volume = {14},
  number = {4},
  pages = {516--27},
  publisher = {Elsevier Inc.},
  issn = {1932-7420},
  doi = {10.1016/j.cmet.2011.09.001},
  urldate = {2013-11-03},
  abstract = {Under conditions of obesity and insulin resistance, the serine/threonine protein kinase Akt/PKB is required for lipid accumulation in liver. Two forkhead transcription factors, FoxA2 and FoxO1, have been suggested to function downstream of and to be negatively regulated by Akt and are proposed as key determinants of hepatic triglyceride content. In this study, we utilize genetic loss of function experiments to show that constitutive activation of neither FoxA2 nor FoxO1 can account for the protection from steatosis afforded by deletion of Akt2 in liver. Rather, another downstream target positively regulated by Akt, the mTORC1 complex, is required in vivo for de novo lipogenesis and Srebp1c expression. Nonetheless, activation of mTORC1 and SREBP1c is not sufficient to drive postprandial lipogenesis in the absence of Akt2. These data show that insulin signaling through Akt2 promotes anabolic lipid metabolism independent of Foxa2 or FoxO1 and through pathways additional to the mTORC1-dependent activation of SREBP1c.},
  pmid = {21982711},
  keywords = {Animals,Antirheumatic Agents,Antirheumatic Agents: pharmacology,Aurothioglucose,Aurothioglucose: pharmacology,Diet,Forkhead Transcription Factors,Forkhead Transcription Factors: deficiency,Forkhead Transcription Factors: genetics,Forkhead Transcription Factors: metabolism,Hepatocyte Nuclear Factor 3-beta,Hepatocyte Nuclear Factor 3-beta: metabolism,High-Fat,Insulin,Insulin: metabolism,Knockout,Lipid Metabolism,Lipid Metabolism: drug effects,Lipid Metabolism: physiology,Liver,Liver: metabolism,Male,Mice,Proteins,Proteins: metabolism,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins c-akt: deficiency,Proto-Oncogene Proteins c-akt: genetics,Proto-Oncogene Proteins c-akt: metabolism,Signal Transduction,Sterol Regulatory Element Binding Protein 1,Sterol Regulatory Element Binding Protein 1: metab,Transcription Factors,Transcription Factors: metabolism,Triglycerides,Triglycerides: metabolism}
}

@article{Wan2013,
  title = {A Noncanonical, {{GSK3-independent}} Pathway Controls Postprandial Hepatic Glycogen Deposition},
  author = {Wan, Min and Leavens, Karla F. and Hunter, Roger W. and Koren, Shlomit and {von Wilamowitz-Moellendorff}, Alexander and Lu, Mingjian and Satapati, Santhosh and Chu, Qingwei and Sakamoto, Kei and Burgess, Shawn C. and Birnbaum, Morris J.},
  year = {2013},
  month = jul,
  journal = {Cell Metabolism},
  volume = {18},
  number = {1},
  pages = {99--105},
  publisher = {Elsevier Inc.},
  issn = {15504131},
  doi = {10.1016/j.cmet.2013.06.001},
  urldate = {2014-07-23},
  abstract = {Insulin rapidly suppresses hepatic glucose production and slowly decreases expression of genes encoding gluconeogenic proteins. In this study, we show that an immediate effect of insulin is to redirect newly synthesized glucose-6-phosphate to glycogen without changing the rate of gluconeogenesis. This process requires hepatic Akt2, as revealed by blunted insulin-mediated suppression of glycogenolysis in the perfused mouse liver, elevated hepatic glucose production during a euglycemic-hyperinsulinemic clamp, or diminished glycogen accumulation during clamp or refeeding in mice without hepatic Akt2. Surprisingly, the absence of Akt2 disrupted glycogen metabolism independent of GSK3?? and GSK3?? phosphorylation, which is thought to be an essential step in the pathway by which insulin regulates glycogen synthesis through Akt. These data show that (1) the immediate action of insulin to suppress hepatic glucose production functions via an Akt2-dependent redirection of glucose-6-phosphate to glycogen, and (2) insulin increases glucose phosphorylation and conversion to glycogen independent of GSK3. ?? 2013 Elsevier Inc.},
  isbn = {1932-7420 (Electronic){\textbackslash}r1550-4131 (Linking)},
  pmid = {23823480},
  keywords = {Animal,Animals,Disease Models,Glucose Clamp Technique,Glucose-6-Phosphate,Glucose-6-Phosphate: metabolism,Glycogen,Glycogen Synthase Kinase 3,Glycogen Synthase Kinase 3: physiology,Glycogen: metabolism,Glycogenolysis,Glycogenolysis: physiology,Hyperinsulinism,Hyperinsulinism: metabolism,Hyperinsulinism: physiopathology,Inbred C57BL,Insulin,Insulin: metabolism,Knockout,Liver,Liver: metabolism,Male,Mice,Postprandial Period,Postprandial Period: physiology,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins c-akt: deficiency,Proto-Oncogene Proteins c-akt: genetics,Proto-Oncogene Proteins c-akt: metabolism,Signal Transduction,Signal Transduction: physiology}
}

@article{Wanders2011,
  title = {Fatty Acid Omega-Oxidation as a Rescue Pathway for Fatty Acid Oxidation Disorders in Humans},
  author = {Wanders, Ronald J.A. and Komen, Jasper and Kemp, Stephan},
  year = {2011},
  journal = {FEBS Journal},
  volume = {278},
  number = {2},
  pages = {182--194},
  issn = {1742464X},
  doi = {10.1111/j.1742-4658.2010.07947.x},
  abstract = {Fatty acids (FAs) can be degraded via different mechanisms including {$\alpha$}-, {$\beta$}- and {$\omega$}-oxidation. In humans, a range of different genetic diseases has been identified in which either mitochondrial FA {$\beta$}-oxidation, peroxisomal FA {$\beta$}-oxidation or FA {$\alpha$}-oxidation is impaired. Treatment options for most of these disorders are limited. This has prompted us to study FA {$\omega$}-oxidation as a rescue pathway for these disorders, based on the notion that if the {$\omega$}-oxidation of specific FAs could be upregulated one could reduce the accumulation of these FAs and the subsequent detrimental effects in the different groups of disorders. In this minireview, we describe our current state of knowledge in this area with special emphasis on Refsum disease and X-linked adrenoleukodystrophy.},
  isbn = {1742-4658 (Electronic){\textbackslash}r1742-464X (Linking)},
  pmid = {21156023},
  keywords = {-oxidation,adrenoleukodystrophy,CRefsum disease,cytochrome P450,fatty acids,mitochondria,omega oxidation,peroxisomes,Zellweger syndrome}
}

@book{Wanders2019,
  title = {Phytanic Acid Metabolism in Health and Disease},
  author = {Wanders, Ronald J.A.},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  publisher = {Elsevier Inc.},
  doi = {10.1016/B978-0-12-804572-5.00046-X},
  abstract = {Phytanic acid is one of the most common branched-chain fatty acids in the human diet. It cannot be synthesized endogenously, at least in humans, and it is especially high in fat-containing foods of animal origin; it also occurs in animals higher up the food chain, such as mollusks, fish, and whales. Degradation of phytanic acid occurs via a specialized oxidation system in peroxisomes named a-oxidation. To date, only a single genetic disease has been identified in which phytanic acid oxidation is impaired. Refsum disease is characterized by retinitis pigmentosa and night blindness, followed by anosmia, neuropathy, deafness, ataxia, and ichthyosis, in decreasing order of frequency. Phytanic acid is a ligand for several nuclear receptors, including receptor retinoid-X receptor and the peroxisome proliferator-activated receptors, which may be the basis for the proclaimed health-promoting effects of phytanic acid. On the other hand, phytanic acid has also been associated with prostate cancer and other cancers, but current evidence holds that the association is weak.},
  isbn = {978-0-12-804572-5},
  keywords = {Branched-chain fatty acids,Peroxisome-proliferator activated receptor-retinoi,Peroxisomes,Phytanic acid,Prostate cancer,Refsum disease}
}

@article{Wang2003,
  title = {Yeast Homotypic Vacuole Fusion Requires the {{Ccz1-Mon1}} Complex during the Tethering/Docking Stage},
  author = {Wang, C W and Stromhaug, P E and Kauffman, Emily J. and Weisman, Lois~S. and Klionsky, Daniel J.},
  year = {2003},
  journal = {J Cell Biol},
  volume = {163},
  number = {5},
  pages = {973--985},
  abstract = {The function of the yeast lysosome/vacuole is critically linked with the morphology of the organelle. Accordingly, highly regulated processes control vacuolar fission and fusion events. Analysis of homotypic vacuole fusion demonstrated that vacuoles from strains defective in the CCZ1 and MON1 genes could not fuse. Morphological evidence suggested that these mutant vacuoles could not proceed to the tethering/docking stage. Ccz1 and Mon1 form a stable protein complex that binds the vacuole membrane. In the absence of the Ccz1-Mon1 complex, the integrity of vacuole SNARE pairing and the unpaired SNARE class C Vps/HOPS complex interaction were both impaired. The Ccz1-Mon1 complex colocalized with other fusion components on the vacuole as part of the cis-SNARE complex, and the association of the Ccz1-Mon1 complex with the vacuole appeared to be regulated by the class C Vps/HOPS complex proteins. Accordingly, we propose that the Ccz1-Mon1 complex is critical for the Ypt7-dependent tethering/docking stage leading to the formation of a trans-SNARE complex and subsequent vacuole fusion.},
  isbn = {0021-9525 (Print)},
  keywords = {*Guanine Nucleotide Exchange Factors,*Vesicular Transport Proteins,Biological Transport,Carrier Proteins/genetics/*metabolism,Macromolecular Substances,Membrane Fusion/*physiology,Membrane Proteins/metabolism,rab GTP-Binding Proteins/metabolism,Recombinant Fusion Proteins/metabolism,Saccharomyces cerevisiae Proteins/genetics/*metabo,Saccharomyces cerevisiae/*cytology/metabolism,SNARE Proteins,Vacuoles/*metabolism,weisman},
  annotation = {0021-9525 (Linking)}
}

@article{Wang2004,
  title = {Regulation of Muscle Fiber Type and Running Endurance by {{PPAR}}??},
  author = {Wang, Yong Xu and Zhang, Chun Li and Yu, Ruth T. and Cho, Helen K. and Nelson, Michael C. and {Bayuga-Ocampo}, Corinne R. and Ham, Jungyeob and Kang, Heonjoong and Evans, Ronald M.},
  year = {2004},
  journal = {PLoS Biology},
  volume = {2},
  number = {10},
  issn = {15449173},
  doi = {10.1371/journal.pbio.0020294},
  abstract = {Endurance exercise training can promote an adaptive muscle fiber transformation and an increase of mitochondrial biogenesis by triggering scripted changes in gene expression. However, no transcription factor has yet been identified that can direct this process. We describe the engineering of a mouse capable of continuous running of up to twice the distance of a wild-type littermate. This was achieved by targeted expression of an activated form of peroxisome proliferator-activated receptor {$\delta$} (PPAR{$\delta$}) in skeletal muscle, which induces a switch to form increased numbers of type I muscle fibers. Treatment of wild-type mice with PPAR{$\delta$} agonist elicits a similar type I fiber gene expression profile in muscle. Moreover, these genetically generated fibers confer resistance to obesity with improved metabolic profiles, even in the absence of exercise. These results demonstrate that complex physiologic properties such as fatigue, endurance, and running capacity can be molecularly analyzed and manipulated.},
  isbn = {1544-9173},
  pmid = {15328533}
}

