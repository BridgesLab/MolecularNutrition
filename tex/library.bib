@article{locciComparisonMemoryAffective2021,
  title = {Comparison of Memory, Affective Behavior, and Neuropathology in {{APPNLGF}} Knock-in Mice to {{5xFAD}} and {{APP}}/{{PS1}} Mice},
  author = {Locci, Andrea and Orellana, Hector and Rodriguez, Guadalupe and Gottliebson, Meredith and McClarty, Bryan and Dominguez, Sky and Keszycki, Rachel and Dong, Hongxin},
  year = {2021},
  month = apr,
  journal = {Behavioural brain research},
  volume = {404},
  pages = {113192},
  issn = {0166-4328},
  doi = {10.1016/j.bbr.2021.113192},
  urldate = {2024-03-10},
  abstract = {Transgenic mouse models of A{$\beta$} amyloidosis generated by knock-in of a humanized A{$\beta$} sequence can offer some advantages over the transgenic models that overexpress amyloid precursor protein (APP). However, systematic comparison of memory, behavioral, and neuropathological phenotypes between these models has not been well documented. In this study, we compared memory and affective behavior in APPNLGF mice, an APP knock-in model, to two widely used mouse models of Alzheimer's disease, 5xFAD and APP/PS1 mice, at 10 months of age. We found that, despite similar deficits in working memory, object recognition, and social recognition memory, APPNLGF and 5xFAD mice but not APP/PS1 mice show compelling anxiety- and depressive-like behavior, and exhibited a marked impairment of social interaction. We quantified corticolimbic A{$\beta$} plaques, which were lowest in APPNLGF, intermediate in APP/PS1, and highest in 5xFAD mice. Interestingly, analysis of plaque size revealed that plaques were largest in APP/PS1 mice, intermediate in 5xFAD mice, and smallest in APPNLGF mice. Finally, we observed a significantly higher percentage of the area occupied by plaques in both 5xFAD and APP/PS1 relative to APPNLGF mice. Overall, our findings suggest that the severity of A{$\beta$} neuropathology is not directly correlated with memory and affective behavior impairments between these three transgenic mouse models. Additionally, APPNLGF may represent a valid mouse model for studying AD comorbid with anxiety and depression.},
  pmcid = {PMC7980131},
  pmid = {33607163},
  file = {/Users/davebrid/Zotero/storage/YSCUD3IL/Locci et al. - 2021 - Comparison of memory, affective behavior, and neur.pdf}
}

