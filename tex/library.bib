  author = {Lindholm, J and Juul, S and Jorgensen, {\relax JOL} and Astrup, J and Bjerre, P and {Feldt-Rasmussen}, U and Hagen, C and J{\o}rgensen, Jens Otto Lunde and Kosteljanetz, M and Kristensen, L {\O} and Laurberg, P and Schmidt, K and Weeke, J},
