  keywords = {Insulin resistance,Muscle proteolysis,Myotoxicity,Statins},
  file = {/Users/davebrid/Zotero/storage/QDZHK4XY/Lorza-Gil et al. - 2019 - Diabetogenic effect of pravastatin is associated with insulin resistance and myotoxicity in hypercho.pdf}
}

