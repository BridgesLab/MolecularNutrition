  month = jul,
  journal = {Nature reviews. Molecular cell biology},
  volume = {13},
  number = {7},
  eprint = {22722608},
  eprinttype = {pubmed},
  pages = {463--70},
  issn = {1471-0080},
  doi = {10.1038/nrm3379},
  urldate = {2012-12-18},
  abstract = {Membrane trafficking relies on dynamic changes in membrane identities that are determined by the regulation of distinct RAB GTPases and phosphoinositides. RABs and phosphoinositides both act to spatiotemporally recruit effectors of membrane remodelling, including sequential RAB and phosphoinositide activities. New ideas on coordinated regulation of specific RABs and phosphoinositides, achieved by direct physical and functional interactions between their regulatory enzymes, are emerging as a central mechanism to ensure precision and fidelity of membrane trafficking.},
  pmid = {22722608},
  keywords = {Animals,Biological,Cell Membrane,Cell Membrane: metabolism,Endosomes,Endosomes: metabolism,Humans,Models,Phosphatidylinositols,Phosphatidylinositols: chemistry,Protein Transport,Proteome,rab GTP-Binding Proteins,rab GTP-Binding Proteins: chemistry,Signal Transduction,Time Factors}
}

@article{Jean2014,
  title = {Classes of Phosphoinositide 3-Kinases at a Glance.},
  author = {Jean, Steve and a Kiger, Amy},
  year = {2014},
  month = mar,
  journal = {Journal of cell science},
  volume = {127},
  number = {Pt 5},
  eprint = {24587488},
  eprinttype = {pubmed},
  pages = {923--8},
  issn = {1477-9137},
  doi = {10.1242/jcs.093773},
  urldate = {2014-04-28},
  abstract = {The phosphoinositide 3-kinase (PI3K) family is important to nearly all aspects of cell and tissue biology and central to human cancer, diabetes and aging. PI3Ks are spatially regulated and multifunctional, and together, act at nearly all membranes in the cell to regulate a wide range of signaling, membrane trafficking and metabolic processes. There is a broadening recognition of the importance of distinct roles for each of the three different PI3K classes (I, II and III), as well as for the different isoforms within each class. Ongoing issues include the need for a better understanding of the in vivo complexity of PI3K regulation and cellular functions. This Cell Science at a Glance article and the accompanying poster summarize the biochemical activities, cellular roles and functional requirements for the three classes of PI3Ks. In doing so, we aim to provide an overview of the parallels, the key differences and crucial interplays between the regulation and roles of the three PI3K classes.},
  pmid = {24587488},
  keywords = {9500 gilman drive,ca 92093-0380,class i pi3k,class ii pi3k,class iii pi3k,developmental biology,la jolla,phosphoinositide,pi3-kinases,pi3k,san diego,section of cell and,university of california,usa}
}

