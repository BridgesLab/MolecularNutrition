@article{Hupalowska2011,
  title = {The {{New Faces}} of {{Endocytosis}} in {{Signaling}}.},
  author = {Hupalowska, Anna and Miaczynska, Marta},
  year = {2011},
  month = jul,
  journal = {Traffic},
  pages = {1--10},
  publisher = {Wiley Online Library},
  issn = {1600-0854},
  doi = {10.1111/j.1600-0854.2011.01249.x},
  urldate = {2011-08-26},
  abstract = {It is becoming clear that intracellular signaling events are intimately linked with the membrane transport processes. In addition to the long known role of endocytosis in downregulating plasma membrane receptors, more recent data uncover several sophisticated modes by which endocytosis affects the type and duration of signals. Particularly striking are various roles of endocytic compartments as membrane platforms for compartmentalized assembly or sequestration of specific signaling complexes. Here we review some recent examples illustrating how endosomes may mediate ligand-stimulated apoptotic signaling and how multivesicular bodies affect Wnt signaling by regulated sequestration of signaling molecules or their secretion in exosomes. We also discuss evidence documenting the involvement of endocytic proteins in the regulation of p53 activity and stability, which suggests a possible cross-talk between endocytic processes and transcriptional responses.},
  pmid = {21752167},
  keywords = {endocytosis,endosomes,multivesicular bodies,receptosomes,review,signaling,tumor necrosis}
}

