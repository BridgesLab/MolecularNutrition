@article{Kushner1996a,
  title = {Desmoplastic Small Round-Cell Tumor: {{Prolonged}} Progression-Free Survival with Aggressive Multimodality Therapy},
  author = {Kushner, B. H. and LaQuaglia, M. P. and Wollner, N. and Meyers, P. A. and Lindsley, K. L. and Ghavimi, F. and Merchant, T. E. and Boulad, F. and Cheung, N. K. and Bonilla, M. A. and Crouch, G. and Kelleher, J. F. and Steinherz, P. G. and Gerald, W. L.},
