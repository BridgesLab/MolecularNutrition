@article{carlsonEffectsOralCalcium1971,
  title = {Effects of Oral Calcium upon Serum Cholesterol and Triglycerides in Patients with Hyperlipidemia},
  author = {Carlson, L. A. and Olsson, A. G. and Oro, L. and Rossner, S.},
  year = {1971},
  month = nov,
  journal = {Atherosclerosis},
  volume = {14},
  number = {3},
  pages = {391--400},
  issn = {0021-9150},
  doi = {10.1016/0021-9150(71)90067-0},
  urldate = {2022-09-01},
  abstract = {The effect on serum lipids of oral administration of 2 g calcium daily during 8 weeks was studied in 16 Hyperlipidemic patients. The study was preceded by a 4 week placebo period. Five patients were classified as having type IIA hyperlipidemia according to Fredrickson et al. (as modified), 10 patients as having type IIB and 1 patient as having type IV. Body weight before the study and mean values during placebo and calcium therapy were 70.2 {\textpm} 2.49 kg, 70.0 {\textpm} 2.54 kg and 69.4 {\textpm} 2.55 kg respectively. The difference between placebo mean value and calcium mean value was significant at the 5\% level. The average serum triglyceride value before treatment was 2.89 {\textpm} 0.383 mmol/1, during treatment with placebo 2.45 {\textpm} 0.266 mmol/l and during calcium treatment 2.70 {\textpm} 0.286 mmol/l. The decrease during placebo therapy when compared to the mean value before treatment was significant at the 5\% level. No decrease in serum triglycerides could be ascribed to calcium therapy. The average serum cholesterol value before treatment was 337 {\textpm} 13.5 mg/ 100 ml and decreased to 321 {\textpm} 12.8 mg/ 100 ml during placebo treatment and to 303 {\textpm} 12.0 mg/ 100 ml during treatment with calcium. The decrease was significant at the 1\% level when the mean value before treatment was compared to the average value during placebo therapy, and was significant at the 0.1\% level when the mean value during placebo treatment was compared to the mean value during calcium therapy. No correlation was noted between either total or low density lipoprotein cholesterol levels before treatment and decrease in total cholesterol levels.},
  langid = {english},
  keywords = {Calcium,Cholesterol,Hyperlipidemia,Serum lipids,Triglycerides},
  file = {/Users/davebrid/Zotero/storage/XL958GWK/Carlson et al. - 1971 - Effects of oral calcium upon serum cholesterol and.pdf;/Users/davebrid/Zotero/storage/MGNSJG3A/0021915071900670.html}
}

