@article{Bordoni2019,
  title = {Nutrigenomics of Food Pesticides},
  author = {Bordoni, Laura and Gabbianelli, Rosita},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {513--518},
  doi = {10.1016/B978-0-12-804572-5.00067-7},
  abstract = {The environment has a substantial role in determining our health and in developing diseases. Among environmental factors, pesticides designed to control pests but also capable of being toxic to nontarget living organisms are a major concern for human health. Exposure to these toxicants through nutrition has been well-established, and both the level of pesticides contained in foods and markers of exposure in human populations have been measured. Whereas the acute toxic effects of pesticides have been widely examined, uncertainties remain regarding chronic and long-term consequences of low-level exposure. Environmental exposures can trigger several types of damage. First, chemicals can provoke changes in gene expression by interfering with various signaling pathways. However, evidence suggests that pesticides can alter host defenses and lead to the onset and progression of diseases through epigenetic changes. Exposure to pesticides triggers individual responses. Variability in individual susceptibility is governed by several genetic variants, which suggests that specific subpopulations of individuals should be made aware and alerted to these potentially harmful effects. Studies in both humans and animals showed that epigenetic perturbations occur particularly during certain periods of life, and that the epigenetic memory of such events is related to chronic late-onset disease. Furthermore, not only the generation directly exposed but also its offspring can be affected by such epigenetic perturbations. Given the pivotal role of nutrition in modulating epigenetic homeostasis, the content of pesticides in foods is an important aspect to consider in relation to nutrigenomic effects for the promotion of health and the prevention of chronic disease.},
  isbn = {9780128045725},
  keywords = {Epigenetic inheritance,Epigenetic memory: pesticides,Food contaminants,Nutrigenomics,Organic foods,Supplements}
}

@book{Borel2019,
  title = {Genetic Determinants of Vitamin {{E}} Status},
  author = {Borel, Patrick and Desmarchelier, Charles},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  publisher = {Elsevier Inc.},
  doi = {10.1016/B978-0-12-804572-5.00033-1},
  abstract = {Both vitamin E (VE) consumption and VE status have been negatively associated with the incidence of degenerative diseases and some cancers. VE status is usually estimated by measuring the fasting blood VE concentration. This parameter reflects the complex interactions between intake, absorption efficiency, blood clearance (e.g., liver secretion and tissue uptake), utilization, and catabolism of VE. These processes are modulated by numerous proteins: during digestion of VE-rich meals in the intestinal lumen, e.g., CEH; for VE uptake by enterocytes, e.g., SR-BI and NPC1L1; for secretion and metabolism of chylomicrons, which transport newly absorbed VE into the blood circulation; for VE secretion into VLDL by the liver, including the key protein a-TTP; and for VE catabolism. As a consequence, it has been hypothesized that VE status is modulated, at least in part, by genetic variations in genes encoding for these proteins. Several single-nucleotide polymorphisms (SNPs) associated with the variability in fasting blood VE concentration, e.g., SNPs in CYP4F2, SCARB1, and APOA1/C3/A4/A5, have been identified in genome-wide or candidate gene-association studies. Recently, 28 SNPs in or near 11 genes, some involved in VE absorption, some in chylomicron metabolism, have been associated with the interindividual variability in VE bioavailability. Although genetics only represents one variable in the VE status equation, together with VE dietary intake, dietary habits, oxidative stress (through, e.g., smoking), it has the benefit of being stable over the lifespan. As promising and exciting this area of research is, a lot of work remains to be done to identify enough genetic variations involved in VE status variability in order to provide accurate personalized nutritional recommendations. These data could also allow clinicians to assess the biological effects of VE, based on one's individual genetic characteristics, in new VE supplementation trials.},
  isbn = {978-0-12-804572-5},
  keywords = {Absorption,Bioavailability,Genetic polymorphism,Genetic variation,Nutrigenetics,Snp,Tocopherol}
}

