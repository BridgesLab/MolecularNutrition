@article{Jones2020,
  title = {Two Weeks of Early Time-Restricted Feeding ({{eTRF}}) Improves Skeletal Muscle Insulin and Anabolic Sensitivity in Healthy Men},
  author = {Jones, Robert and Pabla, Pardeep and Mallinson, Joanne and Nixon, Aline and Taylor, Tariq and Bennett, Andrew and Tsintzas, Kostas},
  year = {2020},
  journal = {The American Journal of Clinical Nutrition},
  volume = {112},
  number = {4},
  pages = {1015--1028},
  publisher = {Oxford University Press},
  issn = {0002-9165},
  doi = {10.1093/ajcn/nqaa192},
  abstract = {Background Altering the temporal distribution of energy intake (EI) and introducing periods of intermittent fasting (IF) exert important metabolic effects. Restricting EI to earlier in the day [early time-restricted feeding (eTRF)] is a novel type of IF. Objectives We assessed the chronic effects of eTRF compared with an energy-matched control on whole-body and skeletal muscle insulin and anabolic sensitivity. Methods Sixteen healthy males (aged 23 {\textpm} 1 y; BMI 24.0 {\textpm} 0.6 kg{$\cdot$}m-2) were assigned to 2 groups that underwent either 2 wk of eTRF (n = 8) or control/caloric restriction (CON:CR; n = 8) diet. The eTRF diet was consumed ad libitum and the intervention was conducted before the CON:CR, in which the diet was provided to match the reduction in EI and body weight observed in eTRF. During eTRF, daily EI was restricted to between 08:00 and 16:00, which prolonged the overnight fast by {$\sim$}5 h. The metabolic responses to a carbohydrate/protein drink were assessed pre- and post-interventions following a 12-h overnight fast. Results When compared with CON:CR, eTRF improved whole-body insulin sensitivity [between-group difference (95\% CI): 1.89 (0.18, 3.60); P = 0.03; {$\eta$}2p = 0.29] and skeletal muscle uptake of glucose [between-group difference (95\% CI): 4266 (261, 8270) {$\mu$}mol{$\cdot$}min-1{$\cdot$}kg-1{$\cdot$}180 min; P = 0.04; {$\eta$}2p = 0.31] and branched-chain amino acids (BCAAs) [between-group difference (95\% CI): 266 (77, 455) nmol{$\cdot$}min-1{$\cdot$}kg-1{$\cdot$}180 min; P = 0.01; {$\eta$}2p = 0.44]. eTRF caused a reduction in EI ({$\sim$}400 kcal{$\cdot$}d-1) and weight loss (-1.04 {\textpm} 0.25 kg; P = 0.01) that was matched in CON:CR (-1.24 {\textpm} 0.35 kg; P = 0.01). Conclusions Under free-living conditions, eTRF improves whole-body insulin sensitivity and increases skeletal muscle glucose and BCAA uptake. The metabolic benefits of eTRF are independent of its effects on weight loss and represent chronic adaptations rather than the effect of the last bout of overnight fast. This trial was registered at clinicaltrials.gov as NCT03969745.},
  keywords = {body,energy balance and metabolism,free-living intervention,insulin,sensitivity,skeletal muscle,time-restricted feeding}
}

@article{jonesChangesBloodPressure1983,
  title = {Changes in Blood Pressure and Renal Function after Parathyroidectomy in Primary Hyperparathyroidism},
  author = {Jones, D. B. and Jones, J. H. and Lloyd, H. J. and Lucas, P. A. and Wilkins, W. E. and Walker, D. A.},
  year = {1983},
  month = jun,
  journal = {Postgraduate Medical Journal},
  volume = {59},
  number = {692},
  pages = {350--353},
  issn = {0032-5473},
  doi = {10.1136/pgmj.59.692.350},
  abstract = {Changes in blood pressure and renal function were investigated in 62 patients with primary hyperparathyroidism treated surgically, in an attempt to assess whether or not hypertension and renal impairment should be regarded as important indications for parathyroidectomy. 29\% were hypertensive pre-operatively and the blood pressure remained elevated after parathyroidectomy in all of these patients. Hypertension developed for the first time after parathyroidectomy in 45\% of those patients who were normotensive before surgery. Renal function was normal initially in 73\% and mild renal impairment developed after surgery in 9\% of these patients. At the end of the follow-up period, the prevalence of hypertension was higher in patients with renal impairment pre-operatively (88\%) than in those with normal renal function (51\%). We conclude that hypertension alone should not be regarded as an indication for parathyroidectomy in asymptomatic hyperparathyroidism. No firm conclusions can be reached about the importance of mild renal failure as an indication for surgery and the question is unlikely to be resolved without conducting a prospective controlled trial.},
  langid = {english},
  pmcid = {PMC2417520},
  pmid = {6634539},
  keywords = {Blood Pressure,Calcium,Humans,Hyperparathyroidism,Hypertension,Kidney Diseases,Middle Aged,Parathyroid Glands,Postoperative Complications},
  file = {/Users/davebrid/Zotero/storage/I39NQX5Y/Jones et al. - 1983 - Changes in blood pressure and renal function after.pdf}
}

@article{jonesHighfatDietPregnancy2009,
  title = {High-Fat Diet before and during Pregnancy Causes Marked up-Regulation of Placental Nutrient Transport and Fetal Overgrowth in {{C57}}/{{BL6}} Mice},
  author = {Jones, Helen N. and Woollett, Laura A. and Barbour, Nicolette and Prasad, Puttur D. and Powell, Theresa L. and Jansson, Thomas},
  year = {2009},
  month = jan,
  journal = {The FASEB Journal},
  volume = {23},
  number = {1},
  pages = {271--278},
  issn = {0892-6638},
  doi = {10.1096/fj.08-116889},
  abstract = {Maternal overweight and obesity in pregnancy often result in fetal overgrowth, which increases the risk for the baby to develop metabolic syndrome later in life. However, the mechanisms underlying fetal overgrowth are not established. We developed a mouse model and hypothesized that a maternal high-fat (HF) diet causes up-regulation of placental nutrient transport, resulting in fetal overgrowth. C57BL/6J female mice were fed a control (11\% energy from fat) or HF (32\% energy from fat) diet for 8 wk before mating and throughout gestation and were studied at embryonic day 18.5. The HF diet increased maternal adiposity, as assessed by fat pad weight, and circulating maternal leptin, decreased serum adiponectin concentrations, and caused a marked increase in fetal growth (+43\%). The HF diet also increased transplacental transport of glucose (5-fold) and neutral amino acids (10-fold) in vivo. In microvillous plasma membranes (MVMs) isolated from placentas of HF-fed animals, protein expression of glucose transporter 1 (GLUT1) was increased 5-fold, and protein expression of sodium-coupled neutral amino acid transporter (SNAT) 2 was elevated 9-fold. In contrast, MVM protein expression of GLUT 3 or SNAT4 was unaltered. These data suggest that up-regulation of specific placental nutrient transporter isoforms constitute a mechanism linking maternal high-fat diet and obesity to fetal overgrowth.},
  pmid = {18827021}
}

@article{Jonker2012,
  title = {A {{PPAR$\gamma$-FGF1}} Axis Is Required for Adaptive Adipose Remodelling and Metabolic Homeostasis.},
  author = {Jonker, Johan W and Suh, Jae Myoung and Atkins, Annette R and Ahmadian, Maryam and Li, Pingping and Whyte, Jamie and He, Mingxiao and Juguilon, Henry and Yin, Yun-Qiang and Phillips, Colin T and Yu, Ruth T and Olefsky, Jerrold M. and Henry, Robert R and Downes, Michael and Evans, Ronald M.},
  year = {2012},
  month = apr,
  journal = {Nature},
  volume = {485},
  number = {7398},
  eprint = {22522926},
  eprinttype = {pubmed},
  pages = {391--4},
  publisher = {Nature Publishing Group},
  issn = {1476-4687},
  doi = {10.1038/nature10998},
  urldate = {2012-04-26},
  abstract = {Although feast and famine cycles illustrate that remodelling of adipose tissue in response to fluctuations in nutrient availability is essential for maintaining metabolic homeostasis, the underlying mechanisms remain poorly understood. Here we identify fibroblast growth factor 1 (FGF1) as a critical transducer in this process in mice, and link its regulation to the nuclear receptor PPAR{$\gamma$} (peroxisome proliferator activated receptor {$\gamma$}), which is the adipocyte master regulator and the target of the thiazolidinedione class of insulin sensitizing drugs. FGF1 is the prototype of the 22-member FGF family of proteins and has been implicated in a range of physiological processes, including development, wound healing and cardiovascular changes. Surprisingly, FGF1 knockout mice display no significant phenotype under standard laboratory conditions. We show that FGF1 is highly induced in adipose tissue in response to a high-fat diet and that mice lacking FGF1 develop an aggressive diabetic phenotype coupled to aberrant adipose expansion when challenged with a high-fat diet. Further analysis of adipose depots in FGF1-deficient mice revealed multiple histopathologies in the vasculature network, an accentuated inflammatory response, aberrant adipocyte size distribution and ectopic expression of pancreatic lipases. On withdrawal of the high-fat diet, this inflamed adipose tissue fails to properly resolve, resulting in extensive fat necrosis. In terms of mechanisms, we show that adipose induction of FGF1 in the fed state is regulated by PPAR{$\gamma$} acting through an evolutionarily conserved promoter proximal PPAR response element within the FGF1 gene. The discovery of a phenotype for the FGF1 knockout mouse establishes the PPAR{$\gamma$}-FGF1 axis as critical for maintaining metabolic homeostasis and insulin sensitization.},
  pmid = {22522926},
  keywords = {Adipocytes,Adipocytes: drug effects,Adipocytes: metabolism,Adipocytes: pathology,Animals,Base Sequence,Cell Size,Cell Size: drug effects,Diabetes Mellitus,Diet,Experimental,Experimental: chemically induce,Experimental: genetics,Experimental: pathology,Fibroblast Growth Factor 1,Fibroblast Growth Factor 1: deficiency,Fibroblast Growth Factor 1: genetics,Fibroblast Growth Factor 1: metabolism,Genetic,Genetic: genetics,High-Fat,High-Fat: adverse effects,Homeostasis,Homeostasis: drug effects,Humans,Inbred C57BL,Inflammation,Inflammation: genetics,Insulin,Insulin Resistance,Insulin: metabolism,Intra-Abdominal Fat,Intra-Abdominal Fat: drug effects,Intra-Abdominal Fat: metabolism,Intra-Abdominal Fat: pathology,Knockout,Male,Mice,Necrosis,Necrosis: enzymology,PPAR gamma,PPAR gamma: metabolism,Promoter Regions,Response Elements,Response Elements: genetics}
}

