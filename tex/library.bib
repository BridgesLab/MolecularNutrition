  doi = {10.1016/j.tem.2017.04.001},
  abstract = {Unlocking the therapeutic potential of the glucocorticoid receptor (GR) has motivated a search for small molecules that selectively modulate its ability to activate or repress gene transcription. Recently, breakthrough studies in the field of genomics have reinvigorated debate over longstanding transcriptional models explaining how GR controls tissue-specific gene expression. Here, we highlight these genomic studies with the dual goals of advancing understanding of nuclear receptor-mediated transcription and stimulating thought on the development of anti-inflammatory and immunosuppressive ligands for GR that have reduced harmful effects on metabolism.},
