@article{Fagarasanu2010,
  title = {Molecular Mechanisms of Organelle Inheritance: Lessons from Peroxisomes in Yeast.},
  author = {Fagarasanu, Andrei and Mast, Fred D and Knoblach, Barbara and a Rachubinski, Richard},
  year = {2010},
  month = aug,
  journal = {Nature reviews. Molecular cell biology},
  volume = {11},
  number = {9},
  eprint = {20717147},
  eprinttype = {pubmed},
  pages = {644--654},
  publisher = {Nature Publishing Group},
  issn = {1471-0080},
  doi = {10.1038/nrm2960},
  urldate = {2010-08-23},
  abstract = {Preserving a functional set of cytoplasmic organelles in a eukaryotic cell requires a process of accurate organelle inheritance at cell division. Studies of peroxisome inheritance in yeast have revealed that polarized transport of a subset of peroxisomes to the emergent daughter cell is balanced by retention mechanisms operating in both mother cell and bud to achieve an equitable distribution of peroxisomes between them. It is becoming apparent that some common mechanistic principles apply to the inheritance of all organelles, but at the same time, inheritance factors specific for each organelle type allow the cell to differentially and specifically control the inheritance of its different organelle populations.},
  pmid = {20717147}
}

