@article{Zhang2018a,
  title = {Synergetic {{Effects}} of {{Prenatal}} and {{Postnatal High Sucrose Intake}} on {{Glucose Tolerance}} and {{Hepatic Insulin Resistance}} in {{Rat Offspring}}},
  author = {Zhang, Pengjie and Zhu, Di and Zhang, Yueming and Li, Lingjun and Chen, Xionghui and Zhang, Wenna and Shi, Ruixiu and Tao, Jianying and Han, Bing and Xu, Zhice},
  year = {2018},
