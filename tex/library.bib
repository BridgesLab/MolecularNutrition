@article{MacAulay2007b,
  title = {Glycogen {{Synthase Kinase}} 3{$\alpha$}-{{Specific Regulation}} of {{Murine Hepatic Glycogen Metabolism}}},
  author = {MacAulay, Katrina and Doble, Bradley W. and Patel, Satish and Hansotia, Tanya and Sinclair, Elaine M. and Drucker, Daniel J. and Nagy, Andras and Woodgett, James R.},
  year = {2007},
  month = oct,
  journal = {Cell Metabolism},
  volume = {6},
  number = {4},
  eprint = {17908561},
  eprinttype = {pubmed},
  pages = {329--337},
  issn = {15504131},
  doi = {10.1016/j.cmet.2007.08.013},
  urldate = {2014-06-25},
  abstract = {Glycogen synthase kinase 3 comprises two isoforms (GSK-3?? and GSK-3??) that are implicated in type II diabetes, neurodegeneration, and cancer. GSK-3 activity is elevated in human and rodent models of diabetes, and various GSK-3 inhibitors improve glucose tolerance and insulin sensitivity in rodent models of obesity and diabetes. Here, we report the generation of mice lacking GSK-3??. Unlike GSK-3?? mutants, which die before birth, GSK-3?? knockout (GSK-3?? KO) animals are viable but display??enhanced glucose and insulin sensitivity accompanied by reduced fat mass. Fasted and glucose-stimulated hepatic glycogen content was enhanced in GSK-3?? KO mice, whereas muscle glycogen was unaltered. Insulin-stimulated protein kinase B (PKB/Akt) and GSK-3?? phosphorylation was higher in GSK-3?? KO livers compared to wild-type littermates, and IRS-1 expression was markedly increased. We conclude that GSK-3 isoforms exhibit tissue-specific physiological functions and that GSK-3?? KO mice are insulin sensitive, reinforcing the potential of GSK-3 as a therapeutic target for type II diabetes. ?? 2007 Elsevier Inc. All rights reserved.},
  isbn = {1550-4131 (Print){\textbackslash}r1550-4131 (Linking)},
  pmid = {17908561},
  keywords = {Animals,Glucose,Glucose: pharmacology,Glycogen Synthase Kinase 3,Glycogen Synthase Kinase 3: genetics,Glycogen Synthase Kinase 3: metabolism,HUMDISEASE,Insulin,Insulin: pharmacology,Isoenzymes,Isoenzymes: genetics,Isoenzymes: metabolism,Knockout,Liver,Liver Glycogen,Liver Glycogen: analysis,Liver Glycogen: metabolism,Liver: enzymology,Mice,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins c-akt: metabolism}
