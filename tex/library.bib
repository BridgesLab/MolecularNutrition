  author = {Hayashi, Reiko and Okuno, Yosuke and Mukai, Kosuke and Kitamura, Tetsuhiro and Hayakawa, Tomoaki and Onodera, Toshiharu and Murata, Masahiko and Fukuhara, Atsunori and Imamura, Ryoichi and Miyagawa, Yasushi and Nonomura, Norio and Otsuki, Michio and Shimomura, Iichiro},
