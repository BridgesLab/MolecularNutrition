@article{Kelsall2011,
  title = {{{R3F}}, a Novel Membrane-Associated Glycogen Targeting Subunit of Protein Phosphatase 1 Regulates Glycogen Synthase in Astrocytoma Cells in Response to Glucose and Extracellular Signals.},
  author = {Kelsall, Ian R and Voss, Martin and Munro, Shonagh and Cuthbertson, Daniel J R and Cohen, Patricia T W},
  year = {2011},
  month = jun,
  journal = {Journal of neurochemistry},
  volume = {44},
  number = {0},
  eprint = {21668450},
  eprinttype = {pubmed},
  pages = {596--610},
  issn = {1471-4159},
  doi = {10.1111/j.1471-4159.2011.07345.x},
  urldate = {2011-06-21},
  abstract = {Abnormal regulation of brain glycogen metabolism is believed to underlie insulin-induced hypoglycaemia, which may be serious or fatal in diabetic patients on insulin therapy. A key regulator of glycogen levels is glycogen targeted protein phosphatase 1 (PP1), which dephosphorylates and activates glycogen synthase (GS) leading to an increase in glycogen synthesis. Here we show that the gene PPP1R3F expresses a glycogen-binding protein (R3F) of 82.8 kDa, present at the high levels in rodent brain. R3F binds to PP1 through a classical 'RVxF' binding motif and substitution of Phe39 for Ala in this motif abrogates PP1 binding. A hydrophobic domain at the carboxy-terminus of R3F has similarities to the putative membrane binding domain near the carboxy-terminus of striated muscle glycogen targeting subunit G(M) /R(GL) , and R3F is shown to bind not only to glycogen but also to membranes. GS interacts with PP1-R3F and is hyperphosphorylated at GSK3 sites (Ser640 and Ser644) when bound to R3F(Phe39Ala). Deprivation of glucose or stimulation with adenosine or noradrenaline leads to an increased phosphorylation of PP1-R3F bound GS at Ser640 and Ser644 curtailing glycogen synthesis and facilitating glycogen degradation to provide glucose in astrocytoma cells. Adenosine stimulation also modulates phosphorylation of R3F at Ser14/Ser18.},
  pmid = {21668450},
  keywords = {address for correspondence,adenosine,Adenosine: pharmacology,Adrenergic alpha-Agonists,Adrenergic alpha-Agonists: pharmacology,Amino Acid Sequence,Animals,Astrocytoma,Astrocytoma: enzymology,Astrocytoma: genetics,Brain,brain glycogen,Brain Neoplasms,Brain Neoplasms: enzymology,Brain Neoplasms: genetics,Brain: drug effects,Brain: enzymology,Carrier Proteins,Carrier Proteins: genetics,Carrier Proteins: physiology,Cell Line,cohen,diabetes,DNA,DNA: biosynthesis,DNA: genetics,Extracellular Space,Extracellular Space: physiology,Glucose,Glucose: pharmacology,Glycogen,Glycogen Synthase,Glycogen Synthase: biosynthesis,glycogen targeting subunit,Glycogen: metabolism,Humans,Immunohistochemistry,Inbred C57BL,Male,Mice,Molecular Sequence Data,Mutagenesis,Norepinephrine,Norepinephrine: pharmacology,Phosphoprotein Phosphatases,Phosphoprotein Phosphatases: genetics,Phosphoprotein Phosphatases: physiology,Phosphorylation,professor p,protein phosphatase 1,Protein Phosphatase 1: genetics,Protein Phosphatase 1: physiology,RNA,RNA: biosynthesis,RNA: genetics,signal transduction,Signal Transduction: drug effects,Subcellular Fractions,Subcellular Fractions: drug effects,Subcellular Fractions: metabolism,t,Tumor,w}
}

