@article{Delany2013,
  title = {High Energy Expenditure Masks Low Physical Activity in Obesity.},
  author = {DeLany, J P and Kelley, David E. and Hames, K C and Jakicic, John M. and Goodpaster, Bret H.},
  year = {2013},
  month = jul,
  journal = {International journal of obesity (2005)},
  volume = {37},
  number = {7},
  eprint = {23090575},
  eprinttype = {pubmed},
  pages = {1006--11},
  publisher = {Nature Publishing Group},
  issn = {1476-5497},
  doi = {10.1038/ijo.2012.172},
  urldate = {2013-07-11},
  abstract = {Objective:To investigate energy expenditure in lean and obese individuals, focusing particularly on physical activity and severely obese individuals.Design:Total daily energy expenditure (TDEE) was assessed using doubly labeled water, resting metabolic rate (RMR) by indirect calorimetry, activity energy expenditure (AEE) by difference and time spent in physical activity by multisensor activity monitors.Subjects:In all, 177 lean, Class I and severely obese individuals (age 31-56 years, body mass index 20-64\,kg\,m(-2)) were analyzed.Results:All components of energy expenditure were elevated in obese individuals. For example, TDEE was 2404{\textpm}95\,kcal per day in lean and 3244{\textpm}48\,kcal per day in Class III obese individuals. After appropriate adjustment, RMR was similar in all groups. Analysis of AEE by body weight and obesity class indicated a lower AEE in obese individuals. Confirming lower physical activity, obese individuals spent less time engaged in moderate-to-vigorous physical activity (2.7{\textpm}1.3, 1.8{\textpm}0.6, 2.0{\textpm}1.4 and 1.2{\textpm}1.0\,h per day in lean, Class I, Class II and Class III individuals) and more time in sedentary behaviors.Conclusions:There was no indication of metabolic efficiency in even the severely obese, as adjusted RMR was similar across all groups. The higher AEE observed in the obese is consistent with a higher cost of activities due to higher body weight. However, the magnitude of the higher AEE (20-25\% higher in obese individuals) is lower than expected (weight approximately 100\% higher in Class III individuals). Confirming a lower volume of physical activity in the obese, the total time spent in moderate-to-vigorous physical activity and average daily metabolic equivalent of task level were lower with increasing obesity. These findings demonstrate that high body weight in obese individuals leads to a high TDEE and AEE, which masks the fact that they are less physically active, which can be influenced by duration or intensity of activity, than in lean individuals.},
  pmid = {23090575},
  keywords = {activity patterns,Adult,Calorimetry,Cross-Sectional Studies,doubly labeled water,energy expenditure,Energy Metabolism,Exercise,Female,Humans,Indirect,Male,Middle Aged,Morbid,Morbid: epidemiology,Morbid: metabolism,Morbid: physiopathology,Obesity,physical activity,Physical Exertion,resting metabolic rate,Thinness,Thinness: epidemiology,Thinness: metabolism,Thinness: physiopathology,Time Factors,United States,United States: epidemiology}
}

@article{Delany2014,
  title = {Effect of Physical Activity on Weight Loss, Energy Expenditure, and Energy Intake during Diet Induced Weight Loss},
  author = {Delany, James P. and Kelley, David E. and Hames, Kazanna C. and Jakicic, John M. and Goodpaster, Bret H.},
  year = {2014},
  journal = {Obesity},
  volume = {22},
  number = {2},
  pages = {363--370},
  issn = {19307381},
  doi = {10.1002/oby.20525},
  abstract = {OBJECTIVE: Objective measurements of physical activity (PA), energy expenditure (EE) and energy intake can provide valuable information regarding appropriate strategies for successful sustained weight loss.{\textbackslash}n{\textbackslash}nDESIGN AND METHODS: The total EE was examined by doubly labeled water, resting metabolic rate by indirect calorimetry, PA with activity monitors, and energy intake by the intake/balance technique in 116 severely obese undergoing intervention with diet alone (DO) or diet plus PA (D-PA).{\textbackslash}n{\textbackslash}nRESULTS: Weight loss of 9.6\,{\textpm}\,6.8 kg resulted in decreased EE which was not minimized in the D-PA group. Comparing the highest and lowest quartiles of increase in PA revealed a lower decrease in TDEE (-122\,{\textpm}\,319 vs. -376\,{\textpm}\,305 kcal day{$^{-1}$}), elimination of the drop in AEE (83\,{\textpm}\,279 vs. -211\,{\textpm}\,284 kcal day{$^{-1}$}) and greater weight loss (13.0\,{\textpm}\,7.0 vs. 8.1\,{\textpm}\,6.3 kg). Increased PA was associated with greater adherence to energy restriction and maintenance of greater weight loss during months 7-12.{\textbackslash}n{\textbackslash}nCONCLUSION: Noncompliance to prescribed PA in the DO and D-PA groups partially masked the effects of PA to increase weight loss and to minimize the reduced EE. Increased PA was also associated with improved adherence to prescribed caloric restriction. A strong recommendation needs to be made to improve interventions that promote PA within the context of behavioral weight loss interventions.},
  arxiv = {15334406},
  isbn = {1930-739X (Electronic){\textbackslash}r1930-7381 (Linking)},
  pmid = {23804562}
}

@article{DeLartigue2009,
  title = {{{PIKfyve}} Regulation of Endosome-Linked Pathways},
  author = {{de Lartigue}, J and Polson, H and Feldman, M and Shokat, Kevan M. and Tooze, S A and Urbe, S and Clague, M J},
  year = {2009},
  journal = {Traffic},
  volume = {10},
  number = {7},
  pages = {883--893},
  abstract = {The phosphoinositide 5-kinase (PIKfyve) is a critical enzyme for the synthesis of PtdIns(3,5)P2, that has been implicated in various trafficking events associated with the endocytic pathway. We have now directly compared the effects of siRNA-mediated knockdown of PIKfyve in HeLa cells with a specific pharmacological inhibitor of enzyme activity. Both approaches induce changes in the distribution of CI-M6PR and trans-Golgi network (TGN)-46 proteins, which cycles between endosomes and TGN, leading to their accumulation in dispersed punctae, whilst the TGN marker golgin-245 retains a perinuclear disposition. Trafficking of CD8-CI-M6PR (retromer-dependent) and CD8-Furin (retromer-independent) chimeras from the cell surface to the TGN is delayed following drug administration, as is the transport of the Shiga toxin B-subunit. siRNA knockdown of PIKfyve produced no defect in epidermal growth factor receptor (EGFR) degradation, unless combined with knockdown of its activator molecule Vac14, suggesting that a low threshold of PtdIns(3,5)P2 is necessary and sufficient for this pathway. Accordingly pharmacological inhibition of PIKfyve results in a profound block to the lysosomal degradation of activated epidermal growth factor (EGF) and Met receptors. Immunofluorescence revealed EGF receptors to be trapped in the interior of a swollen endosomal compartment. In cells starved of amino acids, PIKfyve inhibition leads to the accumulation of the lipidated form of GFP-LC3, a marker of autophagosomal structures, which can be visualized as fluorescent punctae. We suggest that PIKfyve inhibition may render the late endosome/lysosome compartment refractory to fusion with both autophagosomes and with EGFR-containing multivesicular bodies.},
  isbn = {1600-0854 (Electronic)},
  keywords = {1-Phosphatidylinositol 3-Kinase/antagonists &,Androstadienes/metabolism,Animals,Antigens CD8/metabolism,Autophagy/physiology,Endosomes/*metabolism,Furin/metabolism,Hela Cells,Humans,inhibitors/genetics/*metabolism,Membrane Glycoproteins/metabolism,Microtubule-Associated Proteins/genetics/metabolis,Molecular Structure,Protein Kinase Inhibitors/metabolism,Receptor Epidermal Growth Factor/metabolism,Receptor Protein-Tyrosine Kinases/metabolism,Receptors Cytoplasmic and Nuclear/metabolism,Recombinant Fusion Proteins/genetics/metabolism,RNA Small Interfering/genetics/metabolism,Shiga Toxin 2/metabolism,trans-Golgi Network/*metabolism,Vacuoles/metabolism}
}

@article{Delarue2018,
  title = {{{mTORC1 Controls Phase Separation}} and the {{Biophysical Properties}} of the {{Cytoplasm}} by {{Tuning Crowding}}},
  author = {Delarue, M. and Brittingham, G. P. and Pfeffer, S. and Surovtsev, I. V. and Pinglay, S. and Kennedy, K. J. and Schaffer, M. and Gutierrez, J. I. and Sang, D. and Poterewicz, G. and Chung, J. K. and Plitzko, J. M. and Groves, J. T. and {Jacobs-Wagner}, C. and Engel, B. D. and Holt, L. J.},
  year = {2018},
  journal = {Cell},
  pages = {1--12},
  publisher = {Elsevier Inc.},
  issn = {10974172},
  doi = {10.1016/j.cell.2018.05.042},
  abstract = {Macromolecular crowding has a profound impact on reaction rates and the physical properties of the cell interior, but the mechanisms that regulate crowding are poorly understood. We developed genetically encoded multimeric nanoparticles (GEMs) to dissect these mechanisms. GEMs are homomultimeric scaffolds fused to a fluorescent protein that self-assemble into bright, stable particles of defined size and shape. By combining tracking of GEMs with genetic and pharmacological approaches, we discovered that the mTORC1 pathway can modulate the effective diffusion coefficient of particles {$\geq$}20 nm in diameter more than 2-fold by tuning ribosome concentration, without any discernable effect on the motion of molecules {$\leq$}5 nm. This change in ribosome concentration affected phase separation both in vitro and in vivo. Together, these results establish a role for mTORC1 in controlling both the mesoscale biophysical properties of the cytoplasm and biomolecular condensation. mTORC1 signaling controls phase transitions in the cytoplasm through its effects on molecular crowding.},
  pmid = {29937223},
  keywords = {biophysics,cytoplasm,electron tomography,microrheology,molecular crowding,mTORC1,nanoparticles,phase separation,ribosomes,systems biology}
}

