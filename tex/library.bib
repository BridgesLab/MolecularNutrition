  author = {Kazak, Lawrence and Chouchani, Edward~T. T. and Jedrychowski, Mark~P. P. and Erickson, Brian~K. K. and Shinoda, Kosaku and Cohen, Paul and Vetrivelan, Ramalingam and Lu, Gina~Z. Z. and {Laznik-Bogoslavski}, Dina and Hasenfuss, Sebastian~C. C. and Kajimura, Shingo and Gygi, Steven P. and Spiegelman, Bruce~M.},
