  urldate = {2012-01-26},
  abstract = {The lipid phosphatase known as SH2 domain-containing inositol 5'-phosphatase 2 (SHIP2) plays an important role in the regulation of the intracellular insulin signalling pathway. Recent studies have suggested that inhibition of SHIP2 could produce significant benefits in treatment of type 2 diabetes. However, there were no small molecule SHIP2 inhibitors and we, therefore, aimed to identify this type of compound.},
