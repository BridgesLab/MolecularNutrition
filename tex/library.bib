@article{Fraenkel2008,
  title = {{{mTOR}} Inhibition by Rapamycin Prevents Beta-Cell Adaptation to Hyperglycemia and Exacerbates the Metabolic State in Type 2 Diabetes.},
  author = {Fraenkel, Merav and {Ketzinel-Gilad}, Mali and Ariav, Yafa and Pappo, Orit and Karaca, Melis and Castel, Julien and Berthault, Marie-france and Magnan, Christophe and Cerasi, Erol and Kaiser, Nurit and Leibowitz, Gil},
