@article{sarantosPizotifenActivatesERK2012,
  title = {Pizotifen {{Activates ERK}} and {{Provides Neuroprotection}} in Vitro and in Vivo in {{Models}} of {{Huntington}}'s {{Disease}}},
  author = {Sarantos, Melissa R. and Papanikolaou, Theodora and Ellerby, Lisa M. and Hughes, Robert E.},
  year = {2012},
  month = jan,
  journal = {J Huntington's Dis.},
  volume = {1},
  number = {2},
  pages = {195--210},
  issn = {1879-6400 (Electronic)},
  doi = {10.3233/JHD-120033.Pizotifen},
  urldate = {2014-11-12},
  abstract = {Background---Huntington's disease (HD) is a dominantly inherited neurodegenerative condition characterized by dysfunction in striatal and cortical neurons. There are currently no approved drugs known to slow the progression of HD. Objective---To facilitate the development of therapies for HD, we identified approved drugs that can ameliorate mutant huntingtin-induced toxicity in experimental models of HD. Methods---A chemical screen was performed in a mouse Q111/Q111 striatal cell model of HD. This screen identified a set of structurally related approved drugs (pizotifen, cyproheptadine, and Hdh loxapine) that rescued cell death in this model. Pizotifen was subsequently evaluated in the R6/2 HD mouse model. Results---We found that in striatal Q111/Q111 cells, pizotifen treatment caused transient ERK activation and inhibition of ERK activation prevented rescue of cell death in this model. In the Hdh R6/2 HD mouse model, treatment with pizotifen activated ERK in the striatum, reduced neurodegeneration and significantly enhanced motor performance. Conclusions---These results suggest that pizotifen and related approved drugs may provide a basis for developing disease modifying therapeutic interventions for HD.},
  pmid = {23393546},
  keywords = {2 hd mouse model,drug screening,Drug Screening,erk pathway,ERK Pathway,huntington,Huntington's disease,pizotifen,Pizotifen,r6,R6/2 HD mouse model,s disease}
}

