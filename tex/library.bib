@article{Turton1996,
  title = {A Role for Glucagon-like Peptide-1 in the Central Regulation of Feeding.},
  author = {Turton, M D and O'Shea, D and Gunn, I and Beak, S A and Edwards, C M and Meeran, K and Choi, S J and Taylor, G M and Heath, M M and Lambert, P D and Wilding, J P and Smith, D M and Ghatei, M A and Herbert, J and Bloom, S R},
  year = {1996},
  month = jan,
  journal = {Nature},
  volume = {379},
  number = {6560},
  eprint = {8538742},
  eprinttype = {pubmed},
  pages = {69--72},
  issn = {0028-0836},
  doi = {10.1038/379069a0},
  urldate = {2014-10-28},
  abstract = {The sequence of glucagon-like peptide-1 (7-36) amide (GLP-1) is completely conserved in all mammalian species studied, implying that it plays a critical physiological role. We have shown that GLP-1 and its specific receptors are present in the hypothalamus. No physiological role for central GLP-1 has been established. We report here that intracerebroventricular (ICV) GLP-1 powerfully inhibits feeding in fasted rats. ICV injection of the specific GLP-1-receptor antagonist, exendin (9-39), blocked the inhibitory effect of GLP-1 on food intake. Exendin (9-39) alone had no influence on fast-induced feeding but more than doubled food intake in satiated rats, and augmented the feeding response to the appetite stimulant, neuropeptide Y. Induction of c-fos is a marker of neuronal activation. Following ICV GLP-1 injection, c-fos appeared exclusively in the paraventricular nucleus of the hypothalamus and central nucleus of the amygdala, and this was inhibited by prior administration of exendin (9-39). Both of these regions of the brain are of primary importance in the regulation of feeding. These findings suggest that central GLP-1 is a new physiological mediator of satiety.},
  pmid = {8538742},
  keywords = {Animals,Cerebral Ventricles,Cerebral Ventricles: physiology,Eating,Eating: physiology,GLP-1,Glucagon,Glucagon-Like Peptide 1,Glucagon-Like Peptides,Injections,Intraventricular,Male,Neuropeptide Y,Neuropeptide Y: pharmacology,Peptide Fragments,Peptide Fragments: administration & dosage,Peptide Fragments: antagonists & inhibitors,Peptide Fragments: pharmacology,Peptide Fragments: physiology,Proto-Oncogene Proteins c-fos,Proto-Oncogene Proteins c-fos: metabolism,Rats,Satiation,Satiation: physiology}
}

