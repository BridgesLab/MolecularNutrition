  keywords = {Animals,Diabetes Mellitus Type 2,Diabetes Mellitus Type 2: enzymology,Diabetes Mellitus Type 2: genetics,Gene Dosage,Gene Dosage: physiology,Humans,Insulin Resistance,Insulin Resistance: genetics,Insulin Resistance: physiology,Isoenzymes,Isoenzymes: genetics,Isoenzymes: physiology,Metabolic Syndrome X,Metabolic Syndrome X: enzymology,Metabolic Syndrome X: genetics,Mice,Mice Knockout,Models Biological,pkc,Protein Kinase C,Protein Kinase C: genetics,Protein Kinase C: physiology}
