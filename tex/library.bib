@article{Zwick2018a,
  title = {Adipocyte Hypertrophy and Lipid Dynamics Underlie Mammary Gland Remodeling after Lactation},
  author = {Zwick, Rachel K. and Rudolph, Michael C. and Shook, Brett A. and Holtrup, Brandon and Roth, Eve and Lei, Vivian and Van Keymeulen, Alexandra and Seewaldt, Victoria and Kwei, Stephanie and Wysolmerski, John and Rodeheffer, Matthew~S. and Horsley, Valerie},
  year = {2018},
  journal = {Nature Communications},
  volume = {9},
  number = {1},
  pages = {3592},
  publisher = {Springer US},
  issn = {2041-1723},
  doi = {10.1038/s41467-018-05911-0},
  abstract = {Adipocytes undergo pronounced changes in size and behavior to support diverse tissue functions, but the mechanisms that control these changes are not well understood. Mammary gland-associated white adipose tissue (mgWAT) regresses in support of milk fat production during lactation and expands during the subsequent involution of milk-producing epithelial cells, providing one of the most marked physiological examples of adipose growth. We examined cellular mechanisms and functional implications of adipocyte and lipid dynamics in the mouse mammary gland (MG). Using in vivo analysis of adipocyte precursors and genetic tracing of mature adipocytes, we find mature adipocyte hypertrophy to be a primary mechanism of mgWAT expansion during involution. Lipid tracking and lipidomics demonstrate that adipocytes fill with epithelial-derived milk lipid. Furthermore, ablation of mgWAT during involution reveals an essential role for adipocytes in milk trafficking from, and proper restructuring of, the mammary epithelium. This work advances our understanding of MG remodeling and tissue-specific roles for adipocytes.},
  isbn = {4146701805},
  keywords = {Cell growth,Cell proliferation,Developmental biology,Stem cells}
}

