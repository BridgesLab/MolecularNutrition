@article{Ktistakis2012,
  title = {How Phosphoinositide 3-Phosphate Controls Growth Downstream of Amino Acids and Autophagy Downstream of Amino Acid Withdrawal},
  author = {Ktistakis, Nicholas~T. and Manifava, Maria and Schoenfelder, Priya and Rotondo, Sergio},
