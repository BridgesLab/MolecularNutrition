@article{Galvez2007,
  title = {{{siRNA}} Screen of the Human Signaling Proteome Identifies the {{PtdIns}}(3,4,5){{P3-mTOR}} Signaling Pathway as a Primary Regulator of Transferrin Uptake.},
  author = {Galvez, Thierry and Teruel, Mary N and Heo, Won Do and Jones, Joshua T and Kim, Man Lyang and Liou, Jen and Myers, Jason W and Meyer, Tobias},
  year = {2007},
  month = jan,
  journal = {Genome biology},
  volume = {8},
  number = {7},
  pages = {R142},
  issn = {1465-6914},
  doi = {10.1186/gb-2007-8-7-r142},
  urldate = {2010-08-18},
  abstract = {BACKGROUND: Iron uptake via endocytosis of iron-transferrin-transferrin receptor complexes is a rate-limiting step for cell growth, viability and proliferation in tumor cells as well as non-transformed cells such as activated lymphocytes. Signaling pathways that regulate transferrin uptake have not yet been identified. RESULTS: We surveyed the human signaling proteome for regulators that increase or decrease transferrin uptake by screening 1,804 dicer-generated signaling small interfering RNAs using automated quantitative imaging. In addition to known transport proteins, we identified 11 signaling proteins that included a striking signature set for the phosphatidylinositol-3,4,5-trisphosphate (PtdIns(3,4,5)P3)-target of rapamycin (mTOR) signaling pathway. We show that the PI3K-mTOR signaling pathway is a positive regulator of transferrin uptake that increases the number of transferrin receptors per endocytic vesicle without affecting endocytosis or recycling rates. CONCLUSION: Our study identifies the PtdIns(3,4,5)P3-mTOR signaling pathway as a new regulator of iron-transferrin uptake and serves as a proof-of-concept that targeted RNA interference screens of the signaling proteome provide a powerful and unbiased approach to discover or rank signaling pathways that regulate a particular cell function.},
  pmid = {17640392},
  keywords = {endocytosis,Endocytosis,Endocytosis: drug effects,high-throughput,Humans,mTOR,Phosphatidylinositol Phosphates,Phosphatidylinositol Phosphates: physiology,Protein Kinases,Protein Kinases: genetics,Protein Kinases: physiology,Protein Transport,Protein Transport: drug effects,Proteome,Proteome: genetics,Proteome: physiology,Proteomics,Proteomics: methods,RNA Interference,RNA Small Interfering,RNA Small Interfering: genetics,RNA Small Interfering: pharmacology,Signal Transduction,siRNA,Transfection,Transferrin,Transferrin: metabolism}
}

