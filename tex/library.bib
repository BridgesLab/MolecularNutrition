@article{Kleinert2018,
  title = {Exercise Increases Circulating {{GDF15}} in Humans},
  author = {Kleinert, Maximilian and Clemmensen, Christoffer and Sj{\o}berg, Kim A. and Carl, Christian Strini and Jeppesen, Jacob Fuglsbjerg and Wojtaszewski, J{\o}rgen F.P. and Kiens, Bente and Richter, Erik A.},
  year = {2018},
  journal = {Molecular Metabolism},
  volume = {9},
  number = {January},
  pages = {187--191},
  publisher = {Elsevier GmbH},
  issn = {22128778},
  doi = {10.1016/j.molmet.2017.12.016},
  abstract = {Objective: The growth differentiation factor 15 (GDF15) is a stress-sensitive circulating factor that regulates systemic energy balance. Since exercise is a transient physiological stress that has pleiotropic effects on whole-body energy metabolism, we herein explored the effect of exercise on a) circulating GDF15 levels and b) GDF15 release from skeletal muscle in humans. Methods: Seven healthy males either rested or exercised at 67\% of their VO2maxfor 1 h and blood was sampled from the femoral artery and femoral vein before, during, and after exercise. Plasma GDF15 concentrations were determined in these samples. Results: Plasma GDF15 levels increased 34\% with exercise (p {$<$} 0.001) and further increased to 64\% above resting values at 120 min (p {$<$} 0.001) after the cessation of exercise. There was no difference between the arterial and venous GDF15 concentration before, during, and after exercise. During a resting control trial, GDF15 levels measured in the same subjects were unaltered. Conclusions: Vigorous submaximal exercise increases circulating GDF15 levels in humans, but skeletal muscle tissue does not appear to be the source.},
  pmid = {29398617},
  keywords = {exercise,GDF15,Growth differentiation factor 15,Physical activity,Recovery,Skeletal muscle}
}

@article{Kleinert2019a,
  title = {Glucagon Regulation of Energy Expenditure},
  author = {Kleinert, Maximilian and Sachs, Stephan and Habegger, Kirk M. and Hofmann, Susanna M. and M{\"u}ller, Timo D.},
  year = {2019},
  journal = {International Journal of Molecular Sciences},
  volume = {20},
  number = {21},
  pages = {1--12},
  issn = {14220067},
  doi = {10.3390/ijms20215407},
  abstract = {Glucagon's ability to increase energy expenditure has been known for more than 60 years, yet the mechanisms underlining glucagon's thermogenic effect still remain largely elusive. Over the last years, significant efforts were directed to unravel the physiological and cellular underpinnings of how glucagon regulates energy expenditure. In this review, we summarize the current knowledge on how glucagon regulates systems metabolism with a special emphasis on its acute and chronic thermogenic effects.},
  pmid = {31671603},
  keywords = {Brown adipose tissue,Energy expenditure,FGF21,Glucagon,Obesity,Pharmacology}
}

