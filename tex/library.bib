@article{Lefterova2014,
  title = {{{PPAR}}?? And the Global Map of Adipogenesis and Beyond},
  author = {Lefterova, Martina I. and Haakonsson, Anders K. and a. Lazar, Mitchell and Mandrup, Susanne},
  year = {2014},
  journal = {Trends in Endocrinology \& Metabolism},
  volume = {25},
  number = {6},
  pages = {293--302},
  issn = {18793061},
  doi = {10.1016/j.tem.2014.04.001},
  abstract = {Peroxisome proliferator-activated receptor ?? (PPAR??) is a member of the nuclear receptor (NR) superfamily of ligand-dependent transcription factors (TFs) and function as a master regulator of adipocyte differentiation and metabolism. We review recent breakthroughs in the understanding of PPAR?? gene regulation and function in the chromatin context. It is now clear that multiple TFs team up to induce PPAR?? during adipogenesis, and that other TFs cooperate with PPAR?? to ensure adipocyte-specific genomic binding and function. We discuss how this differs in other PPAR??-expressing cells such as macrophages and how these genome-wide mechanisms are preserved across species despite modest conservation of specific binding sites. These emerging considerations inform our understanding of PPAR?? function as well as of adipocyte development and physiology. ?? 2014.},
  pmid = {24793638},
  keywords = {Adipogenesis,Chromatin,Genome-wide analyses,PPAR??,Transcriptional network}
}

