@article{Funder2017a,
  title = {Apparent Mineralocorticoid Excess},
  author = {Funder, John W.},
  year = {2017},
  journal = {Journal of Steroid Biochemistry and Molecular Biology},
  volume = {165},
  number = {2015},
  pages = {151--153},
  publisher = {Elsevier Ltd},
  issn = {18791220},
  doi = {10.1016/j.jsbmb.2016.03.010},
  abstract = {Apparent mineralocorticoid excess is a syndrome reflecting the absent or impaired activity of the enzyme 11??-hydroxysteroid dehydrogenase Type 2. It may be mild when the mutant enzyme retains some activity, or severe when activity is absolutely or essentially absent. Diagnosis relies on a triad of hypertension, hypokalemia and suppressed plasma aldosterone levels, plus an abnormal urinary cortisol to cortisone ratio, either free steroid or metabolites. Treatment is symptomatic in the mild form ??? correction of hypertension and hypokalemia ??? but needs to be prompt, vigorous and sustained in the severe form, which usually presents in neonates/infancy. Elucidation of the pathogenesis of apparent mineralocorticoid excess is an example of ???reverse translation???, in that it proved prismatic for the demonstration of the physiologic mechanisms underlying the selective activation of epithelial mineralocorticoid receptors by aldosterone.},
  isbn = {9780124160064},
  pmid = {8575412},
  keywords = {11??hydroxysteroid dehydrogenase type 2,Aldosterone,Cortisol,Mineralocorticoid receptors,Urinary steroid metabolites}
}

@article{Funderburk2010,
  title = {The {{Beclin}} 1-{{VPS34}} Complex - at the Crossroads of Autophagy and Beyond.},
  author = {Funderburk, Sarah F and Wang, Qing Jun and Yue, Zhenyu},
  year = {2010},
  month = jun,
  journal = {Trends in cell biology},
  volume = {20},
  number = {6},
  eprint = {20356743},
  eprinttype = {pubmed},
  pages = {355--362},
  publisher = {Elsevier Ltd},
  issn = {1879-3088},
  doi = {10.1016/j.tcb.2010.03.002},
  urldate = {2010-06-24},
  abstract = {An increasing body of research on autophagy provides overwhelming evidence for its connection to diverse biological functions and human diseases. Beclin 1, the first mammalian autophagy protein to be described, appears to act as a nexus point between autophagy, endosomal, and perhaps also cell death pathways. Beclin 1 performs these roles as part of a core complex that contains vacuolar sorting protein 34 (VPS34), a class III phosphatidylinositol-3 kinase. The precise mechanism of Beclin 1-mediated regulation of these cellular functions is unclear, but substantial progress has recently been made in identifying new players and their functions in Beclin 1-VSP34 complexes. Here we review emerging studies that are beginning to unveil the physiological functions of Beclin 1-VPS34 in the central control of autophagic activity and other trafficking events through the formation of distinct Beclin 1-VPS34 protein complexes.},
  pmid = {20356743}
}

