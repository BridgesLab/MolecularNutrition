@article{Mattar2010,
  title = {Stimulation of Postprandial in Vivo Glycogenesis and Lipogenesis of Rats Fed High Fructose Diet with Varied Phosphate Content.},
  author = {Mattar, Lama E and a Mattar, Melanie and Batal, Malek and Mouneimne, Youssef and a Obeid, Omar},
  year = {2010},
  month = feb,
  journal = {Nutrition research (New York, N.Y.)},
  volume = {30},
  number = {2},
  eprint = {20227001},
  eprinttype = {pubmed},
  pages = {151--5},
  publisher = {Elsevier Inc.},
  issn = {1879-0739},
  doi = {10.1016/j.nutres.2009.12.004},
  urldate = {2012-08-02},
  abstract = {It has been reported that increased fructose intake is associated with the development of the metabolic syndrome. The phosphate (P) sequestering capacity of fructose is likely to affect the phosphorylation capacity of different metabolites, and this, in turn, may be the basis for several metabolic derangements, especially in the P requiring reactions, for example, glycogenesis and lipogenesis. We hypothesized that P enrichment of the diet can balance P status and, consequently, affect glycogenesis and lipogenesis. An animal experiment was executed in which adult male Sprague-Dawley rats were maintained for 4 days on high-fructose diets with different P content (0.15\%, 0.165\%, 0.30\%, and 1.65\%). At the end of the feeding period, overnight fasted rats were tube fed a test meal, injected with (3)H(2)O and euthanized 1 hour later. Final plasma glucose, insulin, uric acid, and triacylglycerol concentrations, as well as in vivo rates of glycogen and lipid synthesis and hepatic glycogen content, were measured. Results showed that increased P content of the diet was associated with an increase in postprandial epididymal fat pad (P = .007) and hepatic lipogenesis (P = .029), as well as glycogenesis (P = .024). In conclusion, P content of the diet was found to stimulate both glycogenesis and lipogenesis. These alterations in carbohydrate and fat metabolism point to the potential of P in influencing nutritional status.},
  pmid = {20227001},
  keywords = {Adipose Tissue,Adipose Tissue: metabolism,Animals,Dietary Sucrose,Dietary Sucrose: administration & dosage,Dietary Sucrose: metabolism,Dose-Response Relationship Drug,Food Fortified,Fructose,Fructose: pharmacology,Lipid Metabolism,Lipogenesis,Lipogenesis: drug effects,Liver,Liver Glycogen,Liver Glycogen: biosynthesis,Liver: metabolism,Male,Phosphates,Phosphates: pharmacology,Postprandial Period,Rats,Rats Sprague-Dawley}
}

