@article{Boronenkov1995,
  title = {The Sequence of Phosphatidylinositol-4-Phosphate 5-Kinase Defines a Novel Family of Lipid Kinases.},
  author = {Boronenkov, I V and Anderson, Richard~A.},
  year = {1995},
  month = feb,
  journal = {The Journal of biological chemistry},
  volume = {270},
  number = {7},
  eprint = {7852364},
  eprinttype = {pubmed},
  pages = {2881--4},
  issn = {0021-9258},
  urldate = {2012-01-27},
  abstract = {Phosphatidylinositol 4,5-bisphosphate (PtdIns(4,5)P2) occupies an essential position in the phosphoinositide signal transduction cascades as the precursor to second messengers and is thought to regulate many cellular proteins directly. The final step in the synthesis of PtdIns(4,5)P2 is the phosphorylation of PtdIns(4)P- by PtdIns(4)P 5-kinase (PIP5K). Using peptide sequences from a purified PIP5K, a cDNA for a human placental PIP5K was isolated and sequenced. Expression of this cDNA in Escherichia coli produced an active PIP5K. Surprisingly, the sequence of this PIP5K has no homology to known PtdIns kinases or protein kinases. However, the PIP5K is homologous to the Saccharomyces cerevisiae proteins Fab1p and Mss4p.},
  pmid = {7852364},
  keywords = {Amino Acid,Amino Acid Sequence,Base Sequence,Cloning,Complementary,DNA,Erythrocytes,Erythrocytes: enzymology,Escherichia coli,Female,Humans,Molecular,Molecular Sequence Data,Phosphotransferases (Alcohol Group Acceptor),Phosphotransferases (Alcohol Group Acceptor): bios,Phosphotransferases (Alcohol Group Acceptor): chem,Phosphotransferases (Alcohol Group Acceptor): isol,pi45p2,pip5k,Placenta,Placenta: enzymology,Pregnancy,Recombinant Proteins,Recombinant Proteins: biosynthesis,Recombinant Proteins: chemistry,Recombinant Proteins: isolation & purification,Saccharomyces cerevisiae,Saccharomyces cerevisiae: enzymology,Saccharomyces cerevisiae: genetics,Sequence Homology}
}

