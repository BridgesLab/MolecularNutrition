  issn = {00085472},
  doi = {10.1158/0008-5472.CAN-05-4067},
  abstract = {Macrophage inhibitory cytokine-1 (MIC-1), a transforming growth factor-beta superfamily cytokine, is involved in tumor pathogenesis, and its measurement can be used as a clinical tool for the diagnosis and management of a wide range of cancers. Although generally considered to be part of the cell's antitumorigenic repertoire, MIC-1 secretion, processing, and latent storage suggest a complex, dynamic variability in MIC-1 bioavailability in the tumor microenvironment, potentially modulating tumor progression and invasiveness.},
