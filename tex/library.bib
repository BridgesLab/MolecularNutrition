@article{birchDIAMONDDHAIntake2010,
  title = {The {{DIAMOND}} ({{DHA Intake}} and {{Measurement}} of {{Neural Development}}) {{Study}}: {{A}} Double-Masked, Randomized Controlled Clinical Trial of the Maturation of Infant Visual Acuity as a Function of the Dietary Level of Docosahexaenoic Acid},
  author = {Birch, Eileen E. and Carlson, Susan E. and Hoffman, Dennis R. and {Fitzgerald-Gustafson}, Kathleen M. and Fu, Valeria L.N. and Drover, James R. and Casta{\~n}eda, Yolanda S. and Minns, Laura and Wheaton, Dianna K.H. and Mundy, David and Marunycz, John and {Diersen-Schade}, Deborah A.},
