@article{Resh2012,
  title = {Targeting Protein Lipidation in Disease.},
  author = {Resh, Marilyn D},
  year = {2012},
  month = feb,
  journal = {Trends in molecular medicine},
  volume = {18},
  number = {4},
  eprint = {22342806},
  eprinttype = {pubmed},
  pages = {206--214},
  publisher = {Elsevier Ltd},
  issn = {1471-499X},
  doi = {10.1016/j.molmed.2012.01.007},
  urldate = {2012-04-06},
  abstract = {Fatty acids and/or isoprenoids are covalently attached to a variety of disease-related proteins. The distinct chemical properties of each of these hydrophobic moieties allow lipid modification to serve as a mechanism to regulate protein structure, localization and function. This review highlights recent progress in identifying inhibitors of protein lipidation and their effects on human disease. Myristoylation inhibitors have shown promise in blocking the action of human pathogens. Although inhibitors that block prenylation of Ras proteins have not yet been successful for cancer treatment, they may be efficacious in the rare premature aging syndrome progeria. Agents that alter the palmitoylation status of Ras, Wnt and Hh proteins have recently been discovered, and represent the next generation of potential chemotherapeutics.},
  pmid = {22342806}
}

