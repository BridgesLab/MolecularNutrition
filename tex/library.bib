  pages = {55--60},
  issn = {1046-2023},
  doi = {10.1016/j.ymeth.2007.11.001},
  urldate = {2015-01-06},
  abstract = {Antisense inhibition of microRNA (miRNA) function has been an important tool for uncovering miRNA biology. Chemical modification of anti-miRNA oligonucleotides (AMOs) is necessary to improve affinity for target miRNA, stabilize the AMO to nuclease degradation, and to promote tissue uptake for in vivo delivery. Here I summarize the work done to evaluate the effectiveness of various chemically modified AMOs for use in cultured cells and rodent models, and outline important issues to consider when inhibiting miRNAs with antisense oligonucleotides.},
