@article{Covarrubias2016,
  title = {Akt-{{mTORC1}} Signaling Regulates {{Acly}} to Integrate Metabolic Input to Control of Macrophage Activation},
  author = {Covarrubias, Anthony J. and Aksoylar, Halil Ibrahim and Yu, Jiujiu and Snyder, Nathaniel W. and Worth, Andrew J. and Iyer, Shankar S. and Wang, Jiawei and {Ben-Sahra}, Issam and Byles, Vanessa and {Polynne-Stapornkul}, Tiffany and Espinosa, Erika C. and Lamming, Dudley W. and Manning, Brendan D. and Zhang, Yijing and Blair, Ian A. and Horng, Tiffany},
  year = {2016},
  journal = {eLife},
  volume = {5},
  number = {FEBRUARY2016},
  pages = {1--19},
  issn = {2050084X},
  doi = {10.7554/eLife.11612},
  abstract = {Macrophage activation/polarization to distinct functional states is critically supported by metabolic shifts. How polarizing signals coordinate metabolic and functional reprogramming, and the potential implications for control of macrophage activation, remains poorly understood. Here we show that IL-4 signaling co-opts the Akt-mTORC1 pathway to regulate Acly, a key enzyme in Ac-CoA synthesis, leading to increased histone acetylation and M2 gene induction. Only a subset of M2 genes is controlled in this way, including those regulating cellular proliferation and chemokine production. Moreover, metabolic signals impinge on the Akt-mTORC1 axis for such control of M2 activation. We propose that Akt-mTORC1 signaling calibrates metabolic state to energetically demanding aspects of M2 activation, which may define a new role for metabolism in supporting macrophage activation.},
  isbn = {2050-084X (Electronic) 2050-084X (Linking)},
  pmid = {26894960}
}

