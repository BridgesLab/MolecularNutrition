@article{Rozman2014,
  title = {A Review of Standardized Metabolic Phenotyping of Animal Models.},
  author = {Rozman, Jan and Klingenspor, Martin and {Hrab{\v e} de Angelis}, Martin},
  year = {2014},
  journal = {Mammalian genome : official journal of the International Mammalian Genome Society},
  volume = {25},
