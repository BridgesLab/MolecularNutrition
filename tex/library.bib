@article{Tripathy2013,
  title = {Elovl5 Regulates the {{mTORC2-Akt-FOXO1}} Pathway by Controlling Hepatic Cis-Vaccenic Acid Synthesis in Diet-Induced Obese Mice.},
  author = {Tripathy, Sasmita and Jump, Donald B},
  year = {2013},
