@article{satoGlucocorticoidsInduceBone2017,
  title = {Glucocorticoids Induce Bone and Muscle Atrophy by Tissue-Specific Mechanisms Upstream of {{E3}} Ubiquitin Ligases},
  author = {Sato, Amy Y. and Richardson, Danielle and Cregor, Meloney and Davis, Hannah M. and Au, Ernie D. and McAndrews, Kevin and Zimmers, Teresa A. and Organ, Jason M. and Peacock, Munro and Plotkin, Lilian I. and Bellido, Teresita},
  year = {2017},
  journal = {Endocrinology},
  volume = {158},
  number = {3},
  pages = {664--677},
  issn = {19457170},
  doi = {10.1210/en.2016-1779},
  abstract = {Glucocorticoid excess, either endogenous with diseases of the adrenal gland, stress, or aging or when administered for immunosuppression, induces bone and muscle loss, leading to osteopenia and sarcopenia. Muscle weakness increases the propensity for falling, which, combined with the lower bone mass, increases the fracture risk. The mechanisms underlying glucocorticoid-induced bone and muscle atrophy are not completely understood. We have demonstrated that the loss of bone and muscle mass, decreased bone formation, and reduced muscle strength, hallmarks of glucocorticoid excess, are accompanied by upregulation in both tissues in vivo of the atrophy-related genes atrogin1, MuRF1, and MUSA1. These are E3 ubiquitin ligases traditionally considered muscle-specific. Glucocorticoids also upregulated atrophy genes in cultured osteoblastic/osteocytic cells, in ex vivo bone organ cultures, and in muscle organ cultures and C2C12 myoblasts/myotubes. Furthermore, glucocorticoids markedly increased the expression of components of the Notch signaling pathway in muscle in vivo, ex vivo, and in vitro. In contrast, glucocorticoids did not increase Notch signaling in bone or bone cells. Moreover, the increased expression of atrophy-related genes in muscle, but not in bone, and the decreased myotube diameter induced by glucocorticoids were prevented by inhibiting Notch signaling. Thus, glucocorticoids activate different mechanisms in bone and muscle that upregulate atrophy-related genes. However, the role of these genes in the effects of glucocorticoids in bone is unknown. Nevertheless, these findings advance our knowledge of the mechanism of action of glucocorticoids in the musculoskeletal system and provide the basis for novel therapies to prevent glucocorticoid-induced atrophy of bone and muscle.}
}

