@article{Chadt2008,
  title = {Tbc1d1 Mutation in Lean Mouse Strain Confers Leanness and Protects from Diet-Induced Obesity},
  author = {Chadt, A and Leicht, K and Deshmukh, A and Jiang, L Q and Scherneck, S and Bernhardt, U and Dreja, T and Vogel, H and Schmolz, K and Kluge, R and Zierath, J R and Hultschig, C and Hoeben, R C and Schurmann, A and Joost, H G and {Al-Hasani}, H},
  year = {2008},
  journal = {Nat Genet},
  volume = {40},
  number = {11},
  pages = {1354--1359},
  doi = {ng.244 [pii] 10.1038/ng.244},
  abstract = {We previously identified Nob1 as a quantitative trait locus for high-fat diet-induced obesity and diabetes in genome-wide scans of outcross populations of obese and lean mouse strains. Additional crossbreeding experiments indicated that Nob1 represents an obesity suppressor from the lean Swiss Jim Lambert (SJL) strain. Here we identify a SJL-specific mutation in the Tbc1d1 gene that results in a truncated protein lacking the TBC Rab-GTPase-activating protein domain. TBC1D1, which has been recently linked to human obesity, is related to the insulin signaling protein AS160 and is predominantly expressed in skeletal muscle. Knockdown of TBC1D1 in skeletal muscle cells increased fatty acid uptake and oxidation, whereas overexpression of TBC1D1 had the opposite effect. Recombinant congenic mice lacking TBC1D1 showed reduced body weight, decreased respiratory quotient, increased fatty acid oxidation and reduced glucose uptake in isolated skeletal muscle. Our data strongly suggest that mutation of Tbc1d1 suppresses high-fat diet-induced obesity by increasing lipid use in skeletal muscle.},
  isbn = {1546-1718 (Electronic)},
  keywords = {*Diet,Adiposity/genetics,Amino Acid Sequence,Animals,Base Sequence,Cells Cultured,Exons/genetics,Fatty Acids/metabolism,Gene Expression Profiling,Glucose/metabolism,Mice,Mice Mutant Strains,Molecular Sequence Data,Muscle Cells/metabolism,Muscle Skeletal/metabolism,Mutation/*genetics,Nuclear Proteins/chemistry/*genetics,Obesity/*prevention & control,Oxidation-Reduction,Protein Structure Tertiary,Quantitative Trait Loci/genetics,Sequence Deletion,Suppression Genetic/genetics,Thinness/*genetics}
}

@article{Chadwick2011,
  title = {Amitriptyline-Mediated Cognitive Enhancement in Aged 3{\texttimes}{{Tg Alzheimer}}'s Disease Mice Is Associated with Neurogenesis and Neurotrophic Activity.},
  author = {Chadwick, Wayne and Mitchell, Nick and Caroll, Jenna and Zhou, Yu and Park, Sung-Soo and Wang, Liyun and Becker, Kevin~G. and Zhang, Yongqing and Lehrmann, Elin and Wood, William H and Martin, Bronwen and Maudsley, Stuart},
  year = {2011},
  month = jan,
  journal = {PloS one},
  volume = {6},
  number = {6},
  pages = {e21660},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0021660},
  urldate = {2013-05-23},
  abstract = {Approximately 35 million people worldwide suffer from Alzheimer's disease (AD). Existing therapeutics, while moderately effective, are currently unable to stem the widespread rise in AD prevalence. AD is associated with an increase in amyloid beta (A{$\beta$}) oligomers and hyperphosphorylated tau, along with cognitive impairment and neurodegeneration. Several antidepressants have shown promise in improving cognition and alleviating oxidative stress in AD but have failed as long-term therapeutics. In this study, amitriptyline, an FDA-approved tricyclic antidepressant, was administered orally to aged and cognitively impaired transgenic AD mice (3{\texttimes}TgAD). After amitriptyline treatment, cognitive behavior testing demonstrated that there was a significant improvement in both long- and short-term memory retention. Amitriptyline treatment also caused a significant potentiation of non-toxic A{$\beta$} monomer with a concomitant decrease in cytotoxic dimer A{$\beta$} load, compared to vehicle-treated 3{\texttimes}TgAD controls. In addition, amitriptyline administration caused a significant increase in dentate gyrus neurogenesis as well as increases in expression of neurosynaptic marker proteins. Amitriptyline treatment resulted in increases in hippocampal brain-derived neurotrophic factor protein as well as increased tyrosine phosphorylation of its cognate receptor (TrkB). These results indicate that amitriptyline has significant beneficial actions in aged and damaged AD brains and that it shows promise as a tolerable novel therapeutic for the treatment of AD.},
  pmid = {21738757},
  keywords = {Alzheimer Disease,Alzheimer Disease: drug therapy,Alzheimer Disease: metabolism,Alzheimer Disease: physiopathology,Amitriptyline,Amitriptyline: therapeutic use,Amyloid beta-Peptides,Amyloid beta-Peptides: metabolism,Animals,Antidepressive Agents Tricyclic,Antidepressive Agents Tricyclic: therapeutic use,Cells Cultured,Cognition Disorders,Cognition Disorders: drug therapy,Cognition Disorders: metabolism,Cognition Disorders: physiopathology,Immunohistochemistry,Male,Mice,Mice Transgenic,Neurogenesis,Neurogenesis: drug effects}
}

