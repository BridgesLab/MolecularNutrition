  issn = {1531-5487},
  doi = {10.1097/EDE.0000000000000203},
  abstract = {BACKGROUND: Prenatal air pollution exposure inhibits fetal growth, but implications for postnatal growth are unknown.{\textbackslash}n{\textbackslash}nMETHODS: We assessed weights and lengths of US infants in the Project Viva cohort at birth and 6 months. We estimated 3rd-trimester residential air pollution exposures using spatiotemporal models. We estimated neighborhood traffic density and roadway proximity at birth address using geographic information systems. We performed linear and logistic regression adjusted for sociodemographic variables, fetal growth, and gestational age at birth.{\textbackslash}n{\textbackslash}nRESULTS: Mean birth weight-for-gestational age z-score (fetal growth) was 0.17 (standard deviation [SD] = 0.97; n = 2,114), 0- to 6-month weight-for-length gain was 0.23 z-units (SD = 1.11; n = 689), and 17\% had weight-for-length {$\geq$}95th percentile at 6 months of age. Infants exposed to the highest (vs. lowest) quartile of neighborhood traffic density had lower fetal growth (-0.13 units [95\% confidence interval (CI) = -0.25 to -0.01]), more rapid 0- to 6-month weight-for-length gain (0.25 units [95\% CI = 0.01 to 0.49]), and higher odds of weight-for-length {$\geq$}95th percentile at 6 months (1.84 [95\% CI = 1.11 to 3.05]). Neighborhood traffic density was additionally associated with an infant being in both the lowest quartile of fetal growth and the highest quartile of 0- to 6-month weight-for-length gain (Q4 vs. Q1, odds ratio = 3.01 [95\% CI = 1.08 to 8.44]). Roadway proximity and 3rd-trimester black carbon exposure were similarly associated with growth outcomes. For 3rd-trimester particulate matter (PM2.5), effect estimates were in the same direction, but smaller and imprecise.{\textbackslash}n{\textbackslash}nCONCLUSIONS: Infants exposed to higher traffic-related pollution in early life may exhibit more rapid postnatal weight gain in addition to reduced fetal growth.},
  arxiv = {NIHMS150003},
  isbn = {0000000000000},
  pmid = {25437317},
  keywords = {Air Pollution,Air Pollution: statistics & numerical data,Birth Weight,Cohort Studies,Female,Fetal Growth Retardation,Fetal Growth Retardation: epidemiology,Gestational Age,Humans,Infant,Infant Newborn,Male,Maternal Exposure,Maternal Exposure: statistics & numerical data,Particulate Matter,Pediatric Obesity,Pediatric Obesity: epidemiology,Pregnancy,Pregnancy Trimester Third,Prenatal Exposure Delayed Effects,Prenatal Exposure Delayed Effects: epidemiology,Spatio-Temporal Analysis,United States,United States: epidemiology,Vehicle Emissions,Weight Gain}
}

@article{Fleseriu2012a,
  title = {Mifepristone, a Glucocorticoid Receptor Antagonist, Produces Clinical and Metabolic Benefits in Patients with {{Cushing}}'s Syndrome},
  author = {Fleseriu, Maria and Biller, Beverly M K and Findling, James W. and Molitch, Mark E. and Schteingart, David E. and Gross, Coleman},
  year = {2012},
  journal = {Journal of Clinical Endocrinology \& Metabolism},
  volume = {97},
  number = {6},
  pages = {2039--2049},
  issn = {0021972X},
  doi = {10.1210/jc.2011-3350},
  abstract = {CONTEXT: Cushing's syndrome (CS) is a disorder associated with significant morbidity and mortality due to prolonged exposure to high cortisol concentrations.{\textbackslash}nOBJECTIVE: Our objective was to evaluate the safety and efficacy of mifepristone, a glucocorticoid receptor antagonist, in endogenous CS.{\textbackslash}nDESIGN AND SETTING: We conducted a 24-wk multicenter, open-label trial after failed multimodality therapy at 14 U.S. academic medical centers and three private research centers.{\textbackslash}nPARTICIPANTS: Participants included 50 adults with endogenous CS associated with type 2 diabetes mellitus/impaired glucose tolerance (C-DM) or a diagnosis of hypertension alone (C-HT).{\textbackslash}nINTERVENTION: Mifepristone was administered at doses of 300-1200 mg daily.{\textbackslash}nMAIN OUTCOME MEASURES: We evaluated change in area under the curve for glucose on 2-h oral glucose test for C-DM and change in diastolic blood pressure from baseline to wk 24 for C-HT.{\textbackslash}nRESULTS: In the C-DM cohort, an area under the curve for glucose (AUC(glucose)) response was seen in 60\% of patients (P {$<$} 0.0001). Mean {\textpm} sd glycated hemoglobin (HbA1c) decreased from 7.43 {\textpm} 1.52\% to 6.29 {\textpm} 0.99\% (P {$<$} 0.001); fasting plasma glucose decreased from 149.0 {\textpm} 75.7 mg/dl (8.3 {\textpm} 4.1 mmol/liter) to 104.7 {\textpm} 37.5 mg/dl (5.8 {\textpm} 2.1 mmol/liter, P {$<$} 0.03). In C-HT cohort, a diastolic blood pressure response was seen in 38\% of patients (P {$<$} 0.05). Mean weight change was -5.7 {\textpm} 7.4\% (P {$<$} 0.001) with waist circumference decrease of -6.78 {\textpm} 5.8 cm (P {$<$} 0.001) in women and -8.44 {\textpm} 5.9 cm (P {$<$} 0.001) in men. Overall, 87\% (P {$<$} 0.0001) had significant improvement in clinical status. Insulin resistance, depression, cognition, and quality of life also improved. Common adverse events were fatigue, nausea, headache, low potassium, arthralgia, vomiting, edema, and endometrial thickening in women.{\textbackslash}nCONCLUSIONS: Mifepristone produced significant clinical and metabolic improvement in patients with CS with an acceptable risk-benefit profile during 6 months of treatment.},
  isbn = {1945-7197 (Electronic){\textbackslash}r0021-972X (Linking)},
  pmid = {22466348}
}

