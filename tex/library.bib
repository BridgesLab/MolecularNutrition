@article{Livesey1995,
  title = {Metabolizable Energy of Macronutrients.},
  author = {Livesey, G},
  year = {1995},
  month = nov,
  journal = {The American journal of clinical nutrition},
  volume = {62},
  number = {5 Suppl},
  eprint = {7484932},
  eprinttype = {pubmed},
  pages = {1135S-1142S},
  issn = {0002-9165},
  abstract = {I describe recent advances in assessing the amount of energy available from diets of varied composition. Empirical models of food energy prediction have grown in preference to factorial models over the past 20 y and knowledge of the quantitative aspects of energy salvage in the colon have modified our thoughts on how to best calculate food energy values. In contrast, food regulatory practices have been limited mostly to changes in the way in which carbohydrate is defined or measured and there has been little change in the basic approach to energy evaluation or the energy conversion factors used with food components. The empirical systems have advantages over factorial models of food energy assessment and it is proposed that such empirical systems should be used in food regulations, food tables and databases, and in nutritional studies in which knowledge of metabolizable energy intake is desirable but cannot be determined directly.},
  pmid = {7484932}
}

@article{Livingston1974,
  title = {Studies of Glucagon Resistance in Large Rat Adipocytes: {{125I-labeled}} Glucagon Binding and Lipolytic Capacity.},
  author = {Livingston, James N and Cuatrecasas, Pedro and Lockwood, Dean H},
  year = {1974},
  month = jan,
  journal = {Journal of lipid research},
  volume = {15},
  number = {1},
  eprint = {4359539},
  eprinttype = {pubmed},
  pages = {26--32},
  issn = {0022-2275},
  urldate = {2014-10-24},
  abstract = {This study is concerned with potential modifications of large fat cells from adult rats (400-450 g) that make them resistant to stimulation by glucagon. The lipolytic capacity and (125)I-labeled glucagon-binding capability of these cells were compared with these properties of small glucagon-sensitive cells from young rats (130-160 g). As determined by maximal stimulation with theophylline, dibutyryl cAMP, or epinephrine, the lipolytic capacity of large cells was not markedly different from small cells, which suggests that an alteration contributing to glucagon insensitivity is not present in the enzymes involved with hormone-mediated lipolysis. Glucagon-binding studies did indicate a difference between the two cell types. Both large cells and particulate fractions from large cells bound less (125)I-labeled glucagon than small cells or small-cell particles. That diminished binding is not a consequence of glucagon degradation is indicated by the similar amounts of (125)I-labeled glucagon degraded by both cell types. The decrease in (125)I-labeled glucagon binding was not as marked as the decrease in lipolytic response to glucagon stimulation. This lack of correlation and the relationship between elevated phosphodiesterase levels and glucagon insensitivity described in the accompanying report suggest that diminished binding explains only in part the marked resistance to glucagon found in large cells.},
  pmid = {4359539},
  keywords = {Adipose Tissue,Adipose Tissue: cytology,Adipose Tissue: drug effects,Adipose Tissue: metabolism,Aging,Animals,Bucladesine,Epididymis,Epididymis: cytology,Epididymis: drug effects,Epididymis: metabolism,Epinephrine,Epinephrine: pharmacology,glucagaon resistance,Glucagon,Glucagon: metabolism,Glucagon: pharmacology,Glycerol,Glycerol: biosynthesis,Insulin,Insulin: metabolism,Iodine Radioisotopes,Lipid Metabolism,Male,Protein Binding,Rats,Subcellular Fractions,Subcellular Fractions: metabolism,Theophylline,Theophylline: pharmacology}
}

