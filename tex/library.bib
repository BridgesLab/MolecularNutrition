@article{Suzuki1998,
  title = {High Cancer Susceptibility and Embryonic Lethality Associated with Mutation of the {{PTEN}} Tumor Suppressor Gene in Mice.},
  author = {Suzuki, a and {de la Pompa}, J L and Stambolic, V and Elia, a J and Sasaki, T and {del Barco Barrantes}, I and Ho, A and Wakeham, A and Itie, A and Khoo, W and Fukumoto, M and Mak, Tak Wah},
