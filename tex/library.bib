@article{parkPravastatinSarpogrelateSynergistically2016,
  title = {Pravastatin and {{Sarpogrelate Synergistically Ameliorate Atherosclerosis}} in {{LDLr-Knockout Mice}}},
  author = {Park, Kyung-Yeon and Oh, Euichaul and Kwak, Mi-Kyoung and Jun, Hyun Sik and Heo, Tae-Hwe},
  year = {2016},
  month = mar,
  journal = {PLOS ONE},
  volume = {11},
  number = {3},
  pages = {e0150791},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0150791},
  urldate = {2024-10-09},
  abstract = {Pravastatin is a lipid-lowering agent that attenuates atherosclerosis. However, the multifactorial pathogenesis of atherosclerosis requires other drugs with different anti-atherogenic mechanisms. We chose sarpogrelate as an anti-platelet agent and a novel component of a complex drug with pravastatin due to its high potential but little information on its beneficial effects on atherosclerosis. Low-density lipoprotein receptor-knockout mice were fed a high-fat, high-cholesterol diet and treated with pravastatin alone, sarpogrelate alone, or a combination of both drugs. Although sarpogrelate alone did not significantly reduce atherosclerotic plaque areas, co-treatment with pravastatin significantly decreased aortic lesions compared to those of the pravastatin alone treated group. The combined therapy was markedly more effective than that of the single therapies in terms of foam cell formation, smooth muscle cell proliferation, and inflammatory cytokine levels. These results suggest that pravastatin and sarpogrelate combined therapy may provide a new therapeutic strategy for treating atherosclerosis.},
  langid = {english},
  keywords = {Antiplatelet therapy,Atherosclerosis,Cholesterol,Cytokine therapy,Diet,Fats,Oils,Statins},
  file = {/Users/davebrid/Zotero/storage/ZS9N4AA2/Park et al. - 2016 - Pravastatin and Sarpogrelate Synergistically Ameliorate Atherosclerosis in LDLr-Knockout Mice.pdf}
}

