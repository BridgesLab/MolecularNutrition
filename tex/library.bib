@article{Gao2011a,
  title = {{{mTOR Drives Its Own Activation}} via {{SCF}}({{$\beta$TrCP}})-{{Dependent Degradation}} of the {{mTOR Inhibitor DEPTOR}}.},
  author = {Gao, Daming and Inuzuka, Hiroyuki and Tan, Meng-Kwang Marcus and Fukushima, Hidefumi and Locasale, Jason W and Liu, Pengda and Wan, Lixin and Zhai, Bo and Chin, Y Rebecca and Shaik, Shavali and a Lyssiotis, Costas and Gygi, Steven P. and Toker, Alex and Cantley, Lewis~C. and Asara, John M. and Harper, J Wade and Wei, Wenyi},
  year = {2011},
  month = oct,
  journal = {Molecular cell},
  volume = {44},
  number = {2},
  eprint = {22017875},
  eprinttype = {pubmed},
  pages = {290--303},
  issn = {1097-4164},
  doi = {10.1016/j.molcel.2011.08.030},
  urldate = {2011-10-25},
  abstract = {The activities of both mTORC1 and mTORC2 are negatively regulated by their endogenous inhibitor, DEPTOR. As such, the abundance of DEPTOR is a critical determinant in the activity status of the mTOR network. DEPTOR stability is governed by the 26S-proteasome through a largely unknown mechanism. Here we describe an mTOR-dependent~phosphorylation-driven pathway for DEPTOR destruction via SCF({$\beta$}TrCP). DEPTOR phosphorylation by mTOR in response to growth signals, and in collaboration with casein kinase I (CKI), generates a phosphodegron that binds {$\beta$}TrCP. Failure to degrade DEPTOR through either degron mutation or {$\beta$}TrCP depletion leads to reduced mTOR activity, reduced S6 kinase activity, and activation of autophagy to reduce cell growth. This work expands the current understanding of mTOR regulation by revealing a positive feedback loop involving mTOR and CKI-dependent turnover of its inhibitor, DEPTOR, suggesting that misregulation of the DEPTOR destruction pathway might contribute to aberrant activation of mTOR in disease.},
  pmid = {22017875}
}

@article{Gao2015,
  title = {Quantitative {{H2S-mediated}} Protein Sulfhydration Reveals Metabolic Reprogramming during the Integrated Stress Response},
  author = {Gao, Xing Huang and Krokowski, Dawid and Guan, Bo-Jhih and Bederman, Ilya and Majumder, Mithu and Parisien, Marc and Diatchenko, Luda and Kabil, Omer and Willard, Belinda and Banerjee, Ruma and Wang, Benlian and Bebek, Gurkan and Evans, Charles R. and Fox, Paul~L. and Gerson, Stanton L. and Hoppel, Charles L. and Liu, Ming and Arvan, Peter and Hatzoglou, Maria},
  year = {2015},
  journal = {eLife},
  volume = {4},
  number = {NOVEMBER2015},
  pages = {1--21},
  issn = {2050084X},
  doi = {10.7554/eLife.10067},
  abstract = {The sulfhydration of cysteine residues in proteins is an important mechanism involved in diverse biological processes. We have developed a proteomics approach to quantitatively profile the changes of sulfhydrated cysteines in biological systems. Bioinformatics analysis revealed that sulfhydrated cysteines are part of a wide range of biological functions. In pancreatic {$\beta$} cells exposed to endoplasmic reticulum (ER) stress, elevated H2S promotes the sulfhydration of enzymes in energy metabolism and stimulates glycolytic flux. We propose that transcriptional and translational reprogramming by the integrated stress response (ISR) in pancreatic {$\beta$} cells is coupled to metabolic alternations triggered by sulfhydration of key enzymes in intermediary metabolism.},
  isbn = {2050-084X (Electronic){\textbackslash}r2050-084X (Linking)},
  pmid = {26595448}
}

