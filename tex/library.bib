@article{He2007,
  title = {Exo70 Interacts with Phospholipids and Mediates the Targeting of the Exocyst to the Plasma Membrane.},
  author = {He, Bing and Xi, Fengong and Zhang, Xiaoyu and Zhang, Jian and Guo, Wei},
  year = {2007},
  month = sep,
  journal = {The EMBO journal},
  volume = {26},
  number = {18},
  pages = {4053--65},
  issn = {0261-4189},
  doi = {10.1038/sj.emboj.7601834},
  urldate = {2011-08-19},
  abstract = {The exocyst is an octameric protein complex implicated in the tethering of post-Golgi secretory vesicles to the plasma membrane before fusion. The function of individual exocyst components and the mechanism by which this tethering complex is targeted to sites of secretion are not clear. In this study, we report that the exocyst subunit Exo70 functions in concert with Sec3 to anchor the exocyst to the plasma membrane. We found that the C-terminal Domain D of Exo70 directly interacts with phosphatidylinositol 4,5-bisphosphate. In addition, we have identified key residues on Exo70 that are critical for its interaction with phospholipids and the small GTPase Rho3. Further genetic and cell biological analyses suggest that the interaction of Exo70 with phospholipids, but not Rho3, is essential for the membrane association of the exocyst complex. We propose that Exo70 mediates the assembly of the exocyst complex at the plasma membrane, which is a crucial step in the tethering of post-Golgi secretory vesicles for exocytosis.},
  pmid = {17717527},
  keywords = {Actins,Actins: metabolism,Alleles,Cell Membrane,Cell Membrane: metabolism,Models Biological,Multiprotein Complexes,Multiprotein Complexes: metabolism,Mutation,Mutation: genetics,Phosphatidylinositol 45-Diphosphate,Phospholipids,Phospholipids: metabolism,Phosphotransferases,Phosphotransferases (Alcohol Group Acceptor),Phosphotransferases: metabolism,Protein Binding,Protein Structure Tertiary,Protein Subunits,Protein Subunits: metabolism,rho GTP-Binding Proteins,rho GTP-Binding Proteins: metabolism,Saccharomyces cerevisiae,Saccharomyces cerevisiae Proteins,Saccharomyces cerevisiae Proteins: chemistry,Saccharomyces cerevisiae Proteins: metabolism,Saccharomyces cerevisiae Proteins: secretion,Saccharomyces cerevisiae: cytology,Saccharomyces cerevisiae: growth & development,Saccharomyces cerevisiae: metabolism,Vesicular Transport Proteins}
}

