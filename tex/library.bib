@article{Kleinridders2014b,
  title = {Insulin Action in Brain Regulates Systemic Metabolism and Brain Function},
  author = {Kleinridders, Andr{\'e} and Ferris, Heather A. and Cai, Weikang and Kahn, C. Ronald},
