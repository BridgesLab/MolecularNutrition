@article{Scheja2011,
  title = {Beneficial Effects of {{IKK$\varepsilon$-deficiency}} on Body Weight and Insulin Sensitivity Are Lost in High Fat Diet-Induced Obesity in Mice.},
  author = {Scheja, Ludger and Heese, Barbara and Seedorf, Klaus},
  year = {2011},
  month = mar,
  journal = {Biochemical and biophysical research communications},
  volume = {407},
  number = {2},
  eprint = {21371440},
  eprinttype = {pubmed},
  pages = {288--94},
  publisher = {Elsevier Inc.},
  issn = {1090-2104},
  doi = {10.1016/j.bbrc.2011.02.137},
  urldate = {2011-03-29},
  abstract = {Activation of the classical I{$\kappa$}B kinases (IKK{$\alpha$} and IKK{$\beta$} was previously shown to contribute to obesity-induced inflammation and insulin resistance. Using knockout mice, we investigated whether the related isoform IKK{$\varepsilon$} plays a similar metabolic role. IKK{$\varepsilon$}(-/-) mice had reduced body weight, leptin levels, as well as higher insulin sensitivity when kept on chow diet. However, inflammatory parameters, measured in liver, adipose tissue and plasma, were either unaltered or showed a trend toward up-regulation (liver NF-{$\kappa$}B activity, TNF{$\alpha$} and IL-1{$\beta$} expression). Chronic feeding of a high fat diet induced equal obesity and insulin resistance, and similarly induced inflammatory markers, in IKK{$\varepsilon$}(-/-) and wild-type mice, indicating that under high caloric conditions the inflammatory and metabolic effects of IKK{$\varepsilon$} deficiency were overridden. Taken together, our data indicate that IKK{$\varepsilon$} does not have general pro-inflammatory properties in liver and adipose tissue, and suggest that reduced adiposity is the primary mechanism for improved insulin sensitivity in IKK{$\varepsilon$}(-/-) mice on chow diet.},
  pmid = {21371440},
  keywords = {Animals,Biological Markers,Biological Markers: blood,Body Weight,Body Weight: genetics,Dietary Fats,Dietary Fats: administration & dosage,Dietary Fats: adverse effects,energy expenditure,high fat diet,I-kappa B Kinase,I-kappa B Kinase: genetics,ikki,Inflammation Mediators,Inflammation Mediators: blood,Insulin Resistance,Insulin Resistance: genetics,Knockout,Liver,Liver: enzymology,Male,Mice,NF-kappa B,NF-kappa B: metabolism,obesity,Obesity,Obesity: blood,Obesity: enzymology,Obesity: etiology,ucp1}
}

