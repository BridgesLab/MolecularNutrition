  keywords = {Glutaminolysis,Oncoproteins,Pyruvate kinase,Tumor M2-PK,Tumor metabolome}
}

@article{Mazza2011,
  title = {Class {{II}} Phosphoinositide 3-Kinase {{C2alpha}}: What We Learned so Far.},
  author = {Mazza, Simona and Maffucci, Tania},
  year = {2011},
  month = jan,
  journal = {International journal of biochemistry and molecular biology},
  volume = {2},
  number = {2},
  pages = {168--182},
  issn = {2152-4114},
  urldate = {2012-03-06},
  abstract = {More than fifteen years after the first identification of a class II isoform of phosphoinositide 3-kinase (PI3K) in Drosophila melano{\'g}aster this subfamily remains the most enigmatic among all PI3Ks. What are the functions of these enzymes? What are their mechanisms of activation? Which downstream effectors are specifically regulated by these isoforms? Are class I and class II PI3Ks redundant or do they control different intracellular processes? And, more important, do class II PI3Ks have a role in human diseases? The recent increased interest on class II PI3Ks has started providing some answers to these questions but still a lot needs to be done to completely uncover the contribution of these enzymes to physiological processes and possibly to pathological conditions. Here we will summarise the recent findings on the alpha isoform of mammalian class II PI3Ks (PI3K-C2{$\alpha$} ) and we will discuss the potential involvement of this enzyme in human diseases.},
  pmid = {21968800},
  keywords = {exocy-,glucose transport,insulin secretion,neurosecretion,phosphoinositide 3-kinase,phosphoinositides,pi3kc2a,pi3p,review}
}

@article{Mazziotti2013,
  title = {Glucocorticoids and the Regulation of Growth Hormone Secretion.},
  author = {Mazziotti, Gherardo and Giustina, Andrea},
  year = {2013},
  journal = {Nature reviews. Endocrinology},
  volume = {9},
  number = {5},
  eprint = {23381030},
  eprinttype = {pubmed},
  pages = {265--76},
  publisher = {Nature Publishing Group},
  issn = {1759-5037},
  doi = {10.1038/nrendo.2013.5},
  abstract = {Glucocorticoids modulate the secretion of growth hormone (GH) by various and competing effects on the hypothalamus and pituitary gland. The final effects of this modulation depend on hormone concentrations and the duration of exposure. The traditional hypothesis is that chronically raised levels of glucocorticoids suppress the secretion of GH. However, a functional impairment of the GH reserve might also be observed in patients with low levels of glucocorticoids, such as those with secondary hypoadrenalism, which is consistent with the model of biphasic dose-dependent effects of glucocorticoids on the somatotropic axis. This Review updates our current understanding of the mechanisms underlying the effects of glucocorticoids on the secretion of GH and the clinical implications of the dual action of glucocorticoids on the GH reserve in humans. This Review will also address the potential diagnostic and therapeutic implications of GH for patients with a deficiency or excess of glucocorticoids.},
  pmid = {23381030},
  keywords = {Adrenocorticotropic Hormone,Adrenocorticotropic Hormone: deficiency,Animals,Cushing Syndrome,Cushing Syndrome: etiology,Glucocorticoids,Glucocorticoids: adverse effects,Glucocorticoids: pharmacology,Glucocorticoids: physiology,Growth Hormone,Growth Hormone: deficiency,Growth Hormone: secretion,Humans,Lipid Metabolism,Lipid Metabolism: drug effects,Osteoporosis,Osteoporosis: chemically induced,Proteins,Proteins: metabolism}
}

