@article{Govus2014,
  title = {Acute Hypoxic Exercise Does Not Alter Post-Exercise Iron Metabolism in Moderately Trained Endurance Athletes},
  author = {Govus, Andrew D. and Abbiss, Chris R. and {Garvican-Lewis}, Laura A. and Swinkels, Dorine W. and Laarakkers, Coby M. and Gore, Christopher J. and Peeling, Peter},
  year = {2014},
  journal = {European Journal of Applied Physiology},
  volume = {114},
  number = {10},
  pages = {2183--2191},
  issn = {14396319},
  doi = {10.1007/s00421-014-2938-2},
  abstract = {PURPOSE: This study measured the influence of acute hypoxic exercise on Interleukin-6 (IL-6), hepcidin, and iron biomarkers in athletes.{\textbackslash}n{\textbackslash}nMETHODS: In a repeated measures design, 13 moderately trained endurance athletes performed 5 {\texttimes} 4 min intervals at 90 \% of their peak oxygen consumption velocity (vVO2peak) in both normoxic [NORM, fraction of inspired oxygen (F IO2) = 0.2093, 15.3 {\textpm} 1.7 km h(-1)] and simulated hypoxic (HYP, F IO2 = 0.1450, 13.2 {\textpm} 1.5 km h(-1)) conditions. Venous blood samples were obtained pre-, post-, and 3 h post-exercise, and analysed for serum hepcidin, IL-6, ferritin, iron, soluble transferrin receptor (sTfR), and transferrin saturation.{\textbackslash}n{\textbackslash}nRESULTS: Peak heart rate was significantly lower in HYP compared with NORM (p = 0.01); however, the rating of perceived exertion was similar between trials (p = 0.24). Ferritin (p = 0.02), transferrin (p = 0.03), and IL-6 (p = 0.01) significantly increased immediately post-exercise in both conditions, but returned to baseline 3 h later. Hepcidin levels significantly increased in both conditions 3 h post-exercise (p = 0.05), with no significant differences between trials. A significant treatment effect was observed between trials for sTfR (p = 0.01), but not iron and transferrin saturation.{\textbackslash}n{\textbackslash}nCONCLUSION: Acute exercise in hypoxia did not influence post-exercise IL-6 production, hepcidin activity or iron metabolism compared with exercise at the same relative intensity in normoxia. Hence, acute exercise performed at the same relative intensity in hypoxia poses no further risk to an athlete's iron status, as compared with exercise in normoxia.},
  isbn = {1439-6319},
  pmid = {24990089},
  keywords = {Altitude training,exercise,GDF15,Hepcidin,Intermittent hypoxic training,Iron deficiency}
}

