  doi = {10.1038/79238},
  urldate = {2014-04-04},
  abstract = {Carney complex (CNC) is a multiple neoplasia syndrome characterized by spotty skin pigmentation, cardiac and other myxomas, endocrine tumours and psammomatous melanotic schwannomas. CNC is inherited as an autosomal dominant trait and the genes responsible have been mapped to 2p16 and 17q22-24 (refs 6, 7). Because of its similarities to the McCune-Albright syndrome and other features, such as paradoxical responses to endocrine signals, genes implicated in cyclic nucleotide-dependent signalling have been considered candidates for causing CNC (ref. 10). In CNC families mapping to 17q, we detected loss of heterozygosity (LOH) in the vicinity of the gene (PRKAR1A) encoding protein kinase A regulatory subunit 1-alpha (RIalpha), including a polymorphic site within its 5' region. We subsequently identified three unrelated kindreds with an identical mutation in the coding region of PRKAR1A. Analysis of additional cases revealed the same mutation in a sporadic case of CNC, and different mutations in three other families, including one with isolated inherited cardiac myxomas. Analysis of PKA activity in CNC tumours demonstrated a decreased basal activity, but an increase in cAMP-stimulated activity compared with non-CNC tumours. We conclude that germline mutations in PRKAR1A, an apparent tumour-suppressor gene, are responsible for the CNC phenotype in a subset of patients with this disease.},
  isbn = {1061-4036 (Print){\textbackslash}r1061-4036 (Linking)},
  pmid = {10973256},
  keywords = {Acromegaly,Acromegaly: genetics,Acromegaly/genetics,Alleles,Blotting,Chromatography,Chromosomes,Complementary,Complementary: metabolism,Complementary/metabolism,Cyclic AMP,Cyclic AMP-Dependent Protein Kinases,Cyclic AMP-Dependent Protein Kinases: genetics,Cyclic AMP-Dependent Protein Kinases: metabolism,Cyclic AMP-Dependent Protein Kinases/genetics/meta,Cyclic AMP: metabolism,Cyclic AMP/metabolism,DNA,DNA Mutational Analysis,Endocrine Gland Neoplasms,Endocrine Gland Neoplasms: genetics,Endocrine Gland Neoplasms/genetics,Exons,Expressed Sequence Tags,Family Health,Female,Genetic,Genotype,Germ-Line Mutation,High Pressure Liquid,Homozygote,Human,Humans,Introns,Loss of Heterozygosity,Male,Microsatellite Repeats,Molecular Sequence Data,Mutation,Myxoma,Myxoma: genetics,Myxoma/genetics,Neoplasms,Neoplasms: genetics,Neoplasms/genetics,Neurilemmoma,Neurilemmoma: genetics,Neurilemmoma/genetics,Nucleic Acid Heteroduplexes,Pair 17,Pair 2,Pedigree,Phenotype,Polymorphism,Skin Pigmentation,Skin Pigmentation: genetics,Skin Pigmentation/genetics,Western}
}

