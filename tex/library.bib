@article{Rios2013,
  title = {{{BDNF}} and the Central Control of Feeding: Accidental Bystander or Essential Player?},
  author = {Rios, Maribel},
  year = {2013},
  month = feb,
  journal = {Trends in neurosciences},
  volume = {36},
  number = {2},
  pages = {83--90},
  publisher = {Elsevier Ltd},
  issn = {1878-108X},
  doi = {10.1016/j.tins.2012.12.009},
  urldate = {2014-06-02},
  abstract = {A considerable body of evidence links diminished brain-derived neurotrophic factor (BDNF) signaling to energy balance dysregulation and severe obesity in humans and rodents. Because BDNF exhibits broad neurotrophic properties, the underpinnings of these effects and its true role in the central regulation of food intake remain topics of debate in the field. Here, I discuss recent evidence supporting a critical role for this neurotrophin in physiological mechanisms regulating nutrient intake and body weight in the mature brain. They include reports of functional interactions of BDNF with central anorexigenic and orexigenic signaling pathways and evidence of recognized appetite hormones exerting neurotrophic effects similar to those of BDNF.},
  pmid = {23333344},
  keywords = {Brain,Brain-Derived Neurotrophic Factor,Brain-Derived Neurotrophic Factor: physiology,Brain: physiology,Eating,Eating: physiology,Feeding Behavior,Feeding Behavior: physiology,Humans}
}

