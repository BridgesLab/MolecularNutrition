@article{Alseekh2021,
  title = {Mass Spectrometry-Based Metabolomics: A Guide for Annotation, Quantification and Best Reporting Practices},
  author = {Alseekh, Saleh and Aharoni, Asaph and Brotman, Yariv and Contrepois, K{\'e}vin and D'Auria, John and Ewald, Jan and C. Ewald, Jennifer and Fraser, Paul D. and Giavalisco, Patrick and Hall, Robert D. and Heinemann, Matthias and Link, Hannes and Luo, Jie and Neumann, Steffen and Nielsen, Jens and {Perez de Souza}, Leonardo and Saito, Kazuki and Sauer, Uwe and Schroeder, Frank C. and Schuster, Stefan and Siuzdak, Gary and Skirycz, Aleksandra and Sumner, Lloyd W. and Snyder, Michael P. and Tang, Huiru and Tohge, Takayuki and Wang, Yulan and Wen, Weiwei and Wu, Si and Xu, Guowang and Zamboni, Nicola and Fernie, Alisdair R.},
  year = {2021},
  journal = {Nature Methods},
  volume = {18},
  number = {7},
  pages = {747--756},
  issn = {15487105},
  doi = {10.1038/s41592-021-01197-1},
  abstract = {Mass spectrometry-based metabolomics approaches can enable detection and quantification of many thousands of metabolite features simultaneously. However, compound identification and reliable quantification are greatly complicated owing to the chemical complexity and dynamic range of the metabolome. Simultaneous quantification of many metabolites within complex mixtures can additionally be complicated by ion suppression, fragmentation and the presence of isomers. Here we present guidelines covering sample preparation, replication and randomization, quantification, recovery and recombination, ion suppression and peak misidentification, as a means to enable high-quality reporting of liquid chromatography-- and gas chromatography--mass spectrometry-based metabolomics-derived data.},
  isbn = {4159202101},
  pmid = {34239102}
}

@article{AlShebli2020,
  title = {The Association between Early Career Informal Mentorship in Academic Collaborations and Junior Author Performance.},
  author = {AlShebli, Bedoor and Makovi, Kinga and Rahwan, Talal},
  year = {2020},
  journal = {Nature communications},
  volume = {11},
  number = {1},
  eprint = {33203848},
  eprinttype = {pubmed},
  pages = {5855},
  publisher = {Springer US},
  issn = {2041-1723},
  doi = {10.1038/s41467-020-19723-8},
  abstract = {We study mentorship in scientific collaborations, where a junior scientist is supported by potentially multiple senior collaborators, without them necessarily having formal supervisory roles. We identify 3 million mentor-prot{\'e}g{\'e} pairs and survey a random sample, verifying that their relationship involved some form of mentorship. We find that mentorship quality predicts the scientific impact of the papers written by prot{\'e}g{\'e}s post mentorship without their mentors. We also find that increasing the proportion of female mentors is associated not only with a reduction in post-mentorship impact of female prot{\'e}g{\'e}s, but also a reduction in the gain of female mentors. While current diversity policies encourage same-gender mentorships to retain women in academia, our findings raise the possibility that opposite-gender mentorship may actually increase the impact of women who pursue a scientific career. These findings add a new perspective to the policy debate on how to best elevate the status of women in science.},
  pmid = {33203848}
}

@article{Altarejos2011a,
  title = {{{CREB}} and the {{CRTC}} Co-Activators: Sensors for Hormonal and Metabolic Signals.},
  author = {Altarejos, Judith Y. and Montminy, Marc},
  year = {2011},
  month = mar,
  journal = {Nature reviews. Molecular cell biology},
  volume = {12},
  number = {3},
  eprint = {21346730},
  eprinttype = {pubmed},
  pages = {141--51},
  publisher = {Nature Publishing Group},
  issn = {1471-0080},
  doi = {10.1038/nrm3072},
  urldate = {2011-02-23},
  abstract = {The cyclic AMP-responsive element-binding protein (CREB) is phosphorylated in response to a wide variety of signals, yet target gene transcription is only increased in a subset of cases. Recent studies indicate that CREB functions in concert with a family of latent cytoplasmic co-activators called cAMP-regulated transcriptional co-activators (CRTCs), which are activated through dephosphorylation. A dual requirement for CREB phosphorylation and CRTC dephosphorylation is likely to explain how these activator-co-activator cognates discriminate between different stimuli. Following their activation, CREB and CRTCs mediate the effects of fasting and feeding signals on the expression of metabolic programmes in insulin-sensitive tissues.},
  pmid = {21346730},
  keywords = {Adipose Tissue,Adipose Tissue: metabolism,Animals,Biological,CREB,CRTC,Cyclic AMP,Cyclic AMP Response Element-Binding Protein,Cyclic AMP Response Element-Binding Protein: chemi,Cyclic AMP Response Element-Binding Protein: genet,Cyclic AMP Response Element-Binding Protein: metab,Cyclic AMP: metabolism,Glucagon,Glucagon: metabolism,gluconeogenesis,Gluconeogenesis,Humans,Hyperglycemia,Hyperglycemia: metabolism,Hypothalamus,Hypothalamus: metabolism,Insulin,Insulin: metabolism,Islets of Langerhans,Islets of Langerhans: metabolism,Liver,Liver: metabolism,Longevity,Longevity: physiology,Models,Muscle,Phosphorylation,Signal Transduction,Skeletal,Skeletal: metabolism,Trans-Activators,Trans-Activators: chemistry,Trans-Activators: genetics,Trans-Activators: metabolism}
}

