@article{Jideonwo2018,
  title = {Impact of Silencing Hepatic {{SREBP-1}} on Insulin Signaling},
  author = {Jideonwo, Victoria and Hou, Yongyong and Ahn, Miwon and Surendran, Sneha and Morral, N{\'u}ria},
  year = {2018},
  journal = {PLoS ONE},
  volume = {13},
  number = {5},
  pages = {1--12},
  issn = {19326203},
  doi = {10.1371/journal.pone.0196704},
  abstract = {Sterol Regulatory Element Binding Protein-1 (SREBP-1) is a conserved transcription factor of the basic helix-loop-helix leucine zipper family (bHLH-Zip) that plays a central role in regulating expression of genes of carbohydrate and fatty acid metabolism in the liver. SREBP-1 activity is essential for the control of insulin-induced anabolic processes during the fed state. In addition, SREBP-1 regulates expression of key molecules in the insulin signaling pathway, including insulin receptor substrate 2 (IRS2) and a subunit of the phosphatidylinositol 3-kinase (PI3K) complex, PIK3R3, suggesting that feedback mechanisms exist between SREBP-1 and this pathway. Nevertheless, the overall contribution of SREBP-1 activity to maintain insulin signal transduction is unknown. Furthermore, Akt is a known activator of mTORC1, a sensor of energy availability that plays a fundamental role in metabolism, cellular growth and survival. We have silenced SREBP-1 and explored the impact on insulin signaling and mTOR in mice under fed, fasted and refed conditions. No alterations in circulating levels of insulin were observed. The studies revealed that depletion of SREBP-1 had no impact on IRS1Y612, AktS473, and downstream effectors GSK3{$\alpha$}S21 and FoxO1S256 during the fed state. Nevertheless, reduced levels of these molecules were observed under fasting conditions. These effects were not associated with changes in phosphorylation of mTOR. Overall, our data indicate that the contribution of SREBP-1 to maintain insulin signal transduction in liver is modest.},
  isbn = {1111111111},
  pmid = {29723221}
}

@article{jiHepaticScavengerReceptor1999,
  title = {Hepatic {{Scavenger Receptor BI Promotes Rapid Clearance}} of {{High Density Lipoprotein Free Cholesterol}} and {{Its Transport}} into {{Bile}} *},
  author = {Ji, Yong and Wang, Nan and Ramakrishnan, Rajasekhar and Sehayek, Ephraim and Huszar, Dennis and Breslow, Jan L. and Tall, Alan R.},
  year = {1999},
  month = nov,
  journal = {Journal of Biological Chemistry},
  volume = {274},
  number = {47},
  pages = {33398--33402},
  publisher = {Elsevier},
  issn = {0021-9258, 1083-351X},
  doi = {10.1074/jbc.274.47.33398},
  urldate = {2024-02-20},
  abstract = {{$<$}p{$>$}The clearance of free cholesterol from plasma lipoproteins by tissues is of major quantitative importance, but it is not known whether this is passive or receptor-mediated. Based on our finding that scavenger receptor BI (SR-BI) promotes free cholesterol (FC) exchange between high density lipoprotein (HDL) and cells, we tested whether SR-BI would effect FC movement \emph{in vivo} using [\textsuperscript{14}C]FC- and [\textsuperscript{3}H]cholesteryl ester (CE)-labeled HDL in mice with increased (SR-BI transgenic (Tg)) or decreased (SR-BI attenuated (att)) hepatic SR-BI expression. The initial clearance of HDL FC was increased in SR-BI Tg mice by 72\% and decreased in SR-BI att mice by 53\%, but was unchanged in apoA-I knockout mice compared with wild-type mice. Transfer of FC to non-HDL and esterification of FC were minor and could not explain differences. The hepatic uptake of FC was increased in SR-BI Tg mice by 34\% and decreased in SR-BI att mice by 22\%. CE clearance and uptake gave similar results, but with much slower rates. The uptake of HDL FC and CE by SR-BI Tg primary hepatocytes was increased by 2.2- and 2.6-fold (1-h incubation), respectively, compared with control hepatocytes. In SR-BI Tg mice, the initial biliary secretion of [\textsuperscript{14}C]FC was markedly increased, whereas increased [\textsuperscript{3}H]FC appeared after a slight delay. Thus, in the mouse, a major portion of the clearance of HDL FC from plasma is mediated by SR-BI.{$<$}/p{$>$}},
  langid = {english},
  file = {/Users/davebrid/Zotero/storage/RCUQX5Y2/Ji et al. - 1999 - Hepatic Scavenger Receptor BI Promotes Rapid Clear.pdf}
}

@article{Jimenez2013,
  title = {In Vivo Adeno-Associated Viral Vector-Mediated Genetic Engineering of White and Brown Adipose Tissue in Adult Mice},
  author = {Jimenez, Veronica and Mu{\~n}oz, Sergio and Casana, Estefania and Mallol, Cristina and Elias, Ivet and Jambrina, Claudia and Ribera, Albert and Ferre, Tura and Franckhauser, Sylvie and Bosch, Fatima},
  year = {2013},
  journal = {Diabetes},
  volume = {62},
  number = {12},
  pages = {4012--4022},
  issn = {00121797},
  doi = {10.2337/db13-0311},
  abstract = {Adipose tissue is pivotal in the regulation of energy homeostasis through the balance of energy storage and expenditure and as an endocrine organ. An inadequate mass and/or alterations in the metabolic and endocrine functions of adipose tissue underlie the development of obesity, insulin resistance, and type 2 diabetes. To fully understand the metabolic and molecular mechanism(s) involved in adipose dysfunction, in vivo genetic modification of adipocytes holds great potential. Here, we demonstrate that adeno-associated viral (AAV) vectors, especially serotypes 8 and 9, mediated efficient transduction of white (WAT) and brown adipose tissue (BAT) in adult lean and obese diabetic mice. The use of short versions of the adipocyte protein 2 or uncoupling protein-1 promoters or micro-RNA target sequences enabled highly specific, long-term AAV-mediated transgene expression in white or brown adipocytes. As proof of concept, delivery of AAV vectors encoding for hexokinase or vascular endothelial growth factor to WAT or BAT resulted in increased glucose uptake or increased vessel density in targeted depots. This method of gene transfer also enabled the secretion of stable high levels of the alkaline phosphatase marker protein into the bloodstream by transduced WAT. Therefore, AAV-mediated genetic engineering of adipose tissue represents a useful tool for the study of adipose pathophysiology and, likely, for the future development of new therapeutic strategies for obesity and diabetes. {\copyright} 2013 by the American Diabetes Association.}
}

@article{Jin2008,
  title = {{{VAC14}} Nucleates a Protein Complex Essential for the Acute Interconversion of {{PI3P}} and {{PI}}(3,5){{P}}(2) in Yeast and Mouse},
  author = {Jin, Natsuko and Chow, Clement Y and Liu, Li and Zolov, Sergey N. and Bronson, Roderick and Davisson, Muriel and Petersen, Jason L and Zhang, Yanling and Park, Sujin and Duex, Jason E and Goldowitz, Dan and Meisler, Miriam H and Weisman, Lois~S.},
  year = {2008},
  month = nov,
  journal = {EMBO J},
  volume = {27},
  number = {24},
  pages = {3221--3234},
  issn = {0261-4189},
  doi = {emboj2008248 [pii] 10.1038/emboj.2008.248},
  urldate = {2011-07-28},
  abstract = {The signalling lipid PI(3,5)P(2) is generated on endosomes and regulates retrograde traffic to the trans-Golgi network. Physiological signals regulate rapid, transient changes in PI(3,5)P(2) levels. Mutations that lower PI(3,5)P(2) cause neurodegeneration in human patients and mice. The function of Vac14 in the regulation of PI(3,5)P(2) was uncharacterized previously. Here, we predict that yeast and mammalian Vac14 are composed entirely of HEAT repeats and demonstrate that Vac14 exerts an effect as a scaffold for the PI(3,5)P(2) regulatory complex by direct contact with the known regulators of PI(3,5)P(2): Fig4, Fab1, Vac7 and Atg18. We also report that the mouse mutant ingls (infantile gliosis) results from a missense mutation in Vac14 that prevents the association of Vac14 with Fab1, generating a partial complex. Analysis of ingls and two additional mutants provides insight into the organization of the PI(3,5)P(2) regulatory complex and indicates that Vac14 mediates three distinct mechanisms for the rapid interconversion of PI3P and PI(3,5)P(2). Moreover, these studies show that the association of Fab1 with the complex is essential for viability in the mouse.},
  isbn = {1460-2075 (Electronic)},
  keywords = {Amino Acid,Amino Acid Substitution/genetics,Animals,Biological,Fetal Viability,Flavoproteins/metabolism,Humans,Inbred C57BL,Inbred DBA,Intracellular Signaling Peptides and,Knockout,Membrane Proteins/chemistry/genetics/*metabolism,Mice,Mice/*metabolism,Missense,Models,Mutation,Phosphatidylinositol Phosphates/*metabolism,Phosphatidylinositols/*metabolism,Phosphotransferases (Alcohol Group Acceptor)/metab,Protein Binding,Protein Interaction Domains and Motifs,Protein Structure,Proteins/chemistry/genetics/*metabolism,Repetitive Sequences,Saccharomyces cerevisiae Proteins/metabolism,Saccharomyces cerevisiae/*metabolism,Secondary,Two-Hybrid System Techniques,weisman}
}

