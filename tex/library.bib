@article{Astle2007,
  title = {The Inositol Polyphosphate 5-Phosphatases: Traffic Controllers, Waistline Watchers and Tumour Suppressors?},
  author = {Astle, Megan V and a Horan, Kristy and Ooms, Lisa M and a Mitchell, Christina},
  year = {2007},
  month = jan,
  journal = {Biochemical Society symposium},
  volume = {181},
  number = {74},
  eprint = {17233589},
  eprinttype = {pubmed},
  pages = {161--81},
  issn = {0067-8694},
  doi = {10.1042/BSS0740161},
  abstract = {Phosphoinositide signals regulate cell proliferation, differentiation, cytoskeletal rearrangement and intracellular trafficking. Hydrolysis of PtdIns(4,5)P2 and PtdIns(3,4,5)P3, by inositol polyphosphate 5-phosphatases regulates synaptic vesicle recycling (synaptojanin-1), hematopoietic cell function [SHIP1(SH2-containing inositol polyphosphate 5-phosphatase-1)], renal cell function [OCRL (oculocerebrorenal syndrome of Lowe)] and insulin signalling (SHIP2). We present here a detailed review of the characteristics of the ten mammalian 5-phosphatases. Knockout mouse phenotypes and underexpression studies are associated with significant phenotypic changes, indicating non-redundant roles, despite, in many cases, overlapping substrate specificity and tissue expression. The extraordinary complexity in the control of phosphoinositide signalling continues to be revealed.},
  pmid = {17233589},
  keywords = {Animals,Humans,Insulin,Insulin: metabolism,Isoenzymes,Isoenzymes: chemistry,Isoenzymes: genetics,Isoenzymes: metabolism,Isoenzymes: physiology,Models Biological,Oculocerebrorenal Syndrome,Oculocerebrorenal Syndrome: enzymology,Oculocerebrorenal Syndrome: genetics,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 3-Kinases: metabolism,Phosphoric Monoester Hydrolases,Phosphoric Monoester Hydrolases: chemistry,Phosphoric Monoester Hydrolases: genetics,Phosphoric Monoester Hydrolases: metabolism,Phosphoric Monoester Hydrolases: physiology,Protein Structure Tertiary,Synaptic Vesicles,Synaptic Vesicles: metabolism}
}

