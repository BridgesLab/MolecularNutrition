@article{CarlosMartinZoppino2010,
  title = {Autophagosome {{Formation Depends}} on the {{Small GTPase Rab1}} and {{Functional ER Exit Sites}}.},
  author = {Carlos Mart{\'i}n Zoppino, Felipe and Dami{\'a}n Militello, Rodrigo and Slavin, Ileana and Alvarez, Cecilia and Colombo, Mar{\'i}a I},
  year = {2010},
  month = jun,
  journal = {Traffic},
  number = {1},
  eprint = {20545908},
  eprinttype = {pubmed},
  issn = {1600-0854},
  doi = {10.1111/j.1600-0854.2010.01086.x},
  urldate = {2010-07-18},
  abstract = {Autophagy is an important cellular degradation pathway present in all eukaryotic cells. Via this pathway, portions of the cytoplasm and/or organelles are sequestered in double-membrane structures called autophagosomes. In spite of the significant advance achieved in autophagy, the long-standing question about the source of the autophagic membrane remains unsolved. We have investigated the role of the secretory pathway in autophagosome biogenesis. Sar1 and Rab1b are monomeric GTPases that control traffic from the endoplasmic reticulum (ER) to the Golgi. We present evidence indicating that the activity of both proteins is required for autophagosome formation. Overexpression of dominant-negative mutants and the use of siRNAs impaired autophagosome generation as determined by LC3 puncta formation and light chain 3 (LC3)-II processing. In addition, our results indicate that the autophagic and secretory pathways intersect at a level preceding the brefeldin A blockage, suggesting that the transport from the cis/medial Golgi is not necessary for autophagosome biogenesis. Our present results highlight the role of transport from the ER in the initial events of the autophagic vacuole development.},
  pmid = {20545908},
  keywords = {autophagosomes,autophagy,er exit sites,lc3,lication 3 june 2010,pub-,rab1,received 16 october 2009,revised and accepted for,sar1,uncorrected manuscript published,vtc}
}

@article{Carlotti2004,
  title = {Lentiviral Vectors Efficiently Transduce Quiescent Mature {{3T3-L1}} Adipocytes.},
  author = {Carlotti, Fran{\c c}oise and Bazuine, Merlijn and Kekarainen, Tuija and Seppen, Jurgen and Pognonec, Philippe and Maassen, J Antonie and Hoeben, Rob C},
  year = {2004},
  month = feb,
  journal = {Molecular therapy : the journal of the American Society of Gene Therapy},
  volume = {9},
  number = {2},
  eprint = {14759805},
  eprinttype = {pubmed},
  pages = {209--17},
  issn = {1525-0016},
  doi = {10.1016/j.ymthe.2003.11.021},
  abstract = {Obesity is associated with many serious afflictions such as cardiovascular disease, cancer, and diabetes. One of the main cellular systems used to study the underlying physiological and biological processes is the 3T3-L1 preadipocyte differentiation model. However, studies on 3T3-L1 adipocytes are hampered by the fact that genetic modification of mature adipocytes is notoriously difficult. In this report, we evaluated the use of lentivirus-mediated gene transfer into 3T3-L1 mature adipocytes. We demonstrate that quiescent, fully differentiated 3T3-L1 adipocytes as well as 3T3-L1 preadipocytes can be efficiently transduced with HIV-1-derived lentiviral vectors. Upon transduction using LV-PGK-GFP lentiviral vector at 100 ng p24 per 10(5) cells, more than 95\% of the 3T3-L1 adipocytes in the culture expressed the GFP reporter gene. There were no overt signs of toxicity or cytopathogenicity in the cultures. Furthermore, modification of undifferentiated preadipocytes did not affect their capacity to differentiate. In addition, insulin-induced glucose uptake was not affected by the procedure. In contrast, adenoviral-mediated gene transfer into 3T3-L1 adipocytes is associated with marked cytopathogenicity. From these data, we conclude that lentiviral vectors are the gene-transfer system of choice for genetic modification of mature adipocytes. The availability of an efficient vector system may stimulate the use of adipose tissue as a target for gene therapy in obesity and other disorders.},
  pmid = {14759805},
  keywords = {3T3-L1 Cells,Adipocytes,Adipocytes: metabolism,Adipocytes: virology,Animals,Biological Transport,Biological Transport: drug effects,Genes Reporter,Genes Reporter: genetics,Genetic Vectors,Genetic Vectors: genetics,Glucose,Glucose: metabolism,Green Fluorescent Proteins,Insulin,Insulin: pharmacology,Lentivirus,Lentivirus: genetics,Lentivirus: physiology,Luminescent Proteins,Luminescent Proteins: genetics,Mice,Phosphoglycerate Kinase,Phosphoglycerate Kinase: genetics,Phosphoglycerate Kinase: metabolism,Transduction Genetic,Vesicular stomatitis Indiana virus,Vesicular stomatitis Indiana virus: genetics,Vesicular stomatitis Indiana virus: physiology}
}

