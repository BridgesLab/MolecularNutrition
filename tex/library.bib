@article{whiteRacialDifferencesVivo2018,
  title = {Racial Differences in in Vivo Adipose Lipid Kinetics in Humans},
  author = {White, Ursula A. and Fitch, Mark D. and Beyl, Robbie A. and Hellerstein, Marc K. and Ravussin, Eric},
  year = {2018},
  month = sep,
  journal = {Journal of Lipid Research},
  volume = {59},
  number = {9},
  pages = {1738--1744},
  publisher = {Elsevier},
  issn = {0022-2275, 1539-7262},
  doi = {10.1194/jlr.P082628},
  urldate = {2022-11-10},
  abstract = {{$<$}p{$>$}The storage of lipids in the form of triglycerides (TGs) and the de novo synthesis (lipogenesis) of fatty acids from nonlipid precursors [de novo lipogenesis (DNL)] are important functions of adipose tissue (AT) that influence whole-body metabolism. Yet, few studies have reported in vivo estimates of adipose lipid kinetics in humans. Fifty-two women with obesity (27 African-American and 25 Caucasian; 29.7 {\textpm} 5.5 years; BMI 32.2 {\textpm} 2.8 kg/m\textsuperscript{2}; 44.3 {\textpm} 4.0\% body fat) were enrolled in the study. In vivo synthesis (or replacement) of TGs (f\textsubscript{TG}) as well as the synthesis of the fatty acid, palmitate [a measure of adipose DNL (f\textsubscript{DNL})], were assessed using an 8 week incorporation of deuterium into lipids (glycerol and palmitate moieties of TGs) in subcutaneous abdominal (scABD) and subcutaneous femoral (scFEM) AT. We report, for the first time, significant race differences in both TG synthesis and absolute DNL, with Caucasians having higher f\textsubscript{TG} and f\textsubscript{DNL} as compared with African-Americans. The DNL contribution to newly synthesized TG (corrected f\textsubscript{DNL}) was not different between races. Interestingly, our findings also show that the scFEM adipose depot had higher TG replacement rates relative to the scABD. Finally, the replacement rate of TG (f\textsubscript{TG}) was negatively correlated with changes in body weight over the 8 week labeling period. Our results provide the first evidence that in vivo TG replacement (synthesis and breakdown) rates differ by ethnicity. In addition, TG turnover varies by depot location in humans, implying an increased capacity for TG storage and higher lipolytic activity in the scFEM AT.{$<$}/p{$>$}},
  langid = {english},
  pmid = {29910190},
  file = {/Users/davebrid/Zotero/storage/88D2CW6F/White et al. - 2018 - Racial differences in in vivo adipose lipid kineti.pdf;/Users/davebrid/Zotero/storage/SIIZJFWI/fulltext.html}
}

@article{Whitman1988a,
  title = {Type {{I}} Phosphatidylinositol Kinase Makes a Novel Inositol Phospholipid, Phosphatidylinositol-3-Phosphate.},
  author = {Whitman, M and Downes, C P and Keeler, M and Keller, T and Cantley, Lewis~C.},
  year = {1988},
  month = apr,
  journal = {Nature},
  volume = {332},
  number = {6165},
  eprint = {2833705},
  eprinttype = {pubmed},
  pages = {644--6},
  issn = {0028-0836},
  doi = {10.1038/332644a0},
  urldate = {2011-09-01},
  abstract = {The generation of second messengers from the hydrolysis of phosphatidylinositol-4,5-bisphosphate (PtdInsP2) by phosphoinositidase C has been implicated in the mediation of cellular responses to a variety of growth factors and oncogene products. The first step in the production of PtdInsP2 from phosphatidylinositol (PtdIns) is catalysed by PtdIns kinase. A PtdIns kinase activity has been found to associate specifically with several oncogene products, as well as with the platelet-derived growth factor (PDGF) receptor. We have previously identified two biochemically distinct PtdIns kinases in fibroblasts, and have found that only one of these, designated type I, specifically associates with activated tyrosine kinases. We have now characterized the site on the inositol ring phosphorylated by type I PtdIns kinase, and find that this kinase specifically phosphorylates the D-3 ring position to generate a novel phospholipid, phosphatidylinositol-3-phosphate (PtdIns(3)P). In contrast, the main PtdIns kinase in fibroblasts, designated type II, specifically phosphorylates the D-4 position to produce phosphatidylinositol-4-phosphate (PtdIns(4)P), previously considered to be the only form of PtdInsP. We have also tentatively identified PtdIns(3)P as a minor component of total PtdInsP in intact fibroblasts. We propose that type I PtdIns kinase is responsible for the generation of PtdIns(3)P in intact cells, and that this novel phosphoinositide could be important in the transduction of mitogenic and oncogenic signals.},
  pmid = {2833705},
  keywords = {1-Phosphatidylinositol 4-Kinase,5-Diphosphate,Cell Line,Fibroblasts,Fibroblasts: enzymology,historical,Inositol,Inositol: metabolism,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 4,Phosphatidylinositol Phosphates,Phosphatidylinositols,Phosphatidylinositols: metabolism,Phosphorylation,Phosphotransferases,Phosphotransferases: metabolism,phosphotyrosine,pi345p3,pi3k,pi3p,Polymers,Polymers: metabolism,Transformed}
}

