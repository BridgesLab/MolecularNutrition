@article{Cnattingius2012,
  title = {High Birth Weight and Obesity--a Vicious Circle across Generations.},
  author = {Cnattingius, S and Villamor, E and Lagerros, Y T and Wikstr{\"o}m, a-K and Granath, F},
  year = {2012},
  month = oct,
  journal = {International journal of obesity (2005)},
  volume = {36},
  number = {10},
  eprint = {22158263},
  eprinttype = {pubmed},
  pages = {1320--4},
  issn = {1476-5497},
  doi = {10.1038/ijo.2011.248},
  urldate = {2014-03-26},
  abstract = {OBJECTIVES: Rates of high birth weight infants, overweight and obese children and adults are increasing. The associations between birth weight and adult weight may have consequences for the obesity epidemic across generations. We examined the association between mothers' birth weight for gestational age and adult body mass index (BMI) and these factors' joint effect on risk of having a large-for-gestational-age (LGA) offspring ({$>$}+2 s.d. above the mean). DESIGN: A cohort of 162\,676 mothers and their first-born offspring with birth information recorded on mothers and offspring in the nation-wide Swedish Medical Birth Register 1973-2006. RESULTS: Compared with mothers with appropriate birth weight for gestational age (AGA; -1 to +1 s.d.), mothers born LGA had increased risks of overweight (BMI 25.0-29.9; odds ratio (OR), 1.50; 95\% CI 1.39-1.61), obesity class I (BMI 30.0-34.9; OR 1.77; 95\% CI 1.59-1.98), obesity class II (BMI 35.0-39.9; OR 2.77; 95\% CI 2.37-3.24) and obesity class III (BMI {$\geq$}40.0; OR 2.04; 95\% CI 1.49-2.80). In each stratum of mother's birth weight for gestational age, risk of having an LGA offspring increased with mother's BMI. The risk of an LGA offspring was highest among women with a high ({$\geq$}30) BMI who also had a high birth weight for gestational age ({$>$}+1 s.d.). In these groups, the ORs for LGA offspring ranged from 5 to 14 when compared with mothers born AGA with normal BMI ({$\leq$}24.9). However, the strongest increase in risk by BMI was seen among mothers born SGA: the OR of having an LGA offspring was 13 times as high among SGA mothers with BMI {$\geq$}35.0 compared with the OR among SGA mothers with normal BMI (ORs=4.61 and 0.35, respectively). CONCLUSIONS: Prenatal conditions are important for the obesity epidemic. Prevention of LGA births may contribute to curtail the intergenerational vicious cycle of obesity.},
  pmid = {22158263},
  keywords = {Adult,Birth Weight,Body Mass Index,Cohort Studies,Epidemics,Female,Fetal Macrosomia,Fetal Macrosomia: epidemiology,Fetal Macrosomia: prevention & control,Health Promotion,Humans,Infant Newborn,Male,Mothers,Mothers: statistics & numerical data,Obesity,Obesity: epidemiology,Obesity: prevention & control,Odds Ratio,Pregnancy,Risk Factors,Sweden,Sweden: epidemiology}
