@article{Bollen1998,
  title = {Specific Features of Glycogen Metabolism in the Liver.},
  author = {Bollen, Mathieu and Keppens, S and Stalmans, Willy},
  year = {1998},
  journal = {The Biochemical journal},
  volume = {336 ( Pt 1},
  pages = {19--31},
  issn = {0264-6021},
  doi = {10.1042/bj3360019},
  abstract = {Although the general pathways of glycogen synthesis and glycogenolysis are identical in all tissues, the enzymes involved are uniquely adapted to the specific role of glycogen in different cell types. In liver, where glycogen is stored as a reserve of glucose for extrahepatic tissues, the glycogen-metabolizing enzymes have properties that enable the liver to act as a sensor of blood glucose and to store or mobilize glycogen according to the peripheral needs. The prime effector of hepatic glycogen deposition is glucose, which blocks glycogenolysis and promotes glycogen synthesis in various ways. Other glycogenic stimuli for the liver are insulin, glucocorticoids, parasympathetic (vagus) nerve impulses and gluconeogenic precursors such as fructose and amino acids. The phosphorolysis of glycogen is mainly mediated by glucagon and by the orthosympathetic neurotransmitters noradrenaline and ATP. Many glycogenolytic stimuli, e.g. adenosine, nucleotides and NO, also act indirectly, via secretion of eicosanoids from non-parenchymal cells. Effectors often initiate glycogenolysis cooperatively through different mechanisms.},
  isbn = {0264-6021 (Print){\textbackslash}r0264-6021 (Linking)},
  pmid = {9806880},
  keywords = {Amino Acids,Amino Acids: pharmacology,Animals,Carbohydrates,Carbohydrates: pharmacology,Enzymes,Enzymes: metabolism,Glucocorticoids,Glucocorticoids: pharmacology,glycogen,Glycogen,glycogen synthase,Glycogen: metabolism,Hydrolysis,Insulin,Insulin: pharmacology,Liver,Liver: drug effects,Liver: metabolism}
}

