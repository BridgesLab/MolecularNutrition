  author = {Qi, Qibin and Durst, Ronen and Schwarzfuchs, Dan and Leitersdorf, Eran and Shpitzen, Shoshi and Li, Yanping and Wu, Hongyu and Champagne, Catherine M. and Hu, Frank B. and Stampfer, Meir J. and Bray, George A. and Sacks, Frank M. and Shai, Iris and Qi, Lu},
