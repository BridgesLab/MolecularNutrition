@article{Acheson1988,
  title = {Glycoprotein Storage Capacity and de Novo Lipogenesis during Massive Carbohydrate Overfeeding in Man},
  author = {Acheson, Kevin J. and Schutz, Yves and Bessard, T. and Anantharaman, K. and Flatt, J. P. and Jequier, E.},
