@article{Tabuchi2000,
  title = {Differential Activation of Brain-Derived Neurotrophic Factor Gene Promoters {{I}} and {{III}} by {{Ca2}}+ Signals Evoked via {{L-type}} Voltage-Dependent and {{N-methyl-D-aspartate}} Receptor {{Ca2}}+ Channels},
  author = {Tabuchi, Akiko and Nakaoka, Ryuki and Amano, Kenji and Yukimine, Masaru and Andoh, Tsugunobu and Kuraishi, Yasushi and Tsuda, Masaaki},
  year = {2000},
