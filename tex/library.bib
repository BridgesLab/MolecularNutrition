  journal = {Developmental Cell},
  volume = {3},
  number = {1},
  eprint = {12110165},
  eprinttype = {pubmed},
  pages = {25--38},
  issn = {15345807},
  doi = {10.1016/S1534-5807(02)00199-5},
  urldate = {2011-05-25},
  abstract = {Insulin signaling in adipose tissue plays an important role in lipid storage and regulation of glucose homeostasis. Using the Cre-loxP system, we created mice with fat-specific disruption of the insulin receptor gene (FIRKO mice). These mice have low fat mass, loss of the normal relationship between plasma leptin and body weight, and are protected against age-related and hypothalamic lesion-induced obesity, and obesity-related glucose intolerance. FIRKO mice also exhibit polarization of adipocytes into populations of large and small cells, which differ in expression of fatty acid synthase, C/EBP??, and SREBP-1. Thus, insulin signaling in adipocytes is critical for development of obesity and its associated metabolic abnormalities, and abrogation of insulin signaling in fat unmasks a heterogeneity in adipocyte response in terms of gene expression and triglyceride storage.},
  isbn = {1534-5807},
  pmid = {12110165},
  keywords = {Adipocytes,Adipocytes: metabolism,Adiponectin,Adipose Tissue,Adipose Tissue: metabolism,Adipose Tissue: physiopathology,Animals,Aurothioglucose,Aurothioglucose: pharmacology,Body Weight,Body Weight: genetics,CCAAT-Enhancer-Binding Proteins,CCAAT-Enhancer-Binding Proteins: genetics,CCAAT-Enhancer-Binding Proteins: metabolism,Cell Size,Cell Size: genetics,Diabetes Mellitus,DNA-Binding Proteins,DNA-Binding Proteins: genetics,DNA-Binding Proteins: metabolism,Energy Metabolism,Energy Metabolism: genetics,Female,FIRKO,Glucose,Glucose Intolerance,Glucose Intolerance: genetics,Glucose Intolerance: metabolism,Glucose Intolerance: physiopathology,Glucose Transporter Type 1,Glucose Transporter Type 4,Glucose: metabolism,Insulin,Insulin: deficiency,Insulin: genetics,Insulin: metabolism,Intercellular Signaling Peptides and Proteins,Knockout,Leptin,Leptin: blood,lipolysis,Male,Mice,Monosaccharide Transport Proteins,Monosaccharide Transport Proteins: genetics,Monosaccharide Transport Proteins: metabolism,Muscle Proteins,Obesity,Obesity: genetics,Obesity: metabolism,Obesity: physiopathology,Proteins,Proteins: genetics,Proteins: metabolism,Receptor,Sterol Regulatory Element Binding Protein 1,Transcription Factors,Type 2,Type 2: genetics,Type 2: metabolism,Type 2: physiopathology,Ventromedial Hypothalamic Nucleus,Ventromedial Hypothalamic Nucleus: drug effects,Ventromedial Hypothalamic Nucleus: pathology,Ventromedial Hypothalamic Nucleus: physiopathology}
