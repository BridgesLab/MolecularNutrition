@article{Okada-Iwabu2013,
  title = {A Small-Molecule {{AdipoR}} Agonist for Type 2 Diabetes and Short Life in Obesity.},
  author = {{Okada-Iwabu}, Miki and Yamauchi, Toshimasa and Iwabu, Masato and Honma, Teruki and Hamagami, Ken-ichi and Matsuda, Koichi and Yamaguchi, Mamiko and Tanabe, Hiroaki and {Kimura-Someya}, Tomomi and Shirouzu, Mikako and Ogata, Hitomi and Tokuyama, Kumpei and Ueki, Kohjiro and Nagano, Tetsuo and Tanaka, Akiko and Yokoyama, Shigeyuki and Kadowaki, Takashi},
  year = {2013},
  month = nov,
  journal = {Nature},
  volume = {503},
  number = {7477},
  eprint = {24172895},
  eprinttype = {pubmed},
  pages = {493--9},
  publisher = {Nature Publishing Group},
  issn = {1476-4687},
  doi = {10.1038/nature12656},
  urldate = {2014-04-28},
  abstract = {Adiponectin secreted from adipocytes binds to adiponectin receptors AdipoR1 and AdipoR2, and exerts antidiabetic effects via activation of AMPK and PPAR-{$\alpha$} pathways, respectively. Levels of adiponectin in plasma are reduced in obesity, which causes insulin resistance and type 2 diabetes. Thus, orally active small molecules that bind to and activate AdipoR1 and AdipoR2 could ameliorate obesity-related diseases such as type 2 diabetes. Here we report the identification of orally active synthetic small-molecule AdipoR agonists. One of these compounds, AdipoR agonist (AdipoRon), bound to both AdipoR1 and AdipoR2 in vitro. AdipoRon showed very similar effects to adiponectin in muscle and liver, such as activation of AMPK and PPAR-{$\alpha$} pathways, and ameliorated insulin resistance and glucose intolerance in mice fed a high-fat diet, which was completely obliterated in AdipoR1 and AdipoR2 double-knockout mice. Moreover, AdipoRon ameliorated diabetes of genetically obese rodent model db/db mice, and prolonged the shortened lifespan of db/db mice on a high-fat diet. Thus, orally active AdipoR agonists such as AdipoRon are a promising therapeutic approach for the treatment of obesity-related diseases such as type 2 diabetes.},
  pmid = {24172895},
  keywords = {Adenylate Kinase,Adenylate Kinase: metabolism,Adiponectin,Adiponectin: metabolism,Adiponectin: pharmacology,Adipose Tissue White,Adipose Tissue White: drug effects,Adipose Tissue White: metabolism,Adipose Tissue White: pathology,Administration Oral,Animals,Diabetes Mellitus Type 2,Diabetes Mellitus Type 2: complications,Diabetes Mellitus Type 2: drug therapy,Diabetes Mellitus Type 2: metabolism,Diabetes Mellitus Type 2: prevention & control,Diet High-Fat,Drug Evaluation Preclinical,Dyslipidemias,Dyslipidemias: drug therapy,Enzyme Activation,Enzyme Activation: drug effects,Glucose Intolerance,Glucose Intolerance: drug therapy,Inflammation,Inflammation: drug therapy,Insulin Resistance,Liver,Liver: drug effects,Liver: metabolism,Liver: pathology,Longevity,Longevity: drug effects,Mice,Mitochondria,Mitochondria: drug effects,Mitochondria: metabolism,Muscle Fibers Skeletal,Muscle Fibers Skeletal: cytology,Muscle Fibers Skeletal: drug effects,Muscles,Muscles: cytology,Obesity,Obesity: complications,Obesity: drug therapy,Obesity: genetics,Obesity: physiopathology,Oxidative Stress,Oxidative Stress: drug effects,Piperidines,Piperidines: administration & dosage,Piperidines: metabolism,Piperidines: pharmacology,Piperidines: therapeutic use,PPAR alpha,PPAR alpha: metabolism,Receptors Adiponectin,Receptors Adiponectin: agonists,Receptors Adiponectin: deficiency,Receptors Adiponectin: genetics,Receptors Adiponectin: metabolism,Signal Transduction,Signal Transduction: drug effects,Small Molecule Libraries,Small Molecule Libraries: chemistry,Transcription Factors,Transcription Factors: biosynthesis,Triglycerides,Triglycerides: metabolism}
}

@article{Okada1994,
  title = {Essential Role of Phosphatidylinositol 3-Kinase in Insulin-Induced Glucose Transport and Antilipolysis in Rat Adipocytes. {{Studies}} with a Selective Inhibitor Wortmannin.},
  author = {Okada, T and Kawano, Y and Sakakibara, T and Hazeki, O and Ui, M},
  year = {1994},
  month = feb,
  journal = {The Journal of biological chemistry},
  volume = {269},
  number = {5},
  eprint = {8106400},
  eprinttype = {pubmed},
  pages = {3568--73},
  issn = {0021-9258},
  abstract = {Significant activity of phosphatidylinositol 3-kinase (PI 3-kinase) was detected in the membrane fractions, or in the immunoprecipitates prepared with anti-phosphotyrosine antibodies, from rat adipocytes that had been incubated with insulin for 20 min. The PI 3-kinase activity in these preparations as well as in the whole cell lysates of adipocytes not treated with insulin was inhibited by the addition of wortmannin, a fungal metabolite, to the enzyme assay mixture. The inhibition was dependent on the inhibitor concentration with IC50 being less than 10 nM and perfect inhibition at 100 nM. The effect of insulin to induce membrane PI 3-kinase activity was mostly abolished, but its effects to tyrosine-phosphorylate the beta-subunit of the insulin receptor or other cellular substrate proteins including insulin-receptor-substrate-1 were not at all antagonized, by wortmannin added to the cell incubation medium. Insulin stimulation of cellular 2-deoxyglucose uptake and inhibition of isoproterenol-induced lipolysis observable in adipocytes under the same conditions were also antagonized by wortmannin added in the same concentration range as used for the inhibition of insulin-susceptible PI 3-kinase. It is concluded, therefore, that activation of wortmannin-sensitive PI 3-kinase plays a pivotal role in the intracellular signaling pathways arising from the insulin receptor autophosphorylation and leading to certain metabolic responses.},
  pmid = {8106400},
  keywords = {Adipocytes,Adipocytes: drug effects,Adipocytes: enzymology,Adipocytes: metabolism,akt,Androstadienes,Androstadienes: pharmacology,Animals,Anti-Inflammatory Agents,Biological Transport,Biological Transport: drug effects,Cells,Cultured,Cytosol,Cytosol: enzymology,Deoxyglucose,Deoxyglucose: metabolism,Glucose,glucose uptake,Glucose: metabolism,glut4,Hydrogen Peroxide,Hydrogen Peroxide: pharmacology,Insulin,Insulin: pharmacology,Isoproterenol,Isoproterenol: pharmacology,Kinetics,Lipolysis,Lipolysis: drug effects,Non-Steroidal,Non-Steroidal: pharmacol,Phosphatidylinositol 3-Kinases,Phosphotransferases (Alcohol Group Acceptor),Phosphotransferases (Alcohol Group Acceptor): anta,Phosphotransferases (Alcohol Group Acceptor): meta,Rats,wortmannin}
}

@article{Okada2007,
  title = {Synip Phosphorylation Is Required for Insulin-Stimulated {{Glut4}} Translocation.},
  author = {Okada, Shuichi and Ohshima, Kihachi and Uehara, Yutaka and Shimizu, Hiroyuki and Hashimoto, Koshi and Yamada, Masanobu and Mori, Masatomo},
  year = {2007},
  month = apr,
  journal = {Biochemical and biophysical research communications},
  volume = {356},
  number = {1},
  eprint = {17336927},
  eprinttype = {pubmed},
  pages = {102--6},
  issn = {0006-291X},
  doi = {10.1016/j.bbrc.2007.02.095},
  urldate = {2011-12-29},
  abstract = {Previously we identified an unusual potential dual Akt/protein kinase B consensus phosphorylation motif in the protein Synip (RxKxRS(97)xS(99)) with serine 99 as a unique Akt2, but not Akt1 or for Akt3, substrate phosphorylation site. Although we have previously reported that serine 99 to phenylalanine (S99F-Synip) resulted in a constitutive inhibition of insulin-stimulated Glut4 translocation, a recent report indicated that Synip serine 99 to alanine mutant (S99A-Synip) failed to inhibit insulin-stimulated Glut4 translocation [H. Sano, S. Kane, E. Sano, G.E. Lienhard, Synip phosphorylation does not regulate insulin-stimulated GLUT4 translocation, Biochem. Biophys. Res. Commun. 332 (2005) 880-884]. To address this apparent discrepancy, we have now examined the S99A-Synip mutant and find that this mutant behaves essentially identical to S99F-Synip in that overexpression inhibits insulin-stimulated Glut4 translocation and is incapable of undergoing insulin-stimulated Syntaxin4 dissociation. These data are consistent with Synip serine 99 phosphorylation required for insulin-stimulated Glut4 translocation.},
  pmid = {17336927},
  keywords = {3T3-L1 Cells,Adipocytes,Adipocytes: cytology,Adipocytes: drug effects,Adipocytes: metabolism,Amino Acid Substitution,Animals,beta-Galactosidase,beta-Galactosidase: metabolism,Blotting Western,Electrophoresis,Glucose Transporter Type 4,Glucose Transporter Type 4: genetics,Glucose Transporter Type 4: metabolism,Insulin,Insulin: pharmacology,Mice,Mutation,Phosphorylation,Protein Binding,Protein Binding: drug effects,Protein Transport,Protein Transport: drug effects,Qa-SNARE Proteins,Qa-SNARE Proteins: genetics,Qa-SNARE Proteins: metabolism,Transfection,Vesicular Transport Proteins,Vesicular Transport Proteins: genetics,Vesicular Transport Proteins: metabolism}
