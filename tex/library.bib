@article{NatividadedaSilva2019,
  title = {Impact of Glucocorticoid Treatment before Pregnancy on Glucose Homeostasis of Offspring Exposed to Glucocorticoid in Adult Life},
  author = {{Natividade da Silva}, Fl{\'a}via and Brunetta, Henver Simionato and Bruxel, Maciel Alencar and Gomes, Felipe Azevedo and Rafacho, Alex},
