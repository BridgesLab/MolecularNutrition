@article{Lee2010c,
  title = {A Functional Role for the P62-{{ERK1}} Axis in the Control of Energy Homeostasis and Adipogenesis.},
  author = {Lee, Sang Jun and Pfluger, Paul T. and Kim, Ji Young and Nogueiras, Ruben and Duran, Angeles and Pag{\`e}s, Gilles and Pouyss{\'e}gur, Jacques and Tsch{\"o}p, Matthias H. and {Diaz-Meco}, Maria T and Moscat, Jorge},
