@article{Yanovski2018,
  title = {Weight {{Management}} in {{Adults With Obesity What Is}} a {{Primary Care Clinician}} to {{Do}}?},
  author = {Yanovski, Susan Z},
  year = {2018},
  journal = {Number},
  volume = {320},
  number = {11},
  pages = {1111},
  issn = {0098-7484},
  doi = {10.1001/jama.2018.13022},
  abstract = {In this issue of JAMA, the US Preventive Services Task Force (USPSTF) presents its 2018 recommendation statement 1 and an accompanying evidence review 2 on weight loss interventions to prevent obesity-related morbidity and mortality in adults. In this update of the 2012 USPSTF recommendation, 3 the major recommendation did not substantially change: clini-cians should offer or refer adults with a body mass index (BMI) of 30 or higher to intensive, multicomponent be-havioral interventions. The task force concluded that there is moderate certainty of moderate net benefit, with little risk of harm, and provided an evidence grade of "B," 1 indicating that provision of the service is recommended. Payers often use such recommendations to inform coverage decisions. In addition to behavioral treatments, this update also evaluated pharmacotherapy for obesity treatment. At the time of the 2012 recommendation, only 1 drug, orlistat, was approved by the US Food and Drug Administration (FDA) for long-term use. In 2018, 5 medications are approved by the FDA for long-term management of obesity. 4 It is important to recognize the limited scope of the USPSTF-sponsored review 2 for both behavioral and drug treatments. Because the recommendations are meant to apply to adults without diseases for which weight loss is part of disease management, some large and long-term clinical trials conducted among patients with type 2 diabetes or car-diovascular disease were not included. Although this approach may improve the specificity of the findings for patient populations without overt obesity-related diseases, it means important data on the effect of weight-management interventions among the high proportion of patients in primary care practices with such comorbidities were not considered. For example, Look AHEAD was a 10-year randomized clinical trial that evaluated the effects of an intensive lifestyle intervention vs diabetes support and education on health outcomes in a racially and ethnically diverse population of 5145 adults with overweight/obesity and type 2 diabetes. 5 Although the intensive lifestyle intervention did not demonstrate a beneficial effect on the primary outcome of cardio-vascular disease morbidity and mortality, this intervention had salutary effects on multiple health outcomes, including sleep apnea, urinary incontinence, preservation of physical mobility, progression of chronic kidney disease, depression, and physical health-related quality of life. 6,7 With few large, long-term studies of weight-management interventions evaluating important health outcomes, such data can also help inform decision making for the broader population of patients with obesity. The main USPSFT recommendation is to "offer or refer to" multicomponent treatment. 1 For many clinicians, referral for intensive behavioral treatment will be most practical, as few physicians have the time or skills to provide this treatment. Even if not personally delivering intensive behavioral treatment, clinicians trained in motivational interviewing 8 or the 5As (ask, assess, advise, agree, and assist) counseling framework 9 may help assess readiness for treatment and move patients toward addressing important health-related behaviors. Clinicians familiar with the range of resources in the community offering weight-management treatment can provide patients with choices that best meet their needs. The USPSTF-supported systematic review 2 of behavioral weight-loss studies showed a modest pooled intervention weight loss of 2.4 kg at 12 to 18 months but included a diverse range of interventions ranging from those delivered only via text messaging to intensive in-person interventions. Mean weight change in individual trials ranged from -0.5 kg to -9.3 kg in intervention participants and from +1.4 kg to -5.6 kg in control participants. Overall, behavioral interventions conferred almost twice the probability of 5\% or greater weight loss. Although study heterogeneity precluded identification of the most effective intervention components, most studies included 12 or more sessions in the first year, and other evidence-based reviews have found that face-to-face interventions with high intensity ({$\geq$}14 sessions in 6 months) have the greatest weight-loss benefit. 10 These are important data to consider when clinicians seek appropriate services for their patients. For many individuals, affordable and accessible high-intensity behavioral treatment may not be readily available. Obesity poses a greater burden in rural populations, 11 who may lack access to transportation or comprehensive in-person programs , although delivery of interventions electronically or via telephone offer viable alternatives. Remotely delivered be-havioral obesity treatment could also increase accessibility for older adults and people with disabilities. In addition to weight-management programs delivered in health care or community settings, commercial programs that provide the components of intensive behavioral treatment, and that have demonstrated evidence of effectiveness in clinical trials, can also be affordable and readily available alternative venues for delivery of behavioral weight-management treatment. 10},
  keywords = {The JAMA Network}
}

