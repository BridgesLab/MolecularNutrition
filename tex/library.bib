@article{Kuzmochka2014,
  title = {Inactivation of {{Histone Deacetylase}} 1 ({{Hdac1}}) {{But Not Hdac2 Is Required}} for the {{Glucocorticoid-Dependent Ccaat}}/{{Enhancer Binding Protein $A$}} ({{C}}/{{Ebp$\alpha$}}) {{Expression}} and {{Preadipocyte Differentiation}}.},
  author = {Kuzmochka, Claire and Abdou, Houssein-Salem and Hach{\'e}, Robert J G and Atlas, Ella},
  year = {2014},
  journal = {Endocrinology},
  volume = {1},
  number = {September},
  eprint = {25203139},
  eprinttype = {pubmed},
  pages = {en20141565},
  issn = {1945-7170},
  doi = {10.1210/en.2014-1565},
  abstract = {Several drugs currently used in the management of mood disorders, epilepsy (i.e. valproic acid or VPA) or the control of inflammation (i.e. corticosteroids) have been shown to promote visceral obesity in humans by increasing the number of newly formed adipocytes. VPA is classified as a non-specific histone deacetylase (HDAC) inhibitor, along with trichostatin A (TSA) and butyric acid. In vitro experiments have demonstrated that such molecules greatly enhance the rate of preadipocyte differentiation, similarly to the effect of corticosteroids. The glucocorticoid receptor (GR) stimulates adipogenesis in part by enhancing the transcription of C/ebpa through the titration, and subsequent degradation, of HDAC1 from the C/ebp{$\alpha$} promoter. There is however controversy in the literature as to the role of HDACs during adipogenesis. In this study, we sought to demonstrate using two different strategies the definite role of HDACl in adipogenesis. By using siRNA-mediated knockdown of HDAC1 and by generating an enzymatically inactive HDAC1D181A by site-directed mutagenesis, we were able to show that HDAC1, but not HDAC2, suppresses GR-potentiated preadipocyte differentiation by decreasing C/ebp{$\alpha$} and Ppar{$\gamma$} expression levels at the onset of differentiation. Finally, we demonstrate that HDAC1D181A acts as a dominant negative mutant of HDACl during adipogenesis by modulating C/EBP{$\beta$} transcriptional activity on the C/ebp{$\alpha$} promoter.},
  pmid = {25203139},
  keywords = {journal club}
}

@article{Kuzmochka2014a,
  title = {Inactivation of Histone Deacetylase 1 ({{HDAC1}}) but Not {{HDAC2}} Is Required for the Glucocorticoid-Dependent {{CCAAT}}/Enhancer-Binding Protein ?? ({{C}}/{{EBP}}??) Expression and Preadipocyte Differentiation},
  author = {Kuzmochka, Claire and Abdou, Houssein-Salem and Hach{\'e}, Robert J G and Atlas, Ella},
