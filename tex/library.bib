  title = {{{NAG-1}}/{{GDF-15}} Prevents Obesity by Increasing Thermogenesis, Lipolysis and Oxidative Metabolism},
  author = {Chrysovergis, K. and Wang, X. and Kosak, J. and Lee, S. H. and Kim, J. S. and Foley, J. F. and Travlos, G. and Singh, S. and Baek, S. J. and Eling, T. E.},
  year = {2014},
