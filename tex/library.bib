  author = {Yamada, Eijiro and Okada, Shuichi and Saito, Tsugumichi and Ohshima, Kihachi and Sato, Minoru and Tsuchiya, Takafumi and Uehara, Yutaka and Shimizu, Hiroyuki and Mori, Masatomo},
  year = {2005},
  month = mar,
  journal = {The Journal of cell biology},
  volume = {168},
  number = {6},
  pages = {921--8},
  issn = {0021-9525},
  doi = {10.1083/jcb.200408182},
  urldate = {2011-10-28},
  abstract = {We have identified an unusual potential dual Akt/protein kinase B consensus phosphorylation motif in the protein Synip (RxKxRS(97)xS(99)). Surprisingly, serine 97 is not appreciably phosphorylated, whereas serine 99 is only a specific substrate for Akt2 but not Akt1 or Akt3. Although wild-type Synip (WT-Synip) undergoes an insulin-stimulated dissociation from Syntaxin4, the Synip serine 99 to phenylalanine mutant (S99F-Synip) is resistant to Akt2 phosphorylation and fails to display insulin-stimulated Syntaxin4 dissociation. Furthermore, overexpression of WT-Synip in 3T3L1 adipocytes had no effect on insulin-stimulated recruitment of glucose transporter 4 (GLUT4) to the plasma membrane, whereas overexpression of S99F-Synip functioned in a dominant-interfering manner by preventing insulin-stimulated GLUT4 recruitment and plasma membrane fusion. These data demonstrate that insulin activation of Akt2 specifically regulates the docking/fusion step of GLUT4-containing vesicles at the plasma membrane through the regulation of Synip phosphorylation and Synip-Syntaxin4 interaction.},
  pmid = {15753124},
  keywords = {3T3 Cells,Adipocytes,Adipocytes: drug effects,Adipocytes: metabolism,Animals,Antibodies Monoclonal,Antibodies Monoclonal: metabolism,Blotting Western,CHO Cells,Cricetinae,Cricetulus,Deoxyglucose,Deoxyglucose: metabolism,Glucose Transporter Type 4,Green Fluorescent Proteins,Green Fluorescent Proteins: metabolism,Insulin,Insulin: metabolism,Kinetics,Membrane Fusion,Mice,Microscopy Confocal,Monosaccharide Transport Proteins,Monosaccharide Transport Proteins: metabolism,Muscle Proteins,Muscle Proteins: metabolism,Phosphorylation,Precipitin Tests,Protein-Serine-Threonine Kinases,Protein-Serine-Threonine Kinases: metabolism,Proto-Oncogene Proteins,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins: metabolism,Time Factors,Transport Vesicles,Transport Vesicles: metabolism,Vesicular Transport Proteins,Vesicular Transport Proteins: metabolism}
}

