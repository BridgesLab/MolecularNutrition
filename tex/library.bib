  keywords = {1-Phosphatidylinositol 4-Kinase,1-Phosphatidylinositol 4-Kinase: chemistry,1-Phosphatidylinositol 4-Kinase: genetics,1-Phosphatidylinositol 4-Kinase: physiology,Animals,Cell Membrane,Cell Membrane: physiology,Isoenzymes,Lipid Metabolism,Phosphatidylinositol Phosphates,Phosphatidylinositol Phosphates: metabolism,pi45p2,pi4k,pi4p,review,Signal Transduction,Transport Vesicles,Transport Vesicles: metabolism}
