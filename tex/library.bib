@article{Bussiere2006,
  title = {The Impact of the {{mTOR}} Inhibitor Sirolimus on the Proliferation and Function of Pancreatic Islets and Ductal Cells.},
  author = {Bussiere, C T and Lakey, J R T and Shapiro, a M J and Korbutt, G S},
