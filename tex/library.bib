  shorttitle = {Tirzepatide on Ingestive Behavior in Adults with Overweight or Obesity},
  author = {Martin, Corby K. and Carmichael, Owen T. and Carnell, Susan and Considine, Robert V. and Kareken, David A. and Dydak, Ulrike and Mattes, Richard D. and Scott, David and Shcherbinin, Sergey and Nishiyama, Hiroshi and Knights, Alastair and Urva, Shweta and Biernat, Lukasz and Pratt, Edward and Haupt, Axel and Mintun, Mark and Otero Svaldi, Diana and Milicevic, Zvonko and Coskun, Tamer},
