  keywords = {Animals,Base Sequence,Blotting Western,Cell Line,DNA Primers,Electrophoresis Polyacrylamide Gel,Endoplasmic Reticulum,Endoplasmic Reticulum: metabolism,Leucine,Leucine: metabolism,Mice,Muscle Skeletal,Muscle Skeletal: cytology,Muscle Skeletal: enzymology,Muscle Skeletal: metabolism,Phosphorylation,Polymerase Chain Reaction,Proteins,Proteins: antagonists & inhibitors,Proto-Oncogene Proteins c-akt,Proto-Oncogene Proteins c-akt: metabolism,Thapsigargin,Thapsigargin: pharmacology,Tunicamycin,Tunicamycin: pharmacology}
