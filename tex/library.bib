@article{streissguthEffectsMaternalAlcohol1980,
  title = {Effects of Maternal Alcohol, Nicotine, and Caffeine Use during Pregnancy on Infant Mental and Motor Development at Eight Months},
  author = {Streissguth, A. P. and Barr, H. M. and Martin, D. C. and Herman, C. S.},
