@article{Teleman2010,
  title = {Molecular Mechanisms of Metabolic Regulation by Insulin in {{Drosophila}}.},
  author = {a Teleman, Aurelio},
  year = {2010},
  month = jan,
  journal = {The Biochemical journal},
  volume = {425},
  number = {1},
  eprint = {20001959},
  eprinttype = {pubmed},
  pages = {13--26},
  issn = {1470-8728},
  doi = {10.1042/BJ20091181},
  urldate = {2010-09-21},
  abstract = {The insulin signalling pathway is highly conserved from mammals to Drosophila. Insulin signalling in the fly, as in mammals, regulates a number of physiological functions, including carbohydrate and lipid metabolism, tissue growth and longevity. In the present review, I discuss the molecular mechanisms by which insulin signalling regulates metabolism in Drosophila, comparing and contrasting with the mammalian system. I discuss both the intracellular signalling network, as well as the communication between organs in the fly.},
