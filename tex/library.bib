@article{auneMaternalBodyMass2014,
  title = {Maternal {{Body Mass Index}} and the {{Risk}} of {{Fetal Death}}, {{Stillbirth}}, and {{Infant Death}}},
  author = {Aune, Dagfinn and Saugstad, Ola Didrik and Henriksen, Tore and Tonstad, Serena},
  year = {2014},
  month = apr,
  journal = {JAMA},
  volume = {311},
  number = {15},
  pages = {1536},
  publisher = {American Medical Association},
  issn = {0098-7484},
  doi = {10.1001/jama.2014.2269},
  abstract = {{$<$}h3{$>$}Importance{$<$}/h3{$><$}p{$>$}Evidence suggests that maternal obesity increases the risk of fetal death, stillbirth, and infant death; however, the optimal body mass index (BMI) for prevention is not known.{$<$}/p{$><$}h3{$>$}Objective{$<$}/h3{$><$}p{$>$}To conduct a systematic review and meta-analysis of cohort studies of maternal BMI and risk of fetal death, stillbirth, and infant death.{$<$}/p{$><$}h3{$>$}Data Sources{$<$}/h3{$><$}p{$>$}The PubMed and Embase databases were searched from inception to January 23, 2014.{$<$}/p{$><$}h3{$>$}Study Selection{$<$}/h3{$><$}p{$>$}Cohort studies reporting adjusted relative risk (RR) estimates for fetal death, stillbirth, or infant death by at least 3 categories of maternal BMI were included.{$<$}/p{$><$}h3{$>$}Data Extraction{$<$}/h3{$><$}p{$>$}Data were extracted by 1 reviewer and checked by the remaining reviewers for accuracy. Summary RRs were estimated using a random-effects model.{$<$}/p{$><$}h3{$>$}Main Outcomes and Measures{$<$}/h3{$><$}p{$>$}Fetal death, stillbirth, and neonatal, perinatal, and infant death.{$<$}/p{$><$}h3{$>$}Results{$<$}/h3{$><$}p{$>$}Thirty eight studies (44 publications) with more than 10\,147 fetal deaths, more than 16\,274 stillbirths, more than 4311 perinatal deaths, 11\,294 neonatal deaths, and 4983 infant deaths were included. The summary RR per 5-unit increase in maternal BMI for fetal death was 1.21 (95\% CI, 1.09-1.35;\emph{I2}\,=\,77.6\%; n\,=\,7 studies); for stillbirth, 1.24 (95\% CI, 1.18-1.30;\emph{I2}\,=\,80\%; n\,=\,18 studies); for perinatal death, 1.16 (95\% CI, 1.00-1.35;\emph{I2}\,=\,93.7\%; n\,=\,11 studies); for neonatal death, 1.15 (95\% CI, 1.07-1.23;\emph{I2}\,=\,78.5\%; n\,=\,12 studies); and for infant death, 1.18 (95\% CI, 1.09-1.28;\emph{I2}\,=\,79\%; n\,=\,4 studies). The test for nonlinearity was significant in all analyses but was most pronounced for fetal death. For women with a BMI of 20 (reference standard for all outcomes), 25, and 30, absolute risks per 10\,000 pregnancies for fetal death were 76, 82 (95\% CI, 76-88), and 102 (95\% CI, 93-112); for stillbirth, 40, 48 (95\% CI, 46-51), and 59 (95\% CI, 55-63); for perinatal death, 66, 73 (95\% CI, 67-81), and 86 (95\% CI, 76-98); for neonatal death, 20, 21 (95\% CI, 19-23), and 24 (95\% CI, 22-27); and for infant death, 33, 37 (95\% CI, 34-39), and 43 (95\% CI, 40-47), respectively.{$<$}/p{$><$}h3{$>$}Conclusions and Relevance{$<$}/h3{$><$}p{$>$}Even modest increases in maternal BMI were associated with increased risk of fetal death, stillbirth, and neonatal, perinatal, and infant death. Weight management guidelines for women who plan pregnancies should take these findings into consideration to reduce the burden o{\dots}}
}

@article{Aurbach2018,
  title = {Half-{{Life Your Message}}: {{A Quick}}, {{Flexible Tool}} for {{Message Discovery}}:},
  author = {Aurbach, Elyse L. and Prater, Katherine E. and Patterson, Brandon and {Zikmund-Fisher}, Brian J.},
  year = {2018},
  journal = {Https://Doi.Org/10.1177/1075547018781917},
  doi = {10.1177/1075547018781917},
  abstract = {Academic writers and presenters need concrete activities to help them learn how to communicate more effectively. We describe such a tool, called ``Half-Life Your Message,'' which is adapted from a commonly used improvisational theater game and can be applied in three minutes to distill a central thesis for any communication effort. Users can increase the value provided by Half-Life Your Message by scaffolding its application with an introduction and opportunity to self-reflect and debrief. We emphasize the tool's utility based on our experiences in using it ourselves and in teaching it to undergraduates, graduate students, and faculty.},
  keywords = {idea prioritization,messaging,public engagement,science communication}
}

