@article{Hippert2006,
  title = {Autophagy in Cancer: Good, Bad, or Both?},
  author = {Hippert, Melanie M and O'Toole, Patrick S and Thorburn, Andrew},
  year = {2006},
  month = oct,
  journal = {Cancer research},
  volume = {66},
  number = {19},
  eprint = {17018585},
  eprinttype = {pubmed},
  pages = {9349--51},
  issn = {1538-7445},
  doi = {10.1158/0008-5472.CAN-06-1597},
  abstract = {Autophagy has been recognized as an important cellular process for at least 50 years; however, it is only with the recent identification of key regulators of autophagy (Atg genes) that we have begun a mechanistic exploration of its importance in cancer. Recent studies suggest that autophagy may be important in the regulation of cancer development and progression and in determining the response of tumor cells to anticancer therapy. However, the role of autophagy in these processes is complicated and may, depending on the circumstances, have diametrically opposite consequences for the tumor. In this article, we discuss recent discoveries regarding autophagy in cancer.},
  pmid = {17018585},
  keywords = {Animals,Antineoplastic Agents,Antineoplastic Agents: pharmacology,Antineoplastic Agents: therapeutic use,Autophagy,Autophagy: drug effects,Autophagy: genetics,Autophagy: physiology,Energy Metabolism,Humans,Lysosomes,Lysosomes: physiology,Mice,Neoplasm Proteins,Neoplasm Proteins: genetics,Neoplasm Proteins: physiology,Neoplasms,Neoplasms: drug therapy,Neoplasms: genetics,Neoplasms: pathology,Neoplasms: prevention & control,Sirolimus,Sirolimus: pharmacology,Tumor Suppressor Proteins,Tumor Suppressor Proteins: genetics,Tumor Suppressor Proteins: physiology}
}

