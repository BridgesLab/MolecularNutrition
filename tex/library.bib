@article{Yan2017a,
  title = {An Inflammatory Bowel Disease--Risk Variant in {{INAVA}} Decreases Pattern Recognition Receptor--Induced Outcomes},
  author = {Yan, Jie and Hedl, Matija and Abraham, Clara and Huang, S and Hermeking, H and N{\'u}{\~n}ez, G},
  year = {2017},
