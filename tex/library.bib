@article{Jacob2010,
  title = {Gene Targeting in the Rat: Advances and Opportunities.},
  author = {Jacob, Howard J and Lazar, Jozef and Dwinell, Melinda R and Moreno, Carol and Geurts, Aron M},
  year = {2010},
