@article{Peterson2016,
  title = {The Thermogenic Responses to Overfeeding and Cold Are Differentially Regulated},
  author = {Peterson, Courtney M. and Lecoultre, Virgile and Frost, Elizabeth A. and Simmons, Jonathan and Redman, Leanne M. and Ravussin, Eric},
  year = {2016},
  journal = {Obesity},
  volume = {24},
  number = {1},
  pages = {96--101},
  issn = {1930739X},
  doi = {10.1002/oby.21233},
  abstract = {OBJECTIVE: Brown adipose tissue (BAT) is a highly metabolic tissue that generates heat and is negatively associated with obesity. BAT has been proposed to mediate both cold-induced thermogenesis (CIT) and diet-induced thermogenesis (DIT). Therefore, it was investigated whether there is a relationship between CIT and DIT in humans.{\textbackslash}n{\textbackslash}nMETHODS: Nine healthy men (23\,{\textpm}\,3 years old, 23.0\,{\textpm}\,1.8 kg~m(-2) ) completed 20 min of cold exposure (4{$^\circ$}C) 5 days per week for 4 weeks. Before and after the intervention, CIT (the increase in resting metabolic rate at 16{$^\circ$}C relative to 22{$^\circ$}C) was measured by a ventilated hood indirect calorimeter, whereas DIT was measured as the 24-h thermic response to 1 day of 50\% overfeeding (TEF150\% ) in a respiratory chamber.{\textbackslash}n{\textbackslash}nRESULTS: After the cold intervention, CIT more than doubled from 5.2\%\,{\textpm}\,14.2\% at baseline to 12.0\%\,{\textpm}\,11.1\% (P\,=\,0.05), in parallel with increased sympathetic nervous system activity. However, 24-h energy expenditure (2,166\,{\textpm}\,206 vs. 2,118\,{\textpm}\,188 kcal~day(-1) ; P\,=\,0.15) and TEF150\% (7.4\%\,{\textpm}\,2.7\% vs. 7.7\%\,{\textpm}\,1.6\%; P\,=\,0.78) were unchanged. Moreover, there was no association between CIT and TEF150\% at baseline or post-intervention, nor in their changes (P\,{$\geq$}\,0.47).{\textbackslash}n{\textbackslash}nCONCLUSIONS: Cold acclimation resulted in increased CIT but not TEF150\% . Therefore, it is likely that CIT and DIT are mediated by distinct regulatory mechanisms.},
  pmid = {26592725}
}

