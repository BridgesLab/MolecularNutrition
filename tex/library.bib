  author = {Estruch, Ram{\'o}n and Ros, Emilio and {Salas-Salvad{\'o}}, Jordi and Covas, Maria-Isabel and Corella, Dolores and Ar{\'o}s, Fernando and {G{\'o}mez-Gracia}, Enrique and {Ruiz-Guti{\'e}rrez}, Valentina and Fiol, Miquel and Lapetra, Jos{\'e} and {Lamuela-Raventos}, Rosa Maria and {Serra-Majem}, Llu{\'i}s and Pint{\'o}, Xavier and Basora, Josep and Mu{\~n}oz, Miguel Angel and Sorl{\'i}, Jos{\'e} V. and Mart{\'i}nez, Jos{\'e} Alfredo and {Mart{\'i}nez-Gonz{\'a}lez}, Miguel Angel},
