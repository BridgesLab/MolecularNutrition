@article{Bluher2002,
  title = {Adipose Tissue Selective Insulin Receptor Knockout Protects against Obesity and Obesity-Related Glucose Intolerance},
  author = {Bl??her, Matthias and Michael, M. Dodson and Peroni, Odile D. and Ueki, Kohjiro and Carter, Nathan and Kahn, Barbara B. and Kahn, C. Ronald and Bl{\"u}her, Matthias and Michael, M. Dodson and Peroni, Odile D. and Ueki, Kohjiro and Carter, Nathan and Kahn, Barbara B. and Kahn, C. Ronald and Bl??her, Matthias and Michael, M. Dodson and Peroni, Odile D. and Ueki, Kohjiro and Carter, Nathan and Kahn, Barbara B. and Kahn, C. Ronald},
  year = {2002},
