@article{DeFalco2001,
  title = {Virus-Assisted Mapping of Neural Inputs to a Feeding Center in the Hypothalamus.},
  author = {DeFalco, J and Tomishima, M and Liu, H and Zhao, C and Cai, X and Marth, J D and Enquist, L and Friedman, J M},
  year = {2001},
  month = mar,
  journal = {Science},
  volume = {291},
  number = {5513},
  eprint = {11283374},
  eprinttype = {pubmed},
  pages = {2608--13},
  issn = {0036-8075},
  doi = {10.1126/science.1056602},
  urldate = {2014-10-14},
  abstract = {We report the development of a pseudorabies virus that can be used for retrograde tracing from selected neurons. This virus encodes a green fluorescent protein marker and replicates only in neurons that express the Cre recombinase and in neurons in synaptic contact with the originally infected cells. The virus was injected into the arcuate nucleus of mice that express Cre only in those neurons that express neuropeptide Y or the leptin receptor. Sectioning of the brains revealed that these neurons receive inputs from neurons in other regions of the hypothalamus, as well as the amygdala, cortex, and other brain regions. These data suggest that higher cortical centers modulate leptin signaling in the hypothalamus. This method of neural tracing may prove useful in studies of other complex neural circuits.},
  pmid = {11283374},
  keywords = {Afferent Pathways,Animals,Arcuate Nucleus,Arcuate Nucleus: cytology,Arcuate Nucleus: physiology,Arcuate Nucleus: virology,Artificial,Bacterial,Brain,Brain Mapping,Brain: cytology,Brain: physiology,Brain: virology,Carrier Proteins,Carrier Proteins: genetics,Carrier Proteins: metabolism,Cell Surface,Chromosomes,conditional knockout,Eating,Gene Expression,Genetic,Green Fluorescent Proteins,Herpesvirus 1,hypothalamus,Hypothalamus,Hypothalamus: cytology,Hypothalamus: physiology,Hypothalamus: virology,Inbred C57BL,Integrases,Integrases: genetics,Integrases: metabolism,LepR-Cre,Leptin,Luminescent Proteins,Luminescent Proteins: genetics,Luminescent Proteins: metabolism,Mice,Neurons,Neurons: metabolism,Neurons: virology,Neuropeptide Y,Neuropeptide Y: genetics,Neuropeptide Y: metabolism,Receptors,Recombinant Fusion Proteins,Recombinant Fusion Proteins: metabolism,Recombination,Suid,Suid: genetics,Suid: physiology,tau Proteins,tau Proteins: genetics,tau Proteins: metabolism,Transgenic,Viral Proteins,Virus Replication}
}

@article{DeFronzo1981,
  title = {Synergistic Interaction between Exercise and Insulin on Peripheral Glucose Uptake.},
  author = {DeFronzo, Ralph A. and Ferrannini, Ele and Sato, Y and Felig, P and Wahren, J.},
  year = {1981},
  month = dec,
  journal = {The Journal of clinical investigation},
  volume = {68},
  number = {6},
  pages = {1468--74},
  issn = {0021-9738},
  abstract = {The interaction of exercise and insulin on glucose metabolism was examined in 10 healthy volunteers. Four study protocols were used: study 1: plasma insulin was raised by approximately 100 microunits/ml while plasma glucose was maintained at basal levels for 2 h (insulin clamp). Study 2: subjects performed 30 min of bicycle exercise at 40\% of VO2 max. Study 3: an insulin clamp was performed as per study 1. Following 60 min of sustained hyperinsulinemia, however, subjects exercised for 30 min as per study 2. Study 4: subjects were studied as per study 3 except that catheters were inserted into the femoral artery and vein to quantitate leg glucose uptake. During the 60-90 min period of hyperinsulinemia (study 1), glucose uptake averaged 8.73 +/- 0.10 mg/kg per min. With exercise alone (study 2), the increment in peripheral glucose uptake was 1.43 +/- 0.30 mg/kg per min. When hyperinsulinemia and exercise were combined (study 3), glucose uptake averaged 15.06 +/- 0.98 mg/kg per min (P less than 0.01) and this was significantly (P less than 0.001) greater than the sum of glucose uptake when exercise and the insulin clamp were performed separately. The magnitude of rise in glucose uptake correlated closely with the increase in leg blood flow (r = 0.935, P less than 0.001), suggesting that the synergism is the result of increased blood flow and increased capillary surface area to exercising muscle. More than 85\% of total body glucose metabolism during studies 1 and 3 was accounted for by skeletal muscle uptake. These results demonstrate that (a) insulin and exercise act synergistically to enhance glucose disposal in man, and (b) muscle is the primary tissue responsible for the increase in glucose metabolism following hyperinsulinemia and exercise.},
  pmid = {7033285},
  keywords = {Adult,exercise,Glucose,glucose disposal,Glucose: metabolism,human studies,Humans,Hyperinsulinism,Hyperinsulinism: metabolism,Infusions,Insulin,insulin clamp,insulin sensitivity,Insulin: administration & dosage,Insulin: metabolism,Leg,Male,Muscles,Muscles: metabolism,Parenteral,Physical Exertion,Regional Blood Flow,Time Factors}
}

