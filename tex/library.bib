@article{Perez-Castrillon2019,
  title = {Nutrigenetics of {{Bone Health}}},
  author = {{P{\'e}rez-Castrillon}, Jos{\'e} Luis and {Ruiz-Mambrilla}, Marta and Riancho, Jos{\'e} A.},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {377--382},
  doi = {10.1016/B978-0-12-804572-5.00051-3},
  abstract = {Bone health is genetically determined in 75\%-80\% of cases. However, studies of the associations with polymorphisms show different results depending on the populations analyzed, probably due to interactions with external factors, including nutritional factors, of which the most important are calcium and vitamin D. Vitamin D receptor polymorphisms have been associated with changes in bone mineral density, showing different responses according to the intake of calcium and vitamin D supplements. Other polymorphisms, related to vitamin B and vitamin K, play a lesser role.},
  isbn = {9780128045725},
  keywords = {Apai,Bone mineral density,Bsml,Fokl,Taqi,Vitamin d receptor}
}

@article{Perez-Castrillon2019a,
  title = {Nutrients and {{Gene Expression Affecting Bone Metabolism}}},
  author = {{P{\'e}rez-Castrill{\'o}n}, Jos{\'e} Luis and Del Moral, Jos{\'e} Antonio Riancho},
  year = {2019},
  journal = {Principles of Nutrigenetics and Nutrigenomics: Fundamentals of Individualized Nutrition},
  pages = {489--495},
  doi = {10.1016/B978-0-12-804572-5.00064-1},
  abstract = {Bone mass, the principal determinant of bone health, is controlled mainly by genetic factors. Other genetically regulated elements, such as bone geometry and microarchitecture as well as remodeling, also contribute to the risk for fracture. Some modifiable factors, such as nutrition, may influence these elements by modifying the expression of genes that regulate transcription factors and proteins that intervene in the metabolic pathways of osteoclasts, osteoblasts, and osteocytes, the cells responsible for bone remodeling. The most-studied nutrients are calcium, vitamins A, B, C, and especially D, phytoestrogens, and polyunsaturated fatty acids. In in vitro studies, most of these nutrients have a beneficial effect, although there is no clear correlation with clinical studies.},
  isbn = {9780128045725},
  keywords = {Bone,Bone mineral density,Nutrigenomics,Single nucleotide polymorphism}
}

