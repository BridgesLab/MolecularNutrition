@article{smithChangesIntakeProtein2015,
  title = {Changes in Intake of Protein Foods, Carbohydrate Amount and Quality, and Long-Term Weight Change: {{Results}} from 3 Prospective Cohorts},
  author = {Smith, Jessica D. and Hou, Tao and Ludwig, David S. and Rimm, Eric B. and Willett, Walter C. and Hu, Frank B. and Mozaffarian, Dariush},
