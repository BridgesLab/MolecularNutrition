@article{gauthierLiverSpecificDefectAcylCoA2013,
  title = {A {{Liver-Specific Defect}} of {{Acyl-CoA Degradation Produces Hyperammonemia}}, {{Hypoglycemia}} and a {{Distinct Hepatic Acyl-CoA Pattern}}},
  author = {Gauthier, Nicolas and Wu, Jiang Wei and Wang, Shu Pei and Allard, Pierre and Mamer, Orval A. and Sweetman, Lawrence and Moser, Ann B. and Kratz, Lisa and Alvarez, Fernando and Robitaille, Yves and L{\'e}pine, Fran{\c c}ois and Mitchell, Grant A.},
  year = {2013},
  month = jul,
  journal = {PLOS ONE},
  volume = {8},
  number = {7},
  pages = {e60581},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0060581},
  urldate = {2024-03-07},
  abstract = {Most conditions detected by expanded newborn screening result from deficiency of one of the enzymes that degrade acyl-coenzyme A (CoA) esters in mitochondria. The role of acyl-CoAs in the pathophysiology of these disorders is poorly understood, in part because CoA esters are intracellular and samples are not generally available from human patients. We created a mouse model of one such condition, deficiency of 3-hydroxy-3-methylglutaryl-CoA lyase (HL), in liver (HLLKO mice). HL catalyses a reaction of ketone body synthesis and of leucine degradation. Chronic HL deficiency and acute crises each produced distinct abnormal liver acyl-CoA patterns, which would not be predictable from levels of urine organic acids and plasma acylcarnitines. In HLLKO hepatocytes, ketogenesis was undetectable. Carboxylation of [2-14C] pyruvate diminished following incubation of HLLKO hepatocytes with the leucine metabolite 2-ketoisocaproate (KIC). HLLKO mice also had suppression of the normal hyperglycemic response to a systemic pyruvate load, a measure of gluconeogenesis. Hyperammonemia and hypoglycemia, cardinal features of many inborn errors of acyl-CoA metabolism, occurred spontaneously in some HLLKO mice and were inducible by administering KIC. KIC loading also increased levels of several leucine-related acyl-CoAs and reduced acetyl-CoA levels. Ultrastructurally, hepatocyte mitochondria of KIC-treated HLLKO mice show marked swelling. KIC-induced hyperammonemia improved following administration of carglumate (N-carbamyl-L-glutamic acid), which substitutes for the product of an acetyl-CoA-dependent reaction essential for urea cycle function, demonstrating an acyl-CoA-related mechanism for this complication.},
  langid = {english},
  keywords = {Blood plasma,Citric acid cycle,Hepatocytes,Hypoglycemia,Inborn errors of metabolism,Leucine,Mitochondria,Pyruvate},
  file = {/Users/davebrid/Zotero/storage/RDQRP79T/Gauthier et al. - 2013 - A Liver-Specific Defect of Acyl-CoA Degradation Pr.pdf}
}

