  keywords = {Animals,antifungal,Antifungal Agents,Antifungal Agents: isolation & purification,Antifungal Agents: pharmacology,Antifungal Agents: toxicity,Candida albicans,Candida albicans: drug effects,historical,Mice,Microsporum,Microsporum: drug effects,Polyenes,Polyenes: isolation & purification,Polyenes: pharmacology,rapamycin,Streptomyces,Streptomyces: analysis,Streptomyces: classification,Trichophyton,Trichophyton: drug effects}
}

