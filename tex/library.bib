@article{Han2016,
  title = {Striatal {{Dopamine Links Gastrointestinal Rerouting}} to {{Altered Sweet Appetite}}},
  author = {Han, Wenfei and Tellez, Luis A. and Niu, Jingjing and Medina, Sara and Ferreira, Tatiana L. and Zhang, Xiaobing and Su, Jiansheng and Tong, Jenny and Schwartz, Gary J. and Van Den Pol, Anthony and De Araujo, Ivan E.},
  year = {2016},
  journal = {Cell Metabolism},
  volume = {23},
  number = {1},
  pages = {103--112},
  publisher = {Elsevier Inc.},
  issn = {19327420},
  doi = {10.1016/j.cmet.2015.10.009},
  abstract = {Reductions in calorie intake contribute significantly to the positive outcome of bariatric surgeries. However, the physiological mechanisms linking the rerouting of the gastrointestinal tract to reductions in sugar cravings remain uncertain. We show that a duodenal-jejunal bypass (DJB) intervention inhibits maladaptive sweet appetite by acting on dopamine-responsive striatal circuitries. DJB disrupted the ability of recurrent sugar exposure to promote sweet appetite in sated animals, thereby revealing a link between recurrent duodenal sugar influx and maladaptive sweet intake. Unlike ingestion of a low-calorie sweetener, ingestion of sugar was associated with significant dopamine effluxes in the dorsal striatum, with glucose infusions into the duodenum inducing greater striatal dopamine release than equivalent jejunal infusions. Consistently, optogenetic activation of dopamine-excitable cells of the dorsal striatum was sufficient to restore maladaptive sweet appetite in sated DJB mice. Our findings point to a causal link between striatal dopamine signaling and the outcomes of bariatric interventions.},
  arxiv = {15334406},
  isbn = {1932-7420{\textbackslash}r1550-4131},
  pmid = {26698915}
}

