  keywords = {Animals,Cell Hypoxia,Cell Hypoxia: physiology,Humans,Hypoxia-Inducible Factor 1,Hypoxia-Inducible Factor 1: metabolism,Male,Neovascularization Pathologic,Neovascularization Pathologic: metabolism,Neovascularization Pathologic: pathology,Neovascularization Pathologic: therapy,Prostatic Neoplasms,Prostatic Neoplasms: metabolism,Prostatic Neoplasms: pathology,Prostatic Neoplasms: therapy,Receptors Notch,Receptors Notch: physiology,Signal Transduction,Signal Transduction: physiology}
