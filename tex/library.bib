  doi = {10.1016/j.bmcl.2013.05.102},
  abstract = {Racemic cis-1,1-dioxo-5,6-dihydro-[4,1,2]oxathiazine derivative 4a was isolated as an impurity in a sample of a hit from a HTS campaign on 11??-hydroxysteroid dehydrogenase type 1 (11??-HSD1). After separation by chiral chromatography the 4a-S, 8a-R enantiomer of compound 4a was identified as the true, potent enzyme inhibitor. The cocrystal structure of 4a with human and murine 11??-HSD1 revealed the unique binding mode of the oxathiazine series. SAR elucidation and optimization in regard to metabolic stability led to monocyclic tetramethyloxathiazines as exemplified by compound 21g. ?? 2013 Elsevier Ltd. All rights reserved.},
