  author = {Robinson, Matthew M and Hamilton, Karyn L and Miller, Benjamin F.},
  year = {2009},
  month = jul,
  journal = {Journal of applied physiology (Bethesda, Md. : 1985)},
  volume = {107},
  number = {1},
  eprint = {19423832},
  eprinttype = {pubmed},
  pages = {8--16},
  issn = {8750-7587},
  doi = {10.1152/japplphysiol.00343.2009},
  urldate = {2011-02-26},
  abstract = {The importance of mitochondrial dysfunctions in the progression of chronic disease has been well established. Patients with chronic diseases are often prescribed a variety of medications, many of which have been shown to induce mitochondrial dysfunction. Exercise is a known stimulus for mitochondrial biogenesis and also recommended to patients as a lifestyle modification to supplement drug therapy. However, the potential interference of those drugs with mitochondrial adaptations to exercise has not been thoroughly investigated. This review provides a summary and discussion of known and potential interactions of commonly consumed drugs with exercise-induced mitochondrial adaptations.},
  pmid = {19423832},
  keywords = {Adaptation Physiological,Adaptation Physiological: physiology,Adrenergic beta-Antagonists,Adrenergic beta-Antagonists: toxicity,Anti-Inflammatory Agents Non-Steroidal,Anti-Inflammatory Agents Non-Steroidal: toxicity,colorado state,Drug Interactions,Drug Interactions: physiology,Drug Toxicity,Drug Toxicity: metabolism,Exercise,Exercise: physiology,Humans,Hydroxymethylglutaryl-CoA Reductase Inhibitors,Hydroxymethylglutaryl-CoA Reductase Inhibitors: to,Mitochondria Muscle,Mitochondria Muscle: drug effects,Mitochondria Muscle: metabolism,Mitochondrial Diseases,Mitochondrial Diseases: chemically induced,Mitochondrial Diseases: metabolism}
}

