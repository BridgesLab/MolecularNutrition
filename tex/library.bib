  doi = {10.1126/science.1066015},
  urldate = {2011-12-28},
  abstract = {The mammalian target of rapamycin (mTOR) governs cell growth and proliferation by mediating the mitogen- and nutrient-dependent signal transduction that regulates messenger RNA translation. We identified phosphatidic acid (PA) as a critical component of mTOR signaling. In our study, mitogenic stimulation of mammalian cells led to a phospholipase D-dependent accumulation of cellular PA, which was required for activation of mTOR downstream effectors. PA directly interacted with the domain in mTOR that is targeted by rapamycin, and this interaction was positively correlated with mTOR's ability to activate downstream effectors. The involvement of PA in mTOR signaling reveals an important function of this lipid in signal transduction and protein synthesis, as well as a direct link between mTOR and mitogens. Furthermore, these studies suggest a potential mechanism for the in vivo actions of the immunosuppressant rapamycin.},
  isbn = {0036-8075 (Print)},
  pmid = {11729323},
  keywords = {1-Phosphatidylinositol 3-Kinase/metabolism,Adaptor Proteins,Butanols,Butanols: pharmacology,Butanols/pharmacology,Carrier Proteins,Carrier Proteins: metabolism,Carrier Proteins/metabolism,Cell Line,Culture Media,Enzyme Activation,Enzyme Activation: drug effects,Enzyme Activation/drug effects,Humans,Immunosuppressive Agents,Immunosuppressive Agents: pharmacology,Immunosuppressive Agents/pharmacology,Mitogens,Mitogens: pharmacology,Mitogens/*pharmacology,mtorc1,Phosphatidic Acids,Phosphatidic Acids: metabolism,Phosphatidic Acids/*metabolism,Phosphatidylinositol 3-Kinases,Phosphatidylinositol 3-Kinases: metabolism,Phospholipase D,Phospholipase D: metabolism,Phospholipase D/metabolism,Phosphoproteins,Phosphoproteins: metabolism,Phosphoproteins/metabolism,Phosphorylation,Phosphorylation: drug effects,Phosphorylation/drug effects,pld1,Protein Binding,Protein Kinases,Protein Kinases: chemistry,Protein Kinases: metabolism,Protein Kinases/chemistry/*metabolism,Protein Structure,Ribosomal Protein S6 Kinases,Ribosomal Protein S6 Kinases: metabolism,Ribosomal Protein S6 Kinases/metabolism,Serum-Free,Signal Transducing,Signal Transduction,Signal Transduction: drug effects,Signal Transduction/*drug effects,Sirolimus,Sirolimus: pharmacology,Sirolimus/pharmacology,Tertiary,Time Factors,TOR Serine-Threonine Kinases}
